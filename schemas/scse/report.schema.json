{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/scse/schemas/report.schema.json",
  "title": "SCSE Report v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "scenarioId",
    "mode",
    "asOfDate",
    "manifest",
    "findings",
    "claims",
    "minorityOpinions",
    "limitations",
    "sourceInventory"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "regulatoryPolicy",
        "solutionCompliance",
        "governanceReview"
      ]
    },
    "asOfDate": {
      "type": "string",
      "format": "date"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotHash",
        "models",
        "syntheticCouncil"
      ],
      "properties": {
        "snapshotHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "syntheticCouncil": {
          "const": true
        },
        "runSeed": {
          "type": "integer"
        }
      }
    },
    "sourceInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "uri",
          "verificationStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "verificationStatus": {
            "enum": [
              "verified",
              "pending",
              "failed"
            ]
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "minorityOpinions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/minority"
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tension"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governanceReview": {
      "$ref": "#/$defs/governanceReview"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirementId",
        "status",
        "legalSourceIds",
        "evidenceIds",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "requirementId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "compliantEvidenced",
            "noncompliantEvidenced",
            "insufficientEvidence",
            "notApplicable",
            "requiresLegalReview",
            "futureObligation",
            "proposalOnly"
          ]
        },
        "legalSourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "reviewedByHuman": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "classification",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 5
        },
        "classification": {
          "enum": [
            "verifiedLegalFact",
            "evidenceBasedFinding",
            "syntheticPerspective",
            "hypothesis",
            "unknown"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agentId": {
          "type": "string"
        },
        "challengedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "minority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "rationale",
        "sourceIds"
      ],
      "properties": {
        "claimId": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "minLength": 5
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "perspectiveAgentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "supportingClaimIds",
        "counterClaimIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "supportingClaimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counterClaimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "governanceReview": {
      "type": "object",
      "required": [
        "modelId",
        "modelVersion",
        "contextId",
        "asOfDate",
        "lenses",
        "coverage",
        "seedTensions",
        "proposalCount",
        "packetFile",
        "status"
      ],
      "properties": {
        "modelId": {
          "type": "string"
        },
        "modelVersion": {
          "type": "string"
        },
        "contextId": {
          "type": "string"
        },
        "asOfDate": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "const": "pendingHumanReview"
        },
        "lenses": {
          "type": "object",
          "properties": {
            "omission": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excess": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "advantage": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "required": [
            "topicsExpected",
            "gaps",
            "fragile"
          ],
          "properties": {
            "topicsExpected": {
              "type": "integer"
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fragile": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "seedTensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "findings"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "findings": {
                "type": "integer"
              }
            }
          }
        },
        "proposalCount": {
          "type": "integer"
        },
        "packetFile": {
          "type": "string"
        }
      }
    }
  }
}
