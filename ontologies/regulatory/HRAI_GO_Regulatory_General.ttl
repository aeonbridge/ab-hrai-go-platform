# ---------------------------------------------------------------------------
# v1.2.0 (ESP-ONT-02, RF-03): comparison, coverage, capacity, correspondence and specificity terms; rules R24-R26.
# R27 does not exist (SWRL has no negation: uncovered exposure is a SPARQL query under a CoverageAssessment).
# R28 (design profile) lives in the comparative module with the criteria it combines; R29-R30 live in SCSE.
# ---------------------------------------------------------------------------
hrai:RegulatoryDesignCriterion rdf:type owl:Class .
hrai:RegulatoryDesignCriterion rdfs:label "RegulatoryDesignCriterion"@en .
hrai:RegulatoryDesignCriterion rdfs:comment "Criterion of the comparative taxonomy of Alanoca et al. (FAccT 2025, doi:10.1145/3715275.3732059), with its original definition, or one of the declared extensions E1-E7. The concepts themselves live in the comparative module."@en .
hrai:CriterionCoding rdf:type owl:Class .
hrai:CriterionCoding rdfs:label "CriterionCoding"@en .
hrai:CriterionCoding rdfs:comment "N-ary coding of one instrument version (or plan) on one criterion: value on an approved scale, justifying provision, coder and review decision (extensions E4, E5)."@en .
hrai:SubstantiveArea rdf:type owl:Class .
hrai:SubstantiveArea rdfs:label "SubstantiveArea"@en .
hrai:SubstantiveArea rdfs:comment "Substantive area of governance (extension E3): the 28 areas of the chamber plus generative AI and general-purpose models, mapped to NIST functions and AI Act chapters where a relation exists."@en .
hrai:ProvisionCorrespondence rdf:type owl:Class .
hrai:ProvisionCorrespondence rdfs:label "ProvisionCorrespondence"@en .
hrai:ProvisionCorrespondence rdfs:comment "N-ary correspondence between a provision of one jurisdiction and a provision of another: type, evidence, analyst and review decision."@en .
hrai:CorrespondenceType rdf:type owl:Class .
hrai:CorrespondenceType rdfs:label "CorrespondenceType"@en .
hrai:CorrespondenceType rdfs:comment "Controlled value for the type of a provision correspondence: equivalent, adapted, partial or divergent."@en .
hrai:TransposingCorrespondenceType rdf:type owl:Class .
hrai:TransposingCorrespondenceType rdfs:label "TransposingCorrespondenceType"@en .
hrai:TransposingCorrespondenceType rdfs:comment "Correspondence types that indicate transposition (equivalent or adapted)."@en .
hrai:TransposingCorrespondenceType rdfs:subClassOf hrai:CorrespondenceType .
hrai:CapacityRequirement rdf:type owl:Class .
hrai:CapacityRequirement rdfs:label "CapacityRequirement"@en .
hrai:CapacityRequirement rdfs:comment "Capacity of the State or of the ecosystem that a normative requirement presupposes (budget, staff, infrastructure)."@en .
hrai:CapacityShortfallIndicator rdf:type owl:Class .
hrai:CapacityShortfallIndicator rdfs:label "CapacityShortfallIndicator"@en .
hrai:CapacityShortfallIndicator rdfs:comment "Indicator whose value is below its explicit lower alert threshold. A signal to investigate, not a finding of infeasibility."@en .
hrai:CapacityShortfallIndicator rdfs:subClassOf hrai:ContextIndicator .
hrai:RiskExposureIndicator rdf:type owl:Class .
hrai:RiskExposureIndicator rdfs:label "RiskExposureIndicator"@en .
hrai:RiskExposureIndicator rdfs:comment "Indicator of how much the national context is exposed to a risk (for example, volume of sensitive data in state use)."@en .
hrai:RiskExposureIndicator rdfs:subClassOf hrai:ContextIndicator .
hrai:CoverageAssessment rdf:type owl:Class .
hrai:CoverageAssessment rdfs:label "CoverageAssessment"@en .
hrai:CoverageAssessment rdfs:comment "Explicit closed-world statement: for jurisdiction J, in snapshot S, the corpus was searched for area F. Only under it does an absence become a gap."@en .
hrai:NationalSpecificity rdf:type owl:Class .
hrai:NationalSpecificity rdfs:label "NationalSpecificity"@en .
hrai:NationalSpecificity rdfs:comment "Specificity of Brazil relative to the other jurisdictions of the corpus (QN1): a difference explained by a national dimension, with mandatory evidence. Proposed; produced as a candidate and accepted only by human review (RF-18; RT-VIS-03 step M5)."@en .
hrai:SpecificityDimension rdf:type owl:Class .
hrai:SpecificityDimension rdfs:label "SpecificityDimension"@en .
hrai:SpecificityDimension rdfs:comment "Dimension of QN1 that explains a specificity: national context, installed capacity, risk exposure or strategic objective."@en .
hrai:DifferenceType rdf:type owl:Class .
hrai:DifferenceType rdfs:label "DifferenceType"@en .
hrai:DifferenceType rdfs:comment "Type of difference behind a specificity: Brazil only, absent in Brazil, intensity or context."@en .
hrai:JurisdictionComparison rdf:type owl:Class .
hrai:JurisdictionComparison rdfs:label "JurisdictionComparison"@en .
hrai:JurisdictionComparison rdfs:comment "Value of one other jurisdiction for the point compared by a specificity, with its source, or the explicit statement that it is not coded."@en .
hrai:EquivalentCorrespondence rdf:type owl:NamedIndividual .
hrai:EquivalentCorrespondence rdf:type hrai:TransposingCorrespondenceType .
hrai:EquivalentCorrespondence rdfs:label "EquivalentCorrespondence"@en .
hrai:EquivalentCorrespondence rdfs:comment "Same obligation with the same scope."@en .
hrai:AdaptedCorrespondence rdf:type owl:NamedIndividual .
hrai:AdaptedCorrespondence rdf:type hrai:TransposingCorrespondenceType .
hrai:AdaptedCorrespondence rdfs:label "AdaptedCorrespondence"@en .
hrai:AdaptedCorrespondence rdfs:comment "Same obligation, adapted in scope, actor or procedure."@en .
hrai:PartialCorrespondence rdf:type owl:NamedIndividual .
hrai:PartialCorrespondence rdf:type hrai:CorrespondenceType .
hrai:PartialCorrespondence rdfs:label "PartialCorrespondence"@en .
hrai:PartialCorrespondence rdfs:comment "Only part of the obligation corresponds."@en .
hrai:DivergentCorrespondence rdf:type owl:NamedIndividual .
hrai:DivergentCorrespondence rdf:type hrai:CorrespondenceType .
hrai:DivergentCorrespondence rdfs:label "DivergentCorrespondence"@en .
hrai:DivergentCorrespondence rdfs:comment "Both address the area with different obligations."@en .
hrai:NationalContextDimension rdf:type owl:NamedIndividual .
hrai:NationalContextDimension rdf:type hrai:SpecificityDimension .
hrai:NationalContextDimension rdfs:label "NationalContextDimension"@en .
hrai:NationalContextDimension rdfs:comment "Explained by the national context (territory, population, legal system, economy)."@en .
hrai:InstalledCapacityDimension rdf:type owl:NamedIndividual .
hrai:InstalledCapacityDimension rdf:type hrai:SpecificityDimension .
hrai:InstalledCapacityDimension rdfs:label "InstalledCapacityDimension"@en .
hrai:InstalledCapacityDimension rdfs:comment "Explained by installed capacity (budget, staff, infrastructure, supervision)."@en .
hrai:RiskExposureDimension rdf:type owl:NamedIndividual .
hrai:RiskExposureDimension rdf:type hrai:SpecificityDimension .
hrai:RiskExposureDimension rdfs:label "RiskExposureDimension"@en .
hrai:RiskExposureDimension rdfs:comment "Explained by exposure to a risk specific to the country."@en .
hrai:StrategicObjectiveDimension rdf:type owl:NamedIndividual .
hrai:StrategicObjectiveDimension rdf:type hrai:SpecificityDimension .
hrai:StrategicObjectiveDimension rdfs:label "StrategicObjectiveDimension"@en .
hrai:StrategicObjectiveDimension rdfs:comment "Explained by a strategic objective of the country (sovereignty, development)."@en .
hrai:BrazilOnlyDifference rdf:type owl:NamedIndividual .
hrai:BrazilOnlyDifference rdf:type hrai:DifferenceType .
hrai:BrazilOnlyDifference rdfs:label "BrazilOnlyDifference"@en .
hrai:BrazilOnlyDifference rdfs:comment "Brazil covers the area or objective and no other jurisdiction of the corpus does."@en .
hrai:AbsentInBrazilDifference rdf:type owl:NamedIndividual .
hrai:AbsentInBrazilDifference rdf:type hrai:DifferenceType .
hrai:AbsentInBrazilDifference rdfs:label "AbsentInBrazilDifference"@en .
hrai:AbsentInBrazilDifference rdfs:comment "Other jurisdictions cover the area and Brazil does not, within a coverage assessment."@en .
hrai:IntensityDifference rdf:type owl:NamedIndividual .
hrai:IntensityDifference rdf:type hrai:DifferenceType .
hrai:IntensityDifference rdfs:label "IntensityDifference"@en .
hrai:IntensityDifference rdfs:comment "All cover it, with different values on the approved scale (E4) or different legal force (E1)."@en .
hrai:ContextDifference rdf:type owl:NamedIndividual .
hrai:ContextDifference rdf:type hrai:DifferenceType .
hrai:ContextDifference rdfs:label "ContextDifference"@en .
hrai:ContextDifference rdfs:comment "A capacity or exposure indicator in which Brazil differs from the others."@en .
hrai:codingCriterion rdf:type owl:ObjectProperty .
hrai:codingCriterion rdfs:label "codingCriterion"@en .
hrai:codingCriterion rdfs:comment "Criterion coded."@en .
hrai:codingCriterion rdfs:domain hrai:CriterionCoding .
hrai:codingCriterion rdfs:range hrai:RegulatoryDesignCriterion .
hrai:codingSubject rdf:type owl:ObjectProperty .
hrai:codingSubject rdfs:label "codingSubject"@en .
hrai:codingSubject rdfs:comment "Instrument version or policy instrument that was coded (E5: coding is per version)."@en .
hrai:codingSubject rdfs:domain hrai:CriterionCoding .
hrai:codingJustifiedBy rdf:type owl:ObjectProperty .
hrai:codingJustifiedBy rdfs:label "codingJustifiedBy"@en .
hrai:codingJustifiedBy rdfs:comment "Provision that justifies the coded value (evidence per value, E4)."@en .
hrai:codingJustifiedBy rdfs:domain hrai:CriterionCoding .
hrai:codingJustifiedBy rdfs:range hrai:LegalProvision .
hrai:codingCoder rdf:type owl:ObjectProperty .
hrai:codingCoder rdfs:label "codingCoder"@en .
hrai:codingCoder rdfs:comment "Person or agent that proposed the coding; agents only propose."@en .
hrai:codingCoder rdfs:domain hrai:CriterionCoding .
hrai:codingReview rdf:type owl:ObjectProperty .
hrai:codingReview rdfs:label "codingReview"@en .
hrai:codingReview rdfs:comment "Human review decision on the coding."@en .
hrai:codingReview rdfs:domain hrai:CriterionCoding .
hrai:codingReview rdfs:range hrai:ReviewDecision .
hrai:provisionAddressesFunction rdf:type owl:ObjectProperty .
hrai:provisionAddressesFunction rdfs:label "provisionAddressesFunction"@en .
hrai:provisionAddressesFunction rdfs:comment "A provision, principle or plan action addresses a substantive area."@en .
hrai:provisionAddressesFunction rdfs:range hrai:SubstantiveArea .
hrai:jurisdictionAddressesFunction rdf:type owl:ObjectProperty .
hrai:jurisdictionAddressesFunction rdfs:label "jurisdictionAddressesFunction"@en .
hrai:jurisdictionAddressesFunction rdfs:comment "Inferred (R24a): the jurisdiction covers the area through an instrument in force."@en .
hrai:jurisdictionAddressesFunction rdfs:domain hrai:Jurisdiction .
hrai:jurisdictionAddressesFunction rdfs:range hrai:SubstantiveArea .
hrai:jurisdictionProposesFunction rdf:type owl:ObjectProperty .
hrai:jurisdictionProposesFunction rdfs:label "jurisdictionProposesFunction"@en .
hrai:jurisdictionProposesFunction rdfs:comment "Inferred (R24b): the area is covered only by a legislative proposal; no binding force."@en .
hrai:jurisdictionProposesFunction rdfs:domain hrai:Jurisdiction .
hrai:jurisdictionProposesFunction rdfs:range hrai:SubstantiveArea .
hrai:jurisdictionPlansFunction rdf:type owl:ObjectProperty .
hrai:jurisdictionPlansFunction rdfs:label "jurisdictionPlansFunction"@en .
hrai:jurisdictionPlansFunction rdfs:comment "Inferred (R24c): the area is covered by a plan or policy action, not by law."@en .
hrai:jurisdictionPlansFunction rdfs:domain hrai:Jurisdiction .
hrai:jurisdictionPlansFunction rdfs:range hrai:SubstantiveArea .
hrai:correspondenceFrom rdf:type owl:ObjectProperty .
hrai:correspondenceFrom rdfs:label "correspondenceFrom"@en .
hrai:correspondenceFrom rdfs:comment "Provision of origin (for example, an AI Act article)."@en .
hrai:correspondenceFrom rdfs:domain hrai:ProvisionCorrespondence .
hrai:correspondenceFrom rdfs:range hrai:LegalProvision .
hrai:correspondenceTo rdf:type owl:ObjectProperty .
hrai:correspondenceTo rdfs:label "correspondenceTo"@en .
hrai:correspondenceTo rdfs:comment "Provision compared with the origin (for example, a PL 2338 article)."@en .
hrai:correspondenceTo rdfs:domain hrai:ProvisionCorrespondence .
hrai:correspondenceTo rdfs:range hrai:LegalProvision .
hrai:correspondenceHasType rdf:type owl:ObjectProperty .
hrai:correspondenceHasType rdfs:label "correspondenceHasType"@en .
hrai:correspondenceHasType rdfs:comment "Type of the correspondence."@en .
hrai:correspondenceHasType rdfs:domain hrai:ProvisionCorrespondence .
hrai:correspondenceHasType rdfs:range hrai:CorrespondenceType .
hrai:correspondenceEvidence rdf:type owl:ObjectProperty .
hrai:correspondenceEvidence rdfs:label "correspondenceEvidence"@en .
hrai:correspondenceEvidence rdfs:comment "Evidence for the correspondence."@en .
hrai:correspondenceEvidence rdfs:domain hrai:ProvisionCorrespondence .
hrai:correspondenceEvidence rdfs:range hrai:Evidence .
hrai:correspondenceAnalyst rdf:type owl:ObjectProperty .
hrai:correspondenceAnalyst rdfs:label "correspondenceAnalyst"@en .
hrai:correspondenceAnalyst rdfs:comment "Person or agent that proposed the correspondence."@en .
hrai:correspondenceAnalyst rdfs:domain hrai:ProvisionCorrespondence .
hrai:correspondenceReview rdf:type owl:ObjectProperty .
hrai:correspondenceReview rdfs:label "correspondenceReview"@en .
hrai:correspondenceReview rdfs:comment "Human review decision on the correspondence."@en .
hrai:correspondenceReview rdfs:domain hrai:ProvisionCorrespondence .
hrai:correspondenceReview rdfs:range hrai:ReviewDecision .
hrai:provisionTransposedFrom rdf:type owl:ObjectProperty .
hrai:provisionTransposedFrom rdfs:label "provisionTransposedFrom"@en .
hrai:provisionTransposedFrom rdfs:comment "Inferred (R26): reviewed equivalent or adapted correspondence with a provision of another jurisdiction."@en .
hrai:provisionTransposedFrom rdfs:domain hrai:LegalProvision .
hrai:provisionTransposedFrom rdfs:range hrai:LegalProvision .
hrai:requirementAssumesCapacity rdf:type owl:ObjectProperty .
hrai:requirementAssumesCapacity rdfs:label "requirementAssumesCapacity"@en .
hrai:requirementAssumesCapacity rdfs:comment "Capacity that the requirement presupposes."@en .
hrai:requirementAssumesCapacity rdfs:domain hrai:NormativeRequirement .
hrai:requirementAssumesCapacity rdfs:range hrai:CapacityRequirement .
hrai:capacityMeasuredBy rdf:type owl:ObjectProperty .
hrai:capacityMeasuredBy rdfs:label "capacityMeasuredBy"@en .
hrai:capacityMeasuredBy rdfs:comment "Indicator, with source, that measures the capacity."@en .
hrai:capacityMeasuredBy rdfs:domain hrai:CapacityRequirement .
hrai:capacityMeasuredBy rdfs:range hrai:ContextIndicator .
hrai:requirementHasCapacityRisk rdf:type owl:ObjectProperty .
hrai:requirementHasCapacityRisk rdfs:label "requirementHasCapacityRisk"@en .
hrai:requirementHasCapacityRisk rdfs:comment "Inferred (R25b): the capacity the requirement presupposes is below its alert threshold, per this indicator. Signal to investigate."@en .
hrai:requirementHasCapacityRisk rdfs:domain hrai:NormativeRequirement .
hrai:requirementHasCapacityRisk rdfs:range hrai:ContextIndicator .
hrai:exposureConcernsFunction rdf:type owl:ObjectProperty .
hrai:exposureConcernsFunction rdfs:label "exposureConcernsFunction"@en .
hrai:exposureConcernsFunction rdfs:comment "Area that should cover the exposure."@en .
hrai:exposureConcernsFunction rdfs:domain hrai:RiskExposureIndicator .
hrai:exposureConcernsFunction rdfs:range hrai:SubstantiveArea .
hrai:coverageForJurisdiction rdf:type owl:ObjectProperty .
hrai:coverageForJurisdiction rdfs:label "coverageForJurisdiction"@en .
hrai:coverageForJurisdiction rdfs:comment "Jurisdiction whose corpus was searched."@en .
hrai:coverageForJurisdiction rdfs:domain hrai:CoverageAssessment .
hrai:coverageForJurisdiction rdfs:range hrai:Jurisdiction .
hrai:coverageInSnapshot rdf:type owl:ObjectProperty .
hrai:coverageInSnapshot rdfs:label "coverageInSnapshot"@en .
hrai:coverageInSnapshot rdfs:comment "Snapshot searched."@en .
hrai:coverageInSnapshot rdfs:domain hrai:CoverageAssessment .
hrai:coverageInSnapshot rdfs:range hrai:SourceSnapshot .
hrai:coverageOfFunction rdf:type owl:ObjectProperty .
hrai:coverageOfFunction rdfs:label "coverageOfFunction"@en .
hrai:coverageOfFunction rdfs:comment "Area searched."@en .
hrai:coverageOfFunction rdfs:domain hrai:CoverageAssessment .
hrai:coverageOfFunction rdfs:range hrai:SubstantiveArea .
hrai:claimQualifies rdf:type owl:ObjectProperty .
hrai:claimQualifies rdfs:label "claimQualifies"@en .
hrai:claimQualifies rdfs:comment "The subject claim qualifies the object claim (narrows it); not a challenge."@en .
hrai:claimQualifies rdfs:domain hrai:PolicyClaim .
hrai:claimQualifies rdfs:range hrai:PolicyClaim .
hrai:claimComplements rdf:type owl:ObjectProperty .
hrai:claimComplements rdfs:label "claimComplements"@en .
hrai:claimComplements rdfs:comment "The subject claim complements the object claim; not a challenge."@en .
hrai:claimComplements rdfs:domain hrai:PolicyClaim .
hrai:claimComplements rdfs:range hrai:PolicyClaim .
hrai:specificityDimension rdf:type owl:ObjectProperty .
hrai:specificityDimension rdfs:label "specificityDimension"@en .
hrai:specificityDimension rdfs:comment "QN1 dimension that explains the specificity."@en .
hrai:specificityDimension rdfs:domain hrai:NationalSpecificity .
hrai:specificityDimension rdfs:range hrai:SpecificityDimension .
hrai:differenceType rdf:type owl:ObjectProperty .
hrai:differenceType rdfs:label "differenceType"@en .
hrai:differenceType rdfs:comment "Type of difference behind the specificity."@en .
hrai:differenceType rdfs:domain hrai:NationalSpecificity .
hrai:differenceType rdfs:range hrai:DifferenceType .
hrai:specificityGroundedIn rdf:type owl:ObjectProperty .
hrai:specificityGroundedIn rdfs:label "specificityGroundedIn"@en .
hrai:specificityGroundedIn rdfs:comment "Brazilian evidence: provision, indicator with source and base year, or PBIA objective. Mandatory."@en .
hrai:specificityGroundedIn rdfs:domain hrai:NationalSpecificity .
hrai:specificityComparison rdf:type owl:ObjectProperty .
