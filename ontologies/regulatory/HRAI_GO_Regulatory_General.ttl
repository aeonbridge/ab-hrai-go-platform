# ---------------------------------------------------------------------------
# v1.1.0 (proposta): investimento público e execução; fechamento de impacto;
# perspectivas sintéticas; dispositivos e requisitos de propostas legislativas.
# Mudança aditiva: nenhum termo da v1.0.0 foi removido ou renomeado.
# ---------------------------------------------------------------------------
hrai:PublicPolicyPlan rdf:type owl:Class .
hrai:PublicPolicyPlan rdfs:label "PublicPolicyPlan"@en .
hrai:PublicPolicyPlan rdfs:comment "Time-bound public plan (e.g. a national AI plan) organised in axes and funded by budget allocations. A plan is not a regulation."@en .
hrai:PublicPolicyPlan rdfs:subClassOf hrai:PolicyInstrument .
hrai:PolicyPlanAxis rdf:type owl:Class .
hrai:PolicyPlanAxis rdfs:label "PolicyPlanAxis"@en .
hrai:PolicyPlanAxis rdfs:comment "Thematic axis or programme line of a public policy plan."@en .
hrai:PolicyPlanAxis rdfs:subClassOf hrai:PolicyInstrument .
hrai:BudgetAllocation rdf:type owl:Class .
hrai:BudgetAllocation rdfs:label "BudgetAllocation"@en .
hrai:BudgetAllocation rdfs:comment "Planned public funding attached to a policy instrument for a period. A declared amount, not evidence of execution."@en .
hrai:ExecutionRecord rdf:type owl:Class .
hrai:ExecutionRecord rdfs:label "ExecutionRecord"@en .
hrai:ExecutionRecord rdfs:comment "Observed execution (committed, disbursed or paid) of a budget allocation at a date, captured from a source snapshot."@en .
hrai:ExecutionBelowAlertRatioRecord rdf:type owl:Class .
hrai:ExecutionBelowAlertRatioRecord rdfs:label "ExecutionBelowAlertRatioRecord"@en .
hrai:ExecutionBelowAlertRatioRecord rdfs:comment "Execution record whose executed/allocated ratio is below an analyst-configured alert ratio. Investigative signal, not evidence of policy failure."@en .
hrai:ExecutionBelowAlertRatioRecord rdfs:subClassOf hrai:ExecutionRecord .
hrai:planHasAxis rdf:type owl:ObjectProperty .
hrai:planHasAxis rdfs:domain hrai:PublicPolicyPlan .
hrai:planHasAxis rdfs:range hrai:PolicyPlanAxis .
hrai:planHasAxis rdfs:label "planHasAxis"@en .
hrai:planHasAxis rdfs:comment "Links a plan to one of its axes."@en .
hrai:instrumentPursuesObjective rdf:type owl:ObjectProperty .
hrai:instrumentPursuesObjective rdfs:domain hrai:PolicyInstrument .
hrai:instrumentPursuesObjective rdfs:range hrai:PolicyObjective .
hrai:instrumentPursuesObjective rdfs:label "instrumentPursuesObjective"@en .
hrai:instrumentPursuesObjective rdfs:comment "Objective declared by a policy instrument. Use instead of pursuesObjective, whose domain is RegulatoryModel."@en .
hrai:instrumentHasAllocation rdf:type owl:ObjectProperty .
hrai:instrumentHasAllocation rdfs:domain hrai:PolicyInstrument .
hrai:instrumentHasAllocation rdfs:range hrai:BudgetAllocation .
hrai:instrumentHasAllocation rdfs:label "instrumentHasAllocation"@en .
hrai:instrumentHasAllocation rdfs:comment "Budget allocation planned for a policy instrument."@en .
hrai:allocationExecutionRecord rdf:type owl:ObjectProperty .
hrai:allocationExecutionRecord rdfs:domain hrai:BudgetAllocation .
hrai:allocationExecutionRecord rdfs:range hrai:ExecutionRecord .
hrai:allocationExecutionRecord rdfs:label "allocationExecutionRecord"@en .
hrai:allocationExecutionRecord rdfs:comment "Execution observation for an allocation."@en .
hrai:allocationSource rdf:type owl:ObjectProperty .
hrai:allocationSource rdfs:domain hrai:BudgetAllocation .
hrai:allocationSource rdfs:range hrai:SourceSnapshot .
hrai:allocationSource rdfs:label "allocationSource"@en .
hrai:allocationSource rdfs:comment "Source snapshot that declares the allocation."@en .
hrai:executionRecordSource rdf:type owl:ObjectProperty .
hrai:executionRecordSource rdfs:domain hrai:ExecutionRecord .
hrai:executionRecordSource rdfs:range hrai:SourceSnapshot .
hrai:executionRecordSource rdfs:label "executionRecordSource"@en .
hrai:executionRecordSource rdfs:comment "Source snapshot from which execution was captured."@en .
hrai:allocatedAmount rdf:type owl:DatatypeProperty .
hrai:allocatedAmount rdfs:domain hrai:BudgetAllocation .
hrai:allocatedAmount rdfs:range xsd:decimal .
hrai:allocatedAmount rdfs:label "allocatedAmount"@en .
hrai:allocatedAmount rdfs:comment "Declared allocated amount, in allocationCurrency."@en .
hrai:allocationCurrency rdf:type owl:DatatypeProperty .
hrai:allocationCurrency rdfs:domain hrai:BudgetAllocation .
hrai:allocationCurrency rdfs:range xsd:string .
hrai:allocationCurrency rdfs:label "allocationCurrency"@en .
hrai:allocationCurrency rdfs:comment "ISO 4217 currency code of the allocated amount."@en .
hrai:allocationPeriodStart rdf:type owl:DatatypeProperty .
hrai:allocationPeriodStart rdfs:domain hrai:BudgetAllocation .
hrai:allocationPeriodStart rdfs:range xsd:date .
hrai:allocationPeriodStart rdfs:label "allocationPeriodStart"@en .
hrai:allocationPeriodStart rdfs:comment "Start of the allocation period."@en .
hrai:allocationPeriodEnd rdf:type owl:DatatypeProperty .
hrai:allocationPeriodEnd rdfs:domain hrai:BudgetAllocation .
hrai:allocationPeriodEnd rdfs:range xsd:date .
hrai:allocationPeriodEnd rdfs:label "allocationPeriodEnd"@en .
hrai:allocationPeriodEnd rdfs:comment "End of the allocation period."@en .
hrai:executionAlertRatio rdf:type owl:DatatypeProperty .
hrai:executionAlertRatio rdfs:domain hrai:BudgetAllocation .
hrai:executionAlertRatio rdfs:range xsd:decimal .
hrai:executionAlertRatio rdfs:label "executionAlertRatio"@en .
hrai:executionAlertRatio rdfs:comment "Analyst-configured investigative ratio (0-1). Not a legal or contractual target."@en .
hrai:executedAmount rdf:type owl:DatatypeProperty .
hrai:executedAmount rdfs:domain hrai:ExecutionRecord .
hrai:executedAmount rdfs:range xsd:decimal .
hrai:executedAmount rdfs:label "executedAmount"@en .
hrai:executedAmount rdfs:comment "Observed executed amount, in executionCurrency."@en .
hrai:executionCurrency rdf:type owl:DatatypeProperty .
hrai:executionCurrency rdfs:domain hrai:ExecutionRecord .
hrai:executionCurrency rdfs:range xsd:string .
hrai:executionCurrency rdfs:label "executionCurrency"@en .
hrai:executionCurrency rdfs:comment "ISO 4217 currency code of the executed amount."@en .
hrai:executionKind rdf:type owl:DatatypeProperty .
hrai:executionKind rdfs:domain hrai:ExecutionRecord .
hrai:executionKind rdfs:range xsd:string .
hrai:executionKind rdfs:label "executionKind"@en .
hrai:executionKind rdfs:comment "Execution stage observed: committed, disbursed or paid. Stages are not comparable with each other."@en .
hrai:executionObservedAt rdf:type owl:DatatypeProperty .
hrai:executionObservedAt rdfs:domain hrai:ExecutionRecord .
hrai:executionObservedAt rdfs:range xsd:date .
hrai:executionObservedAt rdfs:label "executionObservedAt"@en .
hrai:executionObservedAt rdfs:comment "Date the execution figure refers to."@en .
hrai:ImpactReviewOutcome rdf:type owl:Class .
hrai:ImpactReviewOutcome rdfs:label "ImpactReviewOutcome"@en .
hrai:ImpactReviewOutcome rdfs:comment "Controlled outcome of a change impact evaluation."@en .
hrai:NoMaterialImpactOutcome rdf:type hrai:ImpactReviewOutcome .
hrai:NoMaterialImpactOutcome rdfs:label "NoMaterialImpact"@en .
hrai:ReassessmentRequiredOutcome rdf:type hrai:ImpactReviewOutcome .
hrai:ReassessmentRequiredOutcome rdfs:label "ReassessmentRequired"@en .
hrai:ReassessmentCompletedOutcome rdf:type hrai:ImpactReviewOutcome .
hrai:ReassessmentCompletedOutcome rdfs:label "ReassessmentCompleted"@en .
hrai:impactEvaluationHasOutcome rdf:type owl:ObjectProperty .
hrai:impactEvaluationHasOutcome rdfs:domain hrai:ChangeImpactAssessment .
hrai:impactEvaluationHasOutcome rdfs:range hrai:ImpactReviewOutcome .
hrai:impactEvaluationHasOutcome rdfs:label "impactEvaluationHasOutcome"@en .
hrai:impactEvaluationHasOutcome rdfs:comment "Outcome recorded by a human impact evaluation."@en .
hrai:impactEvaluationBy rdf:type owl:ObjectProperty .
hrai:impactEvaluationBy rdfs:domain hrai:ChangeImpactAssessment .
hrai:impactEvaluationBy rdfs:range hrai:ReviewActor .
hrai:impactEvaluationBy rdfs:label "impactEvaluationBy"@en .
hrai:impactEvaluationBy rdfs:comment "Reviewer responsible for the impact evaluation."@en .
hrai:impactEvaluatedAt rdf:type owl:DatatypeProperty .
hrai:impactEvaluatedAt rdfs:domain hrai:ChangeImpactAssessment .
hrai:impactEvaluatedAt rdfs:range xsd:dateTime .
hrai:impactEvaluatedAt rdfs:label "impactEvaluatedAt"@en .
hrai:impactEvaluatedAt rdfs:comment "When the impact evaluation was recorded."@en .
hrai:assessmentImpactEvaluatedFor rdf:type owl:ObjectProperty .
hrai:assessmentImpactEvaluatedFor rdfs:domain hrai:ComplianceAssessment .
hrai:assessmentImpactEvaluatedFor rdfs:range hrai:RegulatoryChangeEvent .
hrai:assessmentImpactEvaluatedFor rdfs:label "assessmentImpactEvaluatedFor"@en .
hrai:assessmentImpactEvaluatedFor rdfs:comment "Inferred: an impact evaluation with an outcome exists for this assessment and change. Does not change compliance status."@en .
hrai:impactReviewStatus owl:deprecated true .
hrai:impactReviewStatus rdfs:comment "Deprecated in 1.1.0: free-text status. Use impactEvaluationHasOutcome with an ImpactReviewOutcome individual."@en .
hrai:SyntheticStakeholderPerspective rdf:type owl:Class .
hrai:SyntheticStakeholderPerspective rdfs:label "SyntheticStakeholderPerspective"@en .
hrai:SyntheticStakeholderPerspective rdfs:comment "Documented perspective voiced by a synthetic agent (e.g. an SCSE council seat). Never a real person, group or authority. Aligns conceptually with scse:PerspectiveAgent; no formal import."@en .
hrai:SyntheticStakeholderPerspective rdfs:subClassOf hrai:Stakeholder .
hrai:IdentifiedStakeholder rdf:type owl:Class .
hrai:IdentifiedStakeholder rdfs:label "IdentifiedStakeholder"@en .
hrai:IdentifiedStakeholder rdfs:comment "Stakeholder whose identity or institutional mandate was verified by the platform."@en .
hrai:IdentifiedStakeholder rdfs:subClassOf hrai:Stakeholder .
hrai:SyntheticStakeholderPerspective owl:disjointWith hrai:IdentifiedStakeholder .
hrai:SyntheticStakeholderPosition rdf:type owl:Class .
hrai:SyntheticStakeholderPosition rdfs:label "SyntheticStakeholderPosition"@en .
hrai:SyntheticStakeholderPosition rdfs:comment "Position expressed by a synthetic perspective. Must not be read as a stakeholder's actual view."@en .
hrai:SyntheticStakeholderPosition rdfs:subClassOf hrai:StakeholderPosition .
hrai:perspectiveGroundedIn rdf:type owl:ObjectProperty .
hrai:perspectiveGroundedIn rdfs:domain hrai:SyntheticStakeholderPerspective .
hrai:perspectiveGroundedIn rdfs:range hrai:Evidence .
hrai:perspectiveGroundedIn rdfs:label "perspectiveGroundedIn"@en .
hrai:perspectiveGroundedIn rdfs:comment "Documented source that grounds a synthetic perspective."@en .
hrai:ProposedProvision rdf:type owl:Class .
hrai:ProposedProvision rdfs:label "ProposedProvision"@en .
hrai:ProposedProvision rdfs:comment "Provision contained in a version of a legislative proposal. Has no binding force."@en .
hrai:ProposedProvision rdfs:subClassOf hrai:LegalProvision .
hrai:ProspectiveRequirement rdf:type owl:Class .
hrai:ProspectiveRequirement rdfs:label "ProspectiveRequirement"@en .
hrai:ProspectiveRequirement rdfs:comment "Normative requirement derived from a proposed provision. Prospective, not currently binding."@en .
hrai:ProspectiveRequirement rdfs:subClassOf hrai:NormativeRequirement .
hrai:instrumentInJurisdiction rdfs:comment "Jurisdiction where the instrument originates. Origin only: says nothing about enactment, effectiveness or applicability. For proposals, prefer proposalInJurisdiction."@en .
hrai:provisionInJurisdiction rdfs:comment "Jurisdictional origin of a provision. A provision of a LegislativeProposal is also typed ProposedProvision (R22)."@en .
hrai:proposalInJurisdiction rdfs:subPropertyOf hrai:instrumentInJurisdiction .
hrai:R19_ExecutionBelowAlertRatio rdf:type swrl:Imp .
hrai:R19_ExecutionBelowAlertRatio rdfs:label "R19_ExecutionBelowAlertRatio"@en .
hrai:R19_ExecutionBelowAlertRatio rdfs:comment "Investigative execution signal, not evidence of policy failure; read period and execution kind first."@en .
