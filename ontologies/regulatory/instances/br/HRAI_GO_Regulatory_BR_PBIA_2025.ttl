# 3. Indicadores de contexto (valores citados pelo PBIA)
# -----------------------------------------------------------------------------

pbia:Ind_RenewableShareElectricityMatrix2023
    a hrai:ContextIndicator ;
    rdfs:label "Participação de fontes renováveis na matriz elétrica brasileira (2023)"@pt ;
    hrai:hasNumericValue "89.2"^^xsd:decimal ;
    hrai:numericUnit "percent" ;
    hrai:hasIndicatorMethod "EPE (2024), citado no PBIA, Eixo 1 'Onde estamos?', p. 34. Ano de referência: 2023."@pt ;
    hrai:indicatorMeasuredFor pbia:BrazilAIContext_PBIA ;
    hrai:indicatorMeasuresDimension pbia:Dim_EnergySustainability ;
    hrai:indicatorSource pbia:Snapshot_PBIA_VN8 .

pbia:Ind_RenewableShareEnergyMatrix_Axis4
    a hrai:ContextIndicator ;
