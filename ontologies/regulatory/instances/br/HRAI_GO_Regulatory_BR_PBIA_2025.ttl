# -----------------------------------------------------------------------------
# 6. Lacunas e tensões regulatórias
# -----------------------------------------------------------------------------

pbia:Gap_NoSpecificAILaw
    a hrai:RegulatoryGap ;
    rdfs:label "Ausência de lei específica de IA no Brasil"@pt ;
    hrai:gapInJurisdiction pbia:Brazil ;
    hrai:gapConcernsObjective pbia:Obj_Axis5_ThreeYear , pbia:Obj_Pillar4_TransparentAccountable ;
    dcterms:references pbia:PL_2338_2023 ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec3_4_5 ;
    rdfs:comment "Na ausência de lei específica, o desafio é promover confiança pública, padrões adequados à realidade brasileira e orientações de boas práticas."@pt .

pbia:Gap_AISpecificDataGovernance
    a hrai:RegulatoryGap ;
    rdfs:label "Lacunas na governança de dados específica para IA (componentes estratégico e prático)"@pt ;
    hrai:gapInJurisdiction pbia:Brazil ;
    hrai:gapConcernsObjective pbia:Obj_Pillar4_TransparentAccountable ;
    dcterms:references pbia:Law_12527_2011 , pbia:Law_13709_2018_LGPD , pbia:Decree_10046_2019 ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec3_4_5 ;
    rdfs:comment "O quadro de dados (LAI, LGPD, Decreto 10.046/2019) existe, mas persistem lacunas na parametrização do desenvolvimento e uso ético e responsável da IA."@pt .

pbia:Tension_InnovationVsRightsProtection
    a hrai:RegulatoryTension ;
    rdfs:label "Fomento à inovação versus proteção de direitos individuais e coletivos"@pt ;
    hrai:tensionInJurisdiction pbia:Brazil ;
    hrai:tensionInvolvesObjective pbia:Obj_GlobalLeadershipSovereignty , pbia:Obj_Pillar4_TransparentAccountable ;
    hrai:hasPolicyClaim pbia:Claim_AgileRegulationWithoutInhibitingInnovation ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec1 .

pbia:Tension_AutomationVsLabourProtection
    a hrai:RegulatoryTension ;
    rdfs:label "Automação por IA versus proteção do trabalho e dos trabalhadores"@pt ;
    hrai:tensionInJurisdiction pbia:Brazil ;
    hrai:tensionInvolvesObjective pbia:Obj_CentralObjective , pbia:Obj_ImproveLivesProductiveCapacity ;
    hrai:hasPolicyClaim pbia:Claim_AIThreatensEmployment , pbia:Claim_HistoricalAdaptationBenefits ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec1 .

pbia:Tension_ComputeExpansionVsEnergyWater
    a hrai:RegulatoryTension ;
    rdfs:label "Expansão de data centers e supercomputação versus consumo de energia e água e estabilidade do sistema elétrico"@pt ;
    hrai:tensionInJurisdiction pbia:Brazil ;
    hrai:tensionInvolvesObjective pbia:Obj_TechVanguardComputeInfrastructure , pbia:Obj_Pillar2_SocialEnvironmentalChallenges ;
    hrai:hasPolicyClaim pbia:Claim_CleanMatrixCompetitiveAdvantage , pbia:Claim_DataCentreGridOverloadRisk ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec3 .

pbia:Tension_SovereigntyVsInternationalCooperation
    a hrai:RegulatoryTension ;
    rdfs:label "Soberania tecnológica e de dados versus colaboração internacional"@pt ;
    hrai:tensionInJurisdiction pbia:Brazil ;
    hrai:tensionInvolvesObjective pbia:Obj_Pillar3_RightToDevelopmentSovereignty , pbia:Obj_Pillar5_FairGlobalCooperation ;
    hrai:hasPolicyClaim pbia:Claim_SovereigntyCooperationBalance ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec2 .

pbia:Tension_TalentMigrationAcademiaIndustry
    a hrai:RegulatoryTension ;
    rdfs:label "Migração de talentos da academia para a indústria: competitividade versus capacidade de pesquisa e formação"@pt ;
    hrai:tensionInJurisdiction pbia:Brazil ;
    hrai:tensionInvolvesObjective pbia:Obj_TechVanguardComputeInfrastructure ;
    hrai:hasPolicyClaim pbia:Claim_TalentMigrationContradiction ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec1 .

# -----------------------------------------------------------------------------
# 7. Afirmações de política (claims). Evidência anexada NÃO verifica veracidade.
# -----------------------------------------------------------------------------

pbia:Claim_AgileRegulationWithoutInhibitingInnovation
    a hrai:PolicyClaim ;
    rdfs:label "Marcos regulatórios ágeis devem proteger organizações e consumidores sem inibir a inovação"@pt ;
    hrai:claimText "O desenvolvimento acelerado da IA demanda marcos regulatórios ágeis que garantam seu uso ético e seguro, protegendo organizações e consumidores finais sem inibir a inovação."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec1 .

pbia:Claim_AIThreatensEmployment
    a hrai:PolicyClaim ;
    rdfs:label "A IA desafia estruturas tradicionais de emprego e suscita receio de desemprego tecnológico"@pt ;
    hrai:claimText "Na educação e no trabalho, a IA desafia estruturas tradicionais de emprego, exigindo adaptação e requalificação; revoluções tecnológicas suscitam preocupações com o desemprego tecnológico."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec1 ;
    hrai:challengedByClaim pbia:Claim_HistoricalAdaptationBenefits .

pbia:Claim_HistoricalAdaptationBenefits
    a hrai:PolicyClaim ;
    rdfs:label "A trajetória histórica sugere adaptação das sociedades e benefícios econômicos após a apreensão inicial"@pt ;
    hrai:claimText "Após um período inicial de apreensão, as sociedades tendem a se adaptar às novas tecnologias, frequentemente resultando em benefícios econômicos e sociais abrangentes; a transição, porém, raramente é uniforme."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec1 .

pbia:Claim_CleanMatrixCompetitiveAdvantage
    a hrai:PolicyClaim ;
    rdfs:label "A matriz elétrica limpa é vantagem competitiva para IA sustentável"@pt ;
    hrai:claimText "A matriz elétrica predominantemente limpa e renovável do Brasil é um diferencial estratégico para o desenvolvimento de uma IA sustentável."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec3 .

pbia:Claim_DataCentreGridOverloadRisk
    a hrai:PolicyClaim ;
    rdfs:label "Novos supercomputadores e data centers podem sobrecarregar o sistema elétrico nacional"@pt ;
    hrai:claimText "O crescimento previsto de supercomputadores e data centers representa um desafio potencial de sobrecarga ao sistema elétrico nacional, exigindo planejamento e investimentos em eficiência energética."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec3 .

pbia:Claim_SovereigntyCooperationBalance
    a hrai:PolicyClaim ;
    rdfs:label "É preciso equilibrar proteção dos interesses nacionais e colaborações internacionais mutuamente benéficas"@pt ;
    hrai:claimText "Deve-se buscar um equilíbrio entre a proteção dos interesses nacionais e a participação em colaborações internacionais mutuamente benéficas, com atenção a países da África e da América Latina."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec2 .

pbia:Claim_TalentMigrationContradiction
    a hrai:PolicyClaim ;
    rdfs:label "A migração de talentos para a indústria é desejável e preocupante ao mesmo tempo"@pt ;
    hrai:claimText "A migração de talentos da academia para a indústria é desejável do ponto de vista da competitividade, mas pode ameaçar a capacidade da academia de inovar e formar a próxima geração de pesquisadores."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec1 .

pbia:Claim_AIIsNotPanacea
    a hrai:PolicyClaim ;
    rdfs:label "A IA não é solução universal; o sucesso do PBIA depende de ações complementares"@pt ;
    hrai:claimText "A IA é uma ferramenta estratégica para gargalos específicos; o sucesso do PBIA depende de ações complementares em educação, infraestrutura digital e redução de disparidades regionais."@pt ;
    hrai:claimSupportedByEvidence pbia:Evidence_PBIA_Sec3 .

# -----------------------------------------------------------------------------
# 8. Stakeholders e posições
# -----------------------------------------------------------------------------

# Nível institucional apenas. Pessoas físicas citadas no PBIA (titulares e
# suplentes do CCT, equipe técnica) não são instanciadas: um representante não
# é stakeholder institucional e nomes pessoais não agregam ao modelo.
# Tipos schema:* adicionais classificam a natureza jurídica/setorial do ator.
# Vínculos usam vocabulário existente (schema:memberOf, schema:parentOrganization,
# schema:funder, schema:provider, dcterms:contributor), sem estender a TBox.

