# =============================================================================
# HRAI-GO Regulatory General Ontology — ABox (instâncias)
# Fonte: Plano Brasileiro de Inteligência Artificial (PBIA) 2024-2028
#        MCTI / CGEE, Brasília, 2025, 104 p., ISBN 978-65-5775-097-1
#        Arquivo: docs/ai-regulations/br/000149 - CGEE Plano Brasileiro de
#                 Inteligência Artificial (VN) 8 Defeso Eleitoral.pdf
#        SHA-256: b654240701e7be87578e6dc505244366d35b8cadeeb01727ae12b091ef3e46f5
#
# Decisões de modelagem (separações epistemológicas da TBox):
#  - O PBIA é um PLANO de política pública, não uma norma jurídica. Por isso é
#    instanciado como hrai:PolicyInstrument, e NÃO como hrai:LegalInstrument.
#    Nenhum hrai:NormativeRequirement é derivado dele.
#  - Normas citadas pelo PBIA (LAI, LGPD, decretos, portaria, AI Act) são
#    registradas apenas como referências (hrai:LegalInstrument); não são
#    extraídos dispositivos, versões vigentes nem requisitos a partir delas.
#  - O PL 2338/2023 é hrai:LegislativeProposal (em tramitação segundo a fonte).
#    Seu estado ProposedLegalStatus reflete a data da fonte, não o dia de hoje.
#  - Todo o conteúdo é extração candidata (hrai:CandidateAssertion) sem
#    hrai:ReviewDecision: NÃO está aprovado para publicação em KnowledgeGraphRelease.
#  - Valores monetários usam schema:MonetaryAmount (vocabulário existente),
#    evitando criar propriedade nova na TBox.
#  - Indicadores reproduzem números citados pela fonte (que cita terceiros);
#    a fonte primária de cada número está em hrai:hasIndicatorMethod.
# =============================================================================

@prefix pbia:    <https://hrai-go.aeonbridge.io/data/regulatory/br/pbia#> .
@prefix hrai:    <https://hrai-go.aeonbridge.io/ontology/regulatory#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <https://schema.org/> .

<https://hrai-go.aeonbridge.io/data/regulatory/br/pbia>
    a owl:Ontology ;
    owl:imports <https://hrai-go.aeonbridge.io/ontology/regulatory> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "HRAI-GO ABox — Plano Brasileiro de Inteligência Artificial (PBIA) 2024-2028"@pt ;
    dcterms:created "2026-11-11"^^xsd:date ;
    prov:wasDerivedFrom pbia:Snapshot_PBIA_VN8 ;
    rdfs:comment "Instâncias candidatas extraídas do PBIA. Não certificam aplicabilidade jurídica, vigência ou conformidade. Pendentes de revisão humana."@pt .

# -----------------------------------------------------------------------------
# 1. Proveniência: fonte, snapshot, agente de extração e lote
# -----------------------------------------------------------------------------

pbia:Source_PBIA
    a hrai:LegalSource ;
    rdfs:label "Publicação MCTI/CGEE — Plano Brasileiro de Inteligência Artificial"@pt ;
    hrai:sourceURI "urn:isbn:978-65-5775-097-1"^^xsd:anyURI ;
    rdfs:comment "Fonte documental de política pública (não é diário oficial). Os Anexos 1 e 2 são atualizados periodicamente pelo MCTI, segundo a nota 1 da Introdução."@pt .

pbia:Snapshot_PBIA_VN8
    a hrai:SourceSnapshot ;
    rdfs:label "PBIA — versão VN 8 (edição para o período de defeso eleitoral), PDF 108 páginas"@pt ;
    hrai:snapshotOfSource pbia:Source_PBIA ;
    hrai:snapshotURI "https://github.com/aeonbridge/ab-hrai-go-platform/blob/main/docs/ai-regulations/br/000149%20-%20CGEE%20Plano%20Brasileiro%20de%20Intelig%C3%AAncia%20Artificial%20(VN)%208%20Defeso%20Eleitoral.pdf"^^xsd:anyURI ;
    hrai:snapshotSHA256 "b654240701e7be87578e6dc505244366d35b8cadeeb01727ae12b091ef3e46f5" ;
    hrai:sourcePublishedAt "2026-07-17T10:42:03-03:00"^^xsd:dateTime ;
    hrai:sourceCapturedAt "2026-11-11T23:02:00-03:00"^^xsd:dateTime ;
    rdfs:comment "sourcePublishedAt corresponde ao CreationDate do PDF (Adobe InDesign). A ficha catalográfica do documento indica ano de publicação 2025."@pt .

pbia:Agent_DocumentExtraction
    a hrai:MonitoringAgent ;
    rdfs:label "Agente de extração documental HRAI-GO (Claude Code, extração assistida por LLM)"@pt .

pbia:Batch_PBIA_20261111
    a hrai:ExtractionBatch ;
    rdfs:label "Lote de extração PBIA — 2026-11-11"@pt ;
    hrai:extractionContainsCandidate
        pbia:Candidate_PolicyInstruments ,
        pbia:Candidate_NationalContext ,
        pbia:Candidate_TensionsGapsClaims ,
        pbia:Candidate_LegalReferences ,
        pbia:Candidate_Deliberation ,
        pbia:Candidate_AIApplications .

pbia:Candidate_PolicyInstruments
    a hrai:CandidateAssertion ;
    rdfs:label "Candidato: PBIA, eixos, programas, ações e orçamentos (Seções 3 e Anexo 2)"@pt ;
    hrai:candidateFromSnapshot pbia:Snapshot_PBIA_VN8 ;
    hrai:candidateProducedBy pbia:Agent_DocumentExtraction .

pbia:Candidate_NationalContext
    a hrai:CandidateAssertion ;
    rdfs:label "Candidato: contexto nacional e indicadores (Seções 1 e 3.4 — 'Onde estamos?')"@pt ;
    hrai:candidateFromSnapshot pbia:Snapshot_PBIA_VN8 ;
    hrai:candidateProducedBy pbia:Agent_DocumentExtraction .

pbia:Candidate_TensionsGapsClaims
    a hrai:CandidateAssertion ;
    rdfs:label "Candidato: tensões, lacunas e afirmações de política (Seções 1, 2 e 3.4.5)"@pt ;
    hrai:candidateFromSnapshot pbia:Snapshot_PBIA_VN8 ;
    hrai:candidateProducedBy pbia:Agent_DocumentExtraction .

pbia:Candidate_LegalReferences
    a hrai:CandidateAssertion ;
    rdfs:label "Candidato: normas e proposta legislativa citadas (Seção 3.4.5, nota 2 e nota 10)"@pt ;
    hrai:candidateFromSnapshot pbia:Snapshot_PBIA_VN8 ;
    hrai:candidateProducedBy pbia:Agent_DocumentExtraction .

pbia:Candidate_Deliberation
    a hrai:CandidateAssertion ;
    rdfs:label "Candidato: processo participativo de elaboração do PBIA (Introdução)"@pt ;
    hrai:candidateFromSnapshot pbia:Snapshot_PBIA_VN8 ;
    hrai:candidateProducedBy pbia:Agent_DocumentExtraction .

pbia:Candidate_AIApplications
    a hrai:CandidateAssertion ;
    rdfs:label "Candidato: iniciativas de IA de empresas no Brasil (Tabela 1)"@pt ;
    hrai:candidateFromSnapshot pbia:Snapshot_PBIA_VN8 ;
    hrai:candidateProducedBy pbia:Agent_DocumentExtraction .

pbia:Change_PBIA_VN8_Captured
    a hrai:RegulatoryChangeEvent ;
    rdfs:label "Captura da versão VN 8 do PBIA"@pt ;
    hrai:changeObservedInSnapshot pbia:Snapshot_PBIA_VN8 ;
    hrai:changeDetectedBy pbia:Agent_DocumentExtraction ;
    hrai:changeDetectedAt "2026-11-11T23:02:00-03:00"^^xsd:dateTime ;
    hrai:changeRecordedAt "2026-11-11T23:02:00-03:00"^^xsd:dateTime ;
    hrai:changeDescription "Primeira ingestão do PBIA no grafo. Não há versão anterior registrada para comparação (diff)."@pt .

