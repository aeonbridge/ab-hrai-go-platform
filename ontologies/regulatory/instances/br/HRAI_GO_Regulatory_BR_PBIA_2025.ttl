pbia:Action01_AISupercomputer
    a hrai:PolicyInstrument ;
    rdfs:label "Ação 1 — Supercomputador de IA (Top 5 mundial)"@pt ;
    dcterms:isPartOf pbia:PBIA_Axis1_InfrastructureDevelopment ;
