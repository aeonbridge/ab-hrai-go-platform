    prov:wasDerivedFrom pbia:Snapshot_PBIA_VN8 .

pbia:Evidence_PBIA_Sec3_4_5
    a hrai:Evidence ;
    rdfs:label "PBIA, Seção 3.4.5 — Eixo 5: Apoio ao processo regulatório e de governança (p. 42-44)"@pt ;
    prov:wasDerivedFrom pbia:Snapshot_PBIA_VN8 .

pbia:Evidence_PBIA_Annex2
