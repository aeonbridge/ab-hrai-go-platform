# -----------------------------------------------------------------------------
# 2. Jurisdições e contexto nacional
# -----------------------------------------------------------------------------

pbia:Brazil
    a hrai:Jurisdiction ;
    rdfs:label "Brasil"@pt , "Brazil"@en ;
    hrai:hasNationalContext pbia:BrazilAIContext_PBIA ;
    hrai:hasRegulatoryModel pbia:BrazilAIRegulatoryModel_PBIA .

pbia:EuropeanUnion
    a hrai:Jurisdiction ;
    rdfs:label "União Europeia"@pt , "European Union"@en ;
    rdfs:comment "Registrada apenas porque o PBIA cita o AI Act como referência de governança (Seção 4, nota 9)."@pt .

pbia:BrazilAIContext_PBIA
    a hrai:NationalContext ;
    rdfs:label "Contexto nacional de IA no Brasil segundo o PBIA (diagnósticos 'Onde estamos?')"@pt ;
    hrai:contextOfJurisdiction pbia:Brazil ;
    prov:wasDerivedFrom pbia:Snapshot_PBIA_VN8 ;
    rdfs:comment "Vantagens: matriz elétrica limpa, SUS e bases de dados nacionais, população jovem com rápida adoção tecnológica, centros de pesquisa. Desafios: P&D insuficiente, infraestrutura computacional e de dados limitada, escassez de profissionais e fuga de cérebros, dependência externa de hardware, desigualdade educacional."@pt .

# Dimensões de contexto
pbia:Dim_ComputeInfrastructure a hrai:ContextDimension ; rdfs:label "Infraestrutura computacional"@pt .
pbia:Dim_EnergySustainability  a hrai:ContextDimension ; rdfs:label "Energia e sustentabilidade"@pt .
pbia:Dim_DataEcosystem         a hrai:ContextDimension ; rdfs:label "Ecossistema de dados"@pt .
pbia:Dim_SkillsEducation       a hrai:ContextDimension ; rdfs:label "Formação, capacitação e educação"@pt .
pbia:Dim_PublicSectorAdoption  a hrai:ContextDimension ; rdfs:label "Adoção de IA no setor público"@pt .
pbia:Dim_BusinessAdoption      a hrai:ContextDimension ; rdfs:label "Adoção de IA e inovação empresarial"@pt .
pbia:Dim_Productivity          a hrai:ContextDimension ; rdfs:label "Produtividade"@pt .

