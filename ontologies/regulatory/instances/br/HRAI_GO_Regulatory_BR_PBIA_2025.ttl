# --- 8.9 Posições ---------------------------------------------------------------

pbia:Pos_Presidency_AIForGood
    a hrai:StakeholderPosition ;
    rdfs:label "Presidência: IA 'do bem', ética e não discriminatória"@pt ;
    hrai:positionExpressedBy pbia:SH_PresidencyOfTheRepublic ;
    hrai:positionText "Necessidade de desenvolver e adotar tecnologia que melhore a vida do cidadão, pautada por princípios éticos e não discriminatórios; IA para saúde, para os pobres e para a descarbonização, e não para disseminar fake news (demanda ao CCT em 2024-03-07)."@pt ;
    hrai:positionSupportsClaim pbia:Claim_AgileRegulationWithoutInhibitingInnovation .

pbia:Pos_MCTI_SovereignAI
    a hrai:StakeholderPosition ;
    rdfs:label "MCTI: desenvolver IA no Brasil, com soberania e inclusão"@pt ;
    hrai:positionExpressedBy pbia:SH_MCTI ;
    hrai:positionText "Não importar simplesmente soluções, mas desenvolvê-las no Brasil, por brasileiros e para brasileiros; nuvem soberana para proteger dados estratégicos; ênfase em capacitação diante de impactos no trabalho (Apresentação)."@pt ;
    hrai:positionSupportsClaim pbia:Claim_SovereigntyCooperationBalance , pbia:Claim_HistoricalAdaptationBenefits .

pbia:Pos_ABC_EducationalInequality
    a hrai:StakeholderPosition ;
    rdfs:label "ABC: contexto educacional crítico e lacuna entre excelência acadêmica e implementação"@pt ;
    hrai:positionExpressedBy pbia:SH_ABC ;
    hrai:positionText "Apenas pequena parcela da população tem acesso à educação de qualidade; sem investimentos e políticas eficazes, o País corre risco de declínio tecnológico acelerado (ABC, 2023, citado no PBIA)."@pt ;
    hrai:positionSupportsClaim pbia:Claim_AIIsNotPanacea .

pbia:Pos_CNI_ProductivityDecline
    a hrai:StakeholderPosition ;
    rdfs:label "CNI: queda de produtividade industrial motiva adoção de IA"@pt ;
    hrai:positionExpressedBy pbia:SH_CNI ;
    hrai:positionText "Queda de 24% na produtividade do trabalho na indústria de transformação entre 2001 e 2021 (CNI, 2022, citado no PBIA)."@pt ;
    hrai:positionSupportsClaim pbia:Claim_HistoricalAdaptationBenefits .

# -----------------------------------------------------------------------------
# 9. Deliberação (elaboração participativa do PBIA) e alternativas
# -----------------------------------------------------------------------------

pbia:Delib_PBIAElaboration2024
    a hrai:Deliberation ;
    rdfs:label "Processo de elaboração participativa do PBIA (2024)"@pt ;
    hrai:deliberationIncludesPosition
        pbia:Pos_Presidency_AIForGood ,
        pbia:Pos_MCTI_SovereignAI ,
        pbia:Pos_ABC_EducationalInequality ,
        pbia:Pos_CNI_ProductivityDecline ;
    hrai:deliberatesOnTension
        pbia:Tension_InnovationVsRightsProtection ,
        pbia:Tension_AutomationVsLabourProtection ,
        pbia:Tension_ComputeExpansionVsEnergyWater ,
        pbia:Tension_SovereigntyVsInternationalCooperation ;
    hrai:deliberationProposesAlternative
        pbia:Alt_DualApproachImmediateAndStructural ,
        pbia:Alt_SoftLawAndRegulatorySupportPendingLaw ,
        pbia:Alt_InterministerialGovernanceCITDigital ;
    dcterms:references pbia:Ordinance_MCTI_8251_2024 ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec1 ;
    rdfs:comment "Quatro meses de trabalho: duas reuniões do CCT (38 documentos, mais de 300 propostas), seis oficinas temáticas (cerca de 300 participantes), mais de 30 reuniões bilaterais, 117 instituições públicas, privadas e da sociedade civil. GT coordenado pela Sexec/MCTI (Portaria MCTI 8.251/2024)."@pt .

pbia:Alt_DualApproachImmediateAndStructural
    a hrai:PolicyAlternative ;
    rdfs:label "Abordagem dual: ações de impacto imediato + ações estruturantes em cinco eixos"@pt ;
    hrai:alternativeTargetsObjective pbia:Obj_CentralObjective ;
    rdfs:comment "Alternativa adotada pelo PBIA: 1,9% do orçamento em ações de impacto imediato e 98% em ações estruturantes."@pt .

pbia:Alt_SoftLawAndRegulatorySupportPendingLaw
    a hrai:PolicyAlternative ;
    rdfs:label "Guias, observatório e centro de transparência como apoio ao processo regulatório enquanto o PL 2338/2023 tramita"@pt ;
    hrai:alternativeTargetsObjective pbia:Obj_Axis5_ThreeYear , pbia:Obj_Pillar4_TransparentAccountable .

pbia:Alt_InterministerialGovernanceCITDigital
    a hrai:PolicyAlternative ;
    rdfs:label "Governança do Plano por comitê interministerial (CIT Digital), inspirada em exemplos dos EUA, UE e Reino Unido"@pt ;
    hrai:alternativeTargetsObjective pbia:Obj_CentralObjective .

pbia:Assess_PBIADiagnostic
    a hrai:PolicyImpactAssessment ;
    rdfs:label "Diagnóstico do próprio PBIA ('Onde estamos?') que fundamenta a abordagem dual"@pt ;
    hrai:assessesPolicyAlternative pbia:Alt_DualApproachImmediateAndStructural ;
    hrai:assessmentUsesIndicator
        pbia:Ind_RenewableShareElectricityMatrix2023 ,
        pbia:Ind_DataCentersInOperation ,
        pbia:Ind_STEMGraduatesShare ,
        pbia:Ind_PublicBodiesUsingAI2023 ,
        pbia:Ind_CompaniesUsingAI ;
    hrai:policyAssessmentEvidence pbia:Evidence_PBIA_Sec3 ;
    hrai:impactAssessmentIdentifiesGap pbia:Gap_NoSpecificAILaw , pbia:Gap_AISpecificDataGovernance ;
    hrai:impactAssessmentIdentifiesTension pbia:Tension_ComputeExpansionVsEnergyWater ;
    rdfs:comment "Autoavaliação do formulador do plano, não avaliação independente de impacto."@pt .

