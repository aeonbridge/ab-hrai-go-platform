# -----------------------------------------------------------------------------
# 4. Modelo regulatório, objetivos e instrumentos de política
# -----------------------------------------------------------------------------

pbia:BrazilAIRegulatoryModel_PBIA
    a hrai:RegulatoryModel ;
    rdfs:label "Modelo brasileiro de política e governança de IA descrito no PBIA ('IA para o Bem de Todos')"@pt ;
    hrai:adoptedByJurisdiction pbia:Brazil ;
    hrai:usesPolicyInstrument
        pbia:PBIA_Plan ,
        pbia:PBIA_ImmediateImpactActions ,
        pbia:PBIA_Axis1_InfrastructureDevelopment ,
        pbia:PBIA_Axis2_DiffusionTraining ,
        pbia:PBIA_Axis3_PublicServices ,
        pbia:PBIA_Axis4_BusinessInnovation ,
        pbia:PBIA_Axis5_RegulatoryGovernanceSupport ,
        pbia:Prog5A_RegulatoryFrameworkImprovement ,
        pbia:Prog5B_AIGovernanceSupport ,
        pbia:Action50_ResponsibleAIGuides ,
        pbia:Action51_AlgorithmicTransparencyCentre ,
        pbia:Action52_BrazilianAIObservatory ,
        pbia:Action53_AIGovernanceSupportNetwork ,
        pbia:Action54_InternationalDebateNetwork ,
        pbia:Action01_AISupercomputer ,
        pbia:Action09_PortugueseLLM ,
        pbia:Action25_AIUseMonitoringGovernment ,
        pbia:Action27_SovereignCloud ,
        pbia:FederalGovernmentAICore ,
        pbia:PBIA_GovernanceByCITDigital ;
    hrai:pursuesObjective
        pbia:Obj_CentralObjective ,
        pbia:Obj_ImproveLivesProductiveCapacity ,
        pbia:Obj_TechVanguardComputeInfrastructure ,
        pbia:Obj_PortugueseLLMNationalData ,
        pbia:Obj_GlobalLeadershipSovereignty ,
        pbia:Obj_Pillar1_HumanCentred ,
        pbia:Obj_Pillar2_SocialEnvironmentalChallenges ,
        pbia:Obj_Pillar3_RightToDevelopmentSovereignty ,
        pbia:Obj_Pillar4_TransparentAccountable ,
        pbia:Obj_Pillar5_FairGlobalCooperation ,
        pbia:Obj_Axis5_ThreeYear ,
        pbia:Obj_Axis5_FiveYear ;
    prov:wasDerivedFrom pbia:Snapshot_PBIA_VN8 ;
    rdfs:comment "Modelo orientado a fomento e capacidades (98% do orçamento em ações estruturantes), com apoio ao processo regulatório em curso (PL 2338/2023) e instrumentos de soft law (guias, observatório) enquanto não há lei específica."@pt .

# --- Objetivos -----------------------------------------------------------------

pbia:Obj_CentralObjective
    a hrai:PolicyObjective ;
    rdfs:label "Objetivo central do PBIA"@pt ;
    dcterms:description "Promover o desenvolvimento, a disponibilização e o uso da inteligência artificial no Brasil, orientada à solução dos grandes desafios nacionais, sociais, econômicos, ambientais e culturais, de forma a garantir a segurança e os direitos individuais e coletivos, a inclusão social, a defesa da democracia, a integridade da informação, a proteção do trabalho e dos trabalhadores, a soberania nacional e o desenvolvimento econômico sustentável da nação."@pt ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec3 .

pbia:Obj_ImproveLivesProductiveCapacity
    a hrai:PolicyObjective ;
    rdfs:label "Melhorar a vida dos brasileiros por inovações em IA voltadas à capacidade produtiva e ao bem-estar social"@pt .

pbia:Obj_TechVanguardComputeInfrastructure
    a hrai:PolicyObjective ;
    rdfs:label "Posicionar o Brasil na vanguarda tecnológica com infraestrutura computacional para IA"@pt .

pbia:Obj_PortugueseLLMNationalData
    a hrai:PolicyObjective ;
    rdfs:label "Desenvolver LLMs em português baseados em dados nacionais"@pt .

pbia:Obj_GlobalLeadershipSovereignty
    a hrai:PolicyObjective ;
    rdfs:label "Fortalecer a liderança global do Brasil em IA com soberania e compartilhamento internacional de capacidades"@pt .

pbia:Obj_Pillar1_HumanCentred
    a hrai:PolicyObjective ;
    rdfs:label "Pilar I — IA centrada no ser humano e acessível a todos, prevenindo desigualdade e vieses discriminatórios"@pt .

pbia:Obj_Pillar2_SocialEnvironmentalChallenges
    a hrai:PolicyObjective ;
    rdfs:label "Pilar II — IA orientada à superação de desafios sociais, ambientais e econômicos e aos ODS"@pt .

pbia:Obj_Pillar3_RightToDevelopmentSovereignty
    a hrai:PolicyObjective ;
    rdfs:label "Pilar III — IA fundamentada no direito ao desenvolvimento e na soberania nacional"@pt .

pbia:Obj_Pillar4_TransparentAccountable
    a hrai:PolicyObjective ;
    rdfs:label "Pilar IV — IA transparente, rastreável e responsável (privacidade, soberania de dados, cibersegurança, consumidor, propriedade intelectual e direitos autorais)"@pt .

pbia:Obj_Pillar5_FairGlobalCooperation
    a hrai:PolicyObjective ;
    rdfs:label "Pilar V — Cooperação global justa, integridade da informação e defesa da democracia"@pt .

pbia:Obj_Axis5_ThreeYear
    a hrai:PolicyObjective ;
    rdfs:label "Eixo 5 — metas em três anos"@pt ;
    dcterms:description "Aprovar e implementar marco regulatório nacional para IA; criar comitê nacional de ética em IA com participação multissetorial; estabelecer padrões nacionais para avaliação de risco e impacto de sistemas de IA em setores críticos."@pt ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec3_4_5 .

pbia:Obj_Axis5_FiveYear
    a hrai:PolicyObjective ;
    rdfs:label "Eixo 5 — metas em cinco anos"@pt ;
    dcterms:description "Reconhecimento como líder regional em regulação e governança de IA; acordos de cooperação internacional em governança de IA com pelo menos 10 países; modelo brasileiro adotado ou adaptado por pelo menos 5 países em desenvolvimento."@pt ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec3_4_5 .

# --- Instrumentos: plano, eixos, programas e ações ------------------------------

pbia:PBIA_Plan
    a hrai:PolicyInstrument ;
    rdfs:label "Plano Brasileiro de Inteligência Artificial (PBIA) 2024-2028 — 'IA para o Bem de Todos'"@pt ;
    dcterms:identifier "ISBN 978-65-5775-097-1" ;
    dcterms:issued "2025"^^xsd:gYear ;
    dcterms:creator pbia:SH_MCTI , pbia:SH_CGEE ;
    dcterms:hasPart
        pbia:PBIA_ImmediateImpactActions ,
        pbia:PBIA_Axis1_InfrastructureDevelopment ,
        pbia:PBIA_Axis2_DiffusionTraining ,
        pbia:PBIA_Axis3_PublicServices ,
        pbia:PBIA_Axis4_BusinessInnovation ,
        pbia:PBIA_Axis5_RegulatoryGovernanceSupport ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "23030000000"^^xsd:decimal ; schema:currency "BRL" ] ;
    prov:wasDerivedFrom pbia:Snapshot_PBIA_VN8 ;
    rdfs:comment "Plano de política pública demandado ao CCT em 2024-03-07, coordenado pelo MCTI com apoio do CGEE. Investimento previsto 2024-2028: R$ 23,03 bilhões (crédito, recursos públicos e contrapartida privada). Não é instrumento jurídico vinculante."@pt .

pbia:PBIA_ImmediateImpactActions
    a hrai:PolicyInstrument ;
    rdfs:label "PBIA — Ações de impacto imediato (Anexo 1)"@pt ;
    dcterms:isPartOf pbia:PBIA_Plan ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "435040000"^^xsd:decimal ; schema:currency "BRL" ] ;
    rdfs:comment "1,9% do total. Nove áreas: saúde; agricultura e pecuária; meio ambiente, clima e sustentabilidade; indústria, comércio e serviços; educação; desenvolvimento social; gestão de serviços públicos; trabalho e emprego; defesa, segurança pública e cibernética. Resultados aferíveis em até 12 meses."@pt .

pbia:PBIA_Axis1_InfrastructureDevelopment
    a hrai:PolicyInstrument ;
    rdfs:label "PBIA — Eixo 1: Infraestrutura e desenvolvimento de IA"@pt ;
    dcterms:isPartOf pbia:PBIA_Plan ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "5790000000"^^xsd:decimal ; schema:currency "BRL" ] ;
    rdfs:comment "25,2% do total. Programas: Infraestrutura para IA; Sustentabilidade e Energias Renováveis para IA; Ecossistema de Dados e Software para IA; P&D em IA."@pt .

pbia:PBIA_Axis2_DiffusionTraining
    a hrai:PolicyInstrument ;
    rdfs:label "PBIA — Eixo 2: Difusão, formação e capacitação em IA"@pt ;
    dcterms:isPartOf pbia:PBIA_Plan ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "1150000000"^^xsd:decimal ; schema:currency "BRL" ] ;
    rdfs:comment "5,0% do total. Metas: 5.000 vagas de graduação e 190.000 profissionais capacitados em três anos; 230.000 profissionais e 85% da população adulta com conhecimento básico sobre IA em cinco anos."@pt .

pbia:PBIA_Axis3_PublicServices
    a hrai:PolicyInstrument ;
    rdfs:label "PBIA — Eixo 3: IA para melhoria do serviço público"@pt ;
    dcterms:isPartOf pbia:PBIA_Plan ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "1760000000"^^xsd:decimal ; schema:currency "BRL" ] ;
    rdfs:comment "7,6% do total. Metas: IA em 10 órgãos federais por ano e 20% dos servidores federais capacitados em três anos; 70% dos órgãos federais e 50% dos estaduais usando IA em cinco anos."@pt .

pbia:PBIA_Axis4_BusinessInnovation
    a hrai:PolicyInstrument ;
    rdfs:label "PBIA — Eixo 4: IA para inovação empresarial"@pt ;
    dcterms:isPartOf pbia:PBIA_Plan ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "13790000000"^^xsd:decimal ; schema:currency "BRL" ] ;
    rdfs:comment "59,9% do total. Alinhado à Nova Indústria Brasil (Missão 4). Metas: 25% de adoção de IA pelas empresas em três anos; 40% em cinco anos."@pt .

pbia:PBIA_Axis5_RegulatoryGovernanceSupport
    a hrai:PolicyInstrument ;
    rdfs:label "PBIA — Eixo 5: Apoio ao processo regulatório e de governança da IA"@pt ;
    dcterms:isPartOf pbia:PBIA_Plan ;
    dcterms:hasPart pbia:Prog5A_RegulatoryFrameworkImprovement , pbia:Prog5B_AIGovernanceSupport ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "103250000"^^xsd:decimal ; schema:currency "BRL" ] ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Sec3_4_5 ;
    rdfs:comment "0,4% do total. Busca consolidar arcabouço de governança de IA que promova a inovação, assegure o direito ao desenvolvimento, proteja direitos humanos, integridade da informação, direitos autorais e conexos, o trabalho e os trabalhadores."@pt .

pbia:Prog5A_RegulatoryFrameworkImprovement
    a hrai:PolicyInstrument ;
    rdfs:label "Programa de Apoio ao Aperfeiçoamento do Marco Regulatório para IA"@pt ;
    dcterms:isPartOf pbia:PBIA_Axis5_RegulatoryGovernanceSupport ;
    dcterms:hasPart pbia:Action50_ResponsibleAIGuides , pbia:Action51_AlgorithmicTransparencyCentre ;
    rdfs:comment "Estudos de impacto, metodologias de avaliação de risco e centro nacional de transparência algorítmica."@pt .

pbia:Prog5B_AIGovernanceSupport
    a hrai:PolicyInstrument ;
    rdfs:label "Programa de Apoio à Governança da IA"@pt ;
    dcterms:isPartOf pbia:PBIA_Axis5_RegulatoryGovernanceSupport ;
    dcterms:hasPart pbia:Action52_BrazilianAIObservatory , pbia:Action53_AIGovernanceSupportNetwork , pbia:Action54_InternationalDebateNetwork .

pbia:Action50_ResponsibleAIGuides
    a hrai:PolicyInstrument ;
    rdfs:label "Ação 50 — Guias Brasileiros de IA Responsável"@pt ;
    dcterms:isPartOf pbia:Prog5A_RegulatoryFrameworkImprovement ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "500000"^^xsd:decimal ; schema:currency "BRL" ] ;
    schema:funder pbia:SH_MJSP ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Annex2 ;
    rdfs:comment "Metas: Guia para IA Ética e Responsável em 3 meses; Guia de IA para o Setor Público em 6 meses; workshops periódicos. Instrumento de orientação (soft law), não vinculante."@pt .

pbia:Action51_AlgorithmicTransparencyCentre
    a hrai:PolicyInstrument ;
    rdfs:label "Ação 51 — Centro Nacional de Transparência Algorítmica e IA Confiável"@pt ;
    dcterms:isPartOf pbia:Prog5A_RegulatoryFrameworkImprovement ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "40000000"^^xsd:decimal ; schema:currency "BRL" ] ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Annex2 ;
    rdfs:comment "Metas: estabelecimento do Centro em até 120 dias; estudo sobre riscos da IA e transparência algorítmica 6 meses após criação. Fonte: FNDCT não reembolsável."@pt .

pbia:Action52_BrazilianAIObservatory
    a hrai:PolicyInstrument ;
    rdfs:label "Ação 52 — Observatório Brasileiro de IA (Obia)"@pt ;
    dcterms:isPartOf pbia:Prog5B_AIGovernanceSupport ;
    schema:amount [ a schema:MonetaryAmount ; schema:value "11750000"^^xsd:decimal ; schema:currency "BRL" ] ;
    schema:funder pbia:SH_CGIbr ;
    prov:wasDerivedFrom pbia:Evidence_PBIA_Annex2 ;
    rdfs:comment "Metas: lançamento em 30 dias; desenvolvimento contínuo de indicadores nas principais dimensões da IA. Fonte: FNDCT não reembolsável e CGI.br."@pt .

pbia:Action53_AIGovernanceSupportNetwork
    a hrai:PolicyInstrument ;
