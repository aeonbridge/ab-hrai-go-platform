  <hrai:RiskExposureIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Exp_HealthDataSUS">
    <rdfs:label xml:lang="pt">Volume de dados de saúde sob guarda do SUS (exposição de dados sensíveis em uso estatal)</rdfs:label>
    <hrai:hasIndicatorMethod>qualitativo: o PBIA descreve o SUS como um dos maiores sistemas públicos de saúde, com grande volume de dados; sem valor numérico na fonte</hrai:hasIndicatorMethod>
    <hrai:baseYear>não informado na fonte</hrai:baseYear>
    <hrai:exposureConcernsFunction>
      <hrai:SubstantiveArea rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#Area_DataGovernance"/>
    </hrai:exposureConcernsFunction>
    <hrai:indicatorRelevantToJurisdiction>
      <hrai:Jurisdiction rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Brazil"/>
    </hrai:indicatorRelevantToJurisdiction>
    <hrai:indicatorSource>
      <hrai:SourceSnapshot rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
    </hrai:indicatorSource>
  </hrai:RiskExposureIndicator>
