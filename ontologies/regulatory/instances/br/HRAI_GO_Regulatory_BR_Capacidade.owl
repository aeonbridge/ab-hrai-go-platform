  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Ind_GovernanceBudgetShare">
    <rdfs:label xml:lang="pt">Parcela do PBIA destinada ao Eixo 5, Apoio ao Processo Regulatório e de Governança da IA</rdfs:label>
    <hrai:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.45</hrai:hasNumericValue>
    <hrai:numericUnit>percent</hrai:numericUnit>
    <hrai:baseYear>2024-2028</hrai:baseYear>
    <hrai:hasIndicatorMethod>R$ 103,25 milhões / R$ 23,03 bilhões (Tabela 2 do PBIA, investimentos previstos 2024-2028)</hrai:hasIndicatorMethod>
    <hrai:indicatorRelevantToJurisdiction rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Brazil"/>
    <hrai:indicatorSource rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
