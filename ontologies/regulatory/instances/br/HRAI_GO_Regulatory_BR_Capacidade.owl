    <rdfs:label xml:lang="pt">Investimento previsto no Eixo 5 do PBIA (governança e apoio regulatório)</rdfs:label>
    <hrai:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">103.25</hrai:hasNumericValue>
    <hrai:numericUnit>million BRL</hrai:numericUnit>
    <hrai:baseYear>2024-2028</hrai:baseYear>
    <hrai:indicatorRelevantToJurisdiction rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Brazil"/>
