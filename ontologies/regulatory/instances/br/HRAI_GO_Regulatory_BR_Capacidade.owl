  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_CompaniesUsingAI">
    <hrai:baseYear>não informado na fonte</hrai:baseYear>
  </hrai:ContextIndicator>
  <hrai:ExtractionBatch rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Lote_Capacidade">
    <rdfs:label xml:lang="pt">Lote: capacidade e exposição do Brasil (RF-07)</rdfs:label>
    <hrai:extractionContainsCandidate>
      <hrai:CandidateAssertion rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Candidate_Indicadores">
        <rdfs:label xml:lang="pt">Candidato: indicadores de capacidade e exposição e anos-base do PBIA</rdfs:label>
        <hrai:candidateFromSnapshot rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
        <hrai:candidateProducedBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#ExtratorSessao"/>
      </hrai:CandidateAssertion>
    </hrai:extractionContainsCandidate>
    <hrai:extractionContainsCandidate>
      <hrai:CandidateAssertion rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Candidate_Requisitos">
        <rdfs:label xml:lang="pt">Candidato: requisitos do PL que pressupõem capacidade (arts. 25, 34 e 49 do texto do Senado)</rdfs:label>
        <hrai:candidateFromSnapshot rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pl2338#Snapshot_2024"/>
        <hrai:candidateProducedBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#ExtratorSessao"/>
      </hrai:CandidateAssertion>
    </hrai:extractionContainsCandidate>
  </hrai:ExtractionBatch>
  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_RenewableShareElectricityMatrix2023">
    <hrai:baseYear>2023</hrai:baseYear>
  </hrai:ContextIndicator>
  <hrai:NormativeRequirement rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Req_AlgorithmicImpactAssessment">
    <rdfs:label xml:lang="pt">Avaliação de impacto algorítmico de sistemas de alto risco (art. 25)</rdfs:label>
    <hrai:derivedFromProvision>
      <hrai:LegalProvision rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pl2338#Art_2024_025"/>
    </hrai:derivedFromProvision>
    <hrai:requirementAssumesCapacity>
      <hrai:CapacityRequirement rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Cap_TechnicalWorkforce">
        <rdfs:label xml:lang="pt">Profissionais técnicos para avaliar e auditar sistemas de IA</rdfs:label>
        <hrai:capacityMeasuredBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_ICTTalentDeficit2021_2025"/>
        <hrai:capacityMeasuredBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_STEMGraduatesShare"/>
      </hrai:CapacityRequirement>
    </hrai:requirementAssumesCapacity>
  </hrai:NormativeRequirement>
  <hrai:NormativeRequirement rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Req_ConformityAccreditation">
    <rdfs:label xml:lang="pt">Acreditação de organismos de avaliação de conformidade (art. 34)</rdfs:label>
    <hrai:derivedFromProvision>
      <hrai:LegalProvision rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pl2338#Art_2024_034"/>
    </hrai:derivedFromProvision>
    <hrai:requirementAssumesCapacity rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Cap_TechnicalWorkforce"/>
    <hrai:requirementAssumesCapacity>
      <hrai:CapacityRequirement rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Cap_SupervisionBudget">
        <rdfs:label xml:lang="pt">Orçamento para supervisão e governança da IA</rdfs:label>
        <hrai:capacityMeasuredBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Ind_GovernanceBudgetShare"/>
        <hrai:capacityMeasuredBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#Ind_GovernanceBudgetAmount"/>
      </hrai:CapacityRequirement>
    </hrai:requirementAssumesCapacity>
  </hrai:NormativeRequirement>
