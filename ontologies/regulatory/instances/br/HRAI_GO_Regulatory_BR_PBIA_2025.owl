        <rdfs:label xml:lang="pt">Posicionar o Brasil na vanguarda tecnológica com infraestrutura computacional para IA</rdfs:label>
      </hrai:PolicyObjective>
    </hrai:tensionInvolvesObjective>
    <hrai:hasPolicyClaim>
      <hrai:PolicyClaim rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_TalentMigrationContradiction">
        <rdfs:label xml:lang="pt">A migração de talentos para a indústria é desejável e preocupante ao mesmo tempo</rdfs:label>
        <hrai:claimText xml:lang="pt">A migração de talentos da academia para a indústria é desejável do ponto de vista da competitividade, mas pode ameaçar a capacidade da academia de inovar e formar a próxima geração de pesquisadores.</hrai:claimText>
        <hrai:claimSupportedByEvidence rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec1"/>
      </hrai:PolicyClaim>
    </hrai:hasPolicyClaim>
    <prov:wasDerivedFrom rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec1"/>
  </hrai:RegulatoryTension>
