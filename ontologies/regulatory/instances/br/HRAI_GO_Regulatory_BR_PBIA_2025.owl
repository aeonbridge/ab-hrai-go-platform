  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_SinapadComputePower">
    <rdfs:label xml:lang="pt">Poder computacional total do Sinapad</rdfs:label>
    <hrai:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.2</hrai:hasNumericValue>
    <hrai:numericUnit>PFlop/s</hrai:numericUnit>
    <hrai:hasIndicatorMethod xml:lang="pt">PBIA, Eixo 1, p. 34 (valor aproximado).</hrai:hasIndicatorMethod>
    <hrai:indicatorMeasuredFor>
      <hrai:NationalContext rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#BrazilAIContext_PBIA">
        <rdfs:label xml:lang="pt">Contexto nacional de IA no Brasil segundo o PBIA (diagnósticos 'Onde estamos?')</rdfs:label>
        <hrai:contextOfJurisdiction rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Brazil"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
        <rdfs:comment xml:lang="pt">Vantagens: matriz elétrica limpa, SUS e bases de dados nacionais, população jovem com rápida adoção tecnológica, centros de pesquisa. Desafios: P&amp;D insuficiente, infraestrutura computacional e de dados limitada, escassez de profissionais e fuga de cérebros, dependência externa de hardware, desigualdade educacional.</rdfs:comment>
      </hrai:NationalContext>
    </hrai:indicatorMeasuredFor>
    <hrai:indicatorMeasuresDimension>
      <hrai:ContextDimension rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Dim_ComputeInfrastructure">
        <rdfs:label xml:lang="pt">Infraestrutura computacional</rdfs:label>
      </hrai:ContextDimension>
    </hrai:indicatorMeasuresDimension>
    <hrai:indicatorSource>
      <hrai:SourceSnapshot rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8">
        <rdfs:label xml:lang="pt">PBIA — versão VN 8 (edição para o período de defeso eleitoral), PDF 108 páginas</rdfs:label>
        <hrai:snapshotOfSource rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Source_PBIA"/>
        <hrai:snapshotURI rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/aeonbridge/ab-hrai-go-platform/blob/main/docs/ai-regulations/br/000149%20-%20CGEE%20Plano%20Brasileiro%20de%20Intelig%C3%AAncia%20Artificial%20(VN)%208%20Defeso%20Eleitoral.pdf</hrai:snapshotURI>
        <hrai:snapshotSHA256>b654240701e7be87578e6dc505244366d35b8cadeeb01727ae12b091ef3e46f5</hrai:snapshotSHA256>
        <hrai:sourcePublishedAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-17T10:42:03-03:00</hrai:sourcePublishedAt>
        <hrai:sourceCapturedAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-11T23:02:00-03:00</hrai:sourceCapturedAt>
        <rdfs:comment xml:lang="pt">sourcePublishedAt corresponde ao CreationDate do PDF (Adobe InDesign). A ficha catalográfica do documento indica ano de publicação 2025.</rdfs:comment>
      </hrai:SourceSnapshot>
    </hrai:indicatorSource>
  </hrai:ContextIndicator>
  <hrai:Stakeholder rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_Andifes">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <rdfs:label xml:lang="pt">Associação Nacional dos Dirigentes das Instituições Federais de Ensino Superior (Andifes)</rdfs:label>
    <schema:memberOf>
      <hrai:Stakeholder rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_CCT">
        <rdf:type rdf:resource="https://schema.org/GovernmentOrganization"/>
        <rdfs:label xml:lang="pt">Conselho Nacional de Ciência e Tecnologia (CCT)</rdfs:label>
        <rdfs:comment xml:lang="pt">Orientação estratégica do PBIA. Composição (I) ministros de Estado, (II) representantes dos produtores e usuários de C&amp;T — pessoas físicas, não instanciadas — e (III) entidades de ensino, pesquisa, ciência e tecnologia.</rdfs:comment>
      </hrai:Stakeholder>
    </schema:memberOf>
  </hrai:Stakeholder>
