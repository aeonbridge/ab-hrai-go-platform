  <hrai:PolicyClaim rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_SovereigntyCooperationBalance">
    <rdfs:label xml:lang="pt">É preciso equilibrar proteção dos interesses nacionais e colaborações internacionais mutuamente benéficas</rdfs:label>
    <hrai:claimText xml:lang="pt">Deve-se buscar um equilíbrio entre a proteção dos interesses nacionais e a participação em colaborações internacionais mutuamente benéficas, com atenção a países da África e da América Latina.</hrai:claimText>
    <hrai:claimSupportedByEvidence rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec2"/>
  </hrai:PolicyClaim>
