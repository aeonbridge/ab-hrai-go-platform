  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_StartupFunding2019_2023">
    <rdfs:label xml:lang="pt">Capital levantado por startups brasileiras (2019-2023)</rdfs:label>
    <hrai:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">17.6</hrai:hasNumericValue>
    <hrai:numericUnit>billion USD</hrai:numericUnit>
    <hrai:hasIndicatorMethod xml:lang="pt">Google for Startups (2024), citado no PBIA, p. 41. O Brasil abriga 30% das startups Deep Tech da América Latina e Caribe; IA representa 16% delas.</hrai:hasIndicatorMethod>
    <hrai:indicatorMeasuredFor rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#BrazilAIContext_PBIA"/>
    <hrai:indicatorMeasuresDimension>
      <hrai:ContextDimension rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Dim_BusinessAdoption">
        <rdfs:label xml:lang="pt">Adoção de IA e inovação empresarial</rdfs:label>
      </hrai:ContextDimension>
    </hrai:indicatorMeasuresDimension>
    <hrai:indicatorSource rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
  </hrai:ContextIndicator>
  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_OpenDataBases">
    <rdfs:label xml:lang="pt">Bases abertas no Portal Brasileiro de Dados Abertos</rdfs:label>
    <hrai:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">13000</hrai:hasNumericValue>
    <hrai:numericUnit>datasets (lower bound)</hrai:numericUnit>
    <hrai:hasIndicatorMethod xml:lang="pt">Brasil (2025), citado no PBIA, p. 34: mais de 13 mil bases de 264 organizações.</hrai:hasIndicatorMethod>
    <hrai:indicatorMeasuredFor rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#BrazilAIContext_PBIA"/>
    <hrai:indicatorMeasuresDimension>
      <hrai:ContextDimension rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Dim_DataEcosystem">
        <rdfs:label xml:lang="pt">Ecossistema de dados</rdfs:label>
      </hrai:ContextDimension>
    </hrai:indicatorMeasuresDimension>
    <hrai:indicatorSource rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
  </hrai:ContextIndicator>
  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_PegasoSupercomputerPerformance">
    <rdfs:label xml:lang="pt">Desempenho do supercomputador Pégaso (Petrobras)</rdfs:label>
    <hrai:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">42</hrai:hasNumericValue>
    <hrai:numericUnit>PFlop/s</hrai:numericUnit>
    <hrai:hasIndicatorMethod xml:lang="pt">TOP500 (2024), citado no PBIA, p. 34: mais potente da América Latina, 56º no ranking mundial.</hrai:hasIndicatorMethod>
    <hrai:indicatorMeasuredFor rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#BrazilAIContext_PBIA"/>
    <hrai:indicatorMeasuresDimension rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Dim_ComputeInfrastructure"/>
    <hrai:indicatorSource rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
  </hrai:ContextIndicator>
  <hrai:ContextIndicator rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Ind_RenewableShareEnergyMatrix_Axis4">
    <rdfs:label xml:lang="pt">Participação de fontes renováveis na 'matriz energética' citada no Eixo 4</rdfs:label>
    <hrai:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">83</hrai:hasNumericValue>
    <hrai:numericUnit>percent</hrai:numericUnit>
    <hrai:hasIndicatorMethod xml:lang="pt">PBIA, Eixo 4 'Onde estamos?', p. 41; ano e fonte primária não informados.</hrai:hasIndicatorMethod>
    <hrai:indicatorMeasuredFor rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#BrazilAIContext_PBIA"/>
    <hrai:indicatorMeasuresDimension>
      <hrai:ContextDimension rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Dim_EnergySustainability">
        <rdfs:label xml:lang="pt">Energia e sustentabilidade</rdfs:label>
      </hrai:ContextDimension>
    </hrai:indicatorMeasuresDimension>
    <hrai:indicatorSource rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Snapshot_PBIA_VN8"/>
    <rdfs:comment xml:lang="pt">Atenção à curadoria: valor diverge dos 89,2% (matriz elétrica, 2023) do Eixo 1. Pode ser outro ano ou outro recorte; requer verificação na fonte primária antes de uso analítico.</rdfs:comment>
  </hrai:ContextIndicator>
