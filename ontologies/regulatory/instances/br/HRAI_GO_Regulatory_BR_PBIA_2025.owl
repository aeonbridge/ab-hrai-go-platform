  <hrai:PolicyClaim rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_CleanMatrixCompetitiveAdvantage">
    <rdfs:label xml:lang="pt">A matriz elétrica limpa é vantagem competitiva para IA sustentável</rdfs:label>
    <hrai:claimText xml:lang="pt">A matriz elétrica predominantemente limpa e renovável do Brasil é um diferencial estratégico para o desenvolvimento de uma IA sustentável.</hrai:claimText>
    <hrai:claimSupportedByEvidence rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec3"/>
  </hrai:PolicyClaim>
  <hrai:ContextDimension rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Dim_PublicSectorAdoption">
    <rdfs:label xml:lang="pt">Adoção de IA no setor público</rdfs:label>
  </hrai:ContextDimension>
  <hrai:PolicyClaim rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_AIThreatensEmployment">
    <rdfs:label xml:lang="pt">A IA desafia estruturas tradicionais de emprego e suscita receio de desemprego tecnológico</rdfs:label>
    <hrai:claimText xml:lang="pt">Na educação e no trabalho, a IA desafia estruturas tradicionais de emprego, exigindo adaptação e requalificação; revoluções tecnológicas suscitam preocupações com o desemprego tecnológico.</hrai:claimText>
    <hrai:claimSupportedByEvidence rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec1"/>
    <hrai:challengedByClaim>
      <hrai:PolicyClaim rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_HistoricalAdaptationBenefits">
        <rdfs:label xml:lang="pt">A trajetória histórica sugere adaptação das sociedades e benefícios econômicos após a apreensão inicial</rdfs:label>
        <hrai:claimText xml:lang="pt">Após um período inicial de apreensão, as sociedades tendem a se adaptar às novas tecnologias, frequentemente resultando em benefícios econômicos e sociais abrangentes; a transição, porém, raramente é uniforme.</hrai:claimText>
        <hrai:claimSupportedByEvidence rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec1"/>
      </hrai:PolicyClaim>
    </hrai:challengedByClaim>
  </hrai:PolicyClaim>
  <hrai:PolicyClaim rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_AIIsNotPanacea">
    <rdfs:label xml:lang="pt">A IA não é solução universal; o sucesso do PBIA depende de ações complementares</rdfs:label>
    <hrai:claimText xml:lang="pt">A IA é uma ferramenta estratégica para gargalos específicos; o sucesso do PBIA depende de ações complementares em educação, infraestrutura digital e redução de disparidades regionais.</hrai:claimText>
    <hrai:claimSupportedByEvidence rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec3"/>
  </hrai:PolicyClaim>
  <hrai:Stakeholder rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_Enap">
    <rdf:type rdf:resource="https://schema.org/EducationalOrganization"/>
    <rdfs:label xml:lang="pt">Escola Nacional de Administração Pública (Enap)</rdfs:label>
  </hrai:Stakeholder>
  <hrai:Stakeholder rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_MEC">
    <rdf:type rdf:resource="https://schema.org/GovernmentOrganization"/>
    <rdfs:label xml:lang="pt">Ministério da Educação (MEC)</rdfs:label>
    <schema:memberOf rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_CCT"/>
  </hrai:Stakeholder>
  <hrai:PolicyClaim rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_DataCentreGridOverloadRisk">
    <rdfs:label xml:lang="pt">Novos supercomputadores e data centers podem sobrecarregar o sistema elétrico nacional</rdfs:label>
    <hrai:claimText xml:lang="pt">O crescimento previsto de supercomputadores e data centers representa um desafio potencial de sobrecarga ao sistema elétrico nacional, exigindo planejamento e investimentos em eficiência energética.</hrai:claimText>
    <hrai:claimSupportedByEvidence rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Evidence_PBIA_Sec3"/>
  </hrai:PolicyClaim>
  <hrai:EnactedLegalInstrument rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Law_13709_2018_LGPD">
    <rdfs:label xml:lang="pt">Lei 13.709/2018 — Lei Geral de Proteção de Dados Pessoais (LGPD)</rdfs:label>
    <hrai:instrumentIdentifier>Lei 13.709/2018</hrai:instrumentIdentifier>
    <hrai:instrumentInJurisdiction rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Brazil"/>
    <rdfs:comment xml:lang="pt">Citada pelo PBIA (premissa 08 e Eixo 5) como parâmetro de tratamento de dados pessoais. Número da lei não aparece no texto do PBIA; identificação pela sigla LGPD.</rdfs:comment>
  </hrai:EnactedLegalInstrument>
  <hrai:LegalSource rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Source_PBIA">
    <rdfs:label xml:lang="pt">Publicação MCTI/CGEE — Plano Brasileiro de Inteligência Artificial</rdfs:label>
    <hrai:sourceURI rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">urn:isbn:978-65-5775-097-1</hrai:sourceURI>
