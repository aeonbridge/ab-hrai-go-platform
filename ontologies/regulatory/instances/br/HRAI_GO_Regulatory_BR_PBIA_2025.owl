    <rdfs:label xml:lang="pt">Processo de elaboração participativa do PBIA (2024)</rdfs:label>
    <hrai:deliberationIncludesPosition>
      <hrai:StakeholderPosition rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Pos_Presidency_AIForGood">
        <rdfs:label xml:lang="pt">Presidência: IA 'do bem', ética e não discriminatória</rdfs:label>
        <hrai:positionExpressedBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_PresidencyOfTheRepublic"/>
        <hrai:positionText xml:lang="pt">Necessidade de desenvolver e adotar tecnologia que melhore a vida do cidadão, pautada por princípios éticos e não discriminatórios; IA para saúde, para os pobres e para a descarbonização, e não para disseminar fake news (demanda ao CCT em 2024-03-07).</hrai:positionText>
        <hrai:positionSupportsClaim rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_AgileRegulationWithoutInhibitingInnovation"/>
      </hrai:StakeholderPosition>
    </hrai:deliberationIncludesPosition>
    <hrai:deliberationIncludesPosition>
      <hrai:StakeholderPosition rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Pos_MCTI_SovereignAI">
        <rdfs:label xml:lang="pt">MCTI: desenvolver IA no Brasil, com soberania e inclusão</rdfs:label>
        <hrai:positionExpressedBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_MCTI"/>
        <hrai:positionText xml:lang="pt">Não importar simplesmente soluções, mas desenvolvê-las no Brasil, por brasileiros e para brasileiros; nuvem soberana para proteger dados estratégicos; ênfase em capacitação diante de impactos no trabalho (Apresentação).</hrai:positionText>
        <hrai:positionSupportsClaim rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_SovereigntyCooperationBalance"/>
        <hrai:positionSupportsClaim rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_HistoricalAdaptationBenefits"/>
      </hrai:StakeholderPosition>
    </hrai:deliberationIncludesPosition>
    <hrai:deliberationIncludesPosition>
      <hrai:StakeholderPosition rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Pos_ABC_EducationalInequality">
        <rdfs:label xml:lang="pt">ABC: contexto educacional crítico e lacuna entre excelência acadêmica e implementação</rdfs:label>
        <hrai:positionExpressedBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_ABC"/>
        <hrai:positionText xml:lang="pt">Apenas pequena parcela da população tem acesso à educação de qualidade; sem investimentos e políticas eficazes, o País corre risco de declínio tecnológico acelerado (ABC, 2023, citado no PBIA).</hrai:positionText>
        <hrai:positionSupportsClaim rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_AIIsNotPanacea"/>
      </hrai:StakeholderPosition>
    </hrai:deliberationIncludesPosition>
    <hrai:deliberationIncludesPosition>
      <hrai:StakeholderPosition rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Pos_CNI_ProductivityDecline">
        <rdfs:label xml:lang="pt">CNI: queda de produtividade industrial motiva adoção de IA</rdfs:label>
        <hrai:positionExpressedBy rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#SH_CNI"/>
        <hrai:positionText xml:lang="pt">Queda de 24% na produtividade do trabalho na indústria de transformação entre 2001 e 2021 (CNI, 2022, citado no PBIA).</hrai:positionText>
        <hrai:positionSupportsClaim rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Claim_HistoricalAdaptationBenefits"/>
      </hrai:StakeholderPosition>
    </hrai:deliberationIncludesPosition>
