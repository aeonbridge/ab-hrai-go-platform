    <rdfs:label xml:lang="pt">Migração de talentos da academia para a indústria: competitividade versus capacidade de pesquisa e formação</rdfs:label>
    <hrai:tensionInJurisdiction rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#Brazil"/>
