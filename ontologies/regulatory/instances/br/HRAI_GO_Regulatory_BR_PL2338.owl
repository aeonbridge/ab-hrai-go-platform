  <hrai:LegalProvision rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pl2338#Art_2023_045">
    <rdfs:label xml:lang="pt">Art. 45 · Esta Lei entra em vigor um ano após a sua publicação.</rdfs:label>
    <dcterms:description xml:lang="pt">Esta Lei entra em vigor um ano após a sua publicação.</dcterms:description>
    <skos:notation>45</skos:notation>
    <skos:scopeNote xml:lang="pt">Capítulo IX · DAS DISPOSIÇÕES FINAIS</skos:scopeNote>
    <hrai:legalCitation>PL 2338/2023 (texto inicial, 2023), art. 45</hrai:legalCitation>
