us:Fonte_AIRMF a hrai:LegalSource ;
    rdfs:label "National Institute of Standards and Technology" ;
    hrai:sourceURI "https://doi.org/10.6028/NIST.AI.100-1"^^xsd:anyURI .

us:Function_Govern a hrai:PolicyInstrument ;
    rdfs:label "GOVERN"@en ;
    dcterms:description "GOVERN is a cross-cutting function that is infused throughout AI risk management and enables the other functions of the process. Aspects of GOVERN, especially those related to compliance or evaluation, should be integrated into each of the other functions."@en ;
    dcterms:isPartOf us:AIRMF_1_0 ;
    skos:closeMatch <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#NIST_Govern> ;
    prov:wasDerivedFrom us:Snapshot_AIRMF ;
    hrai:policyInstrumentInJurisdiction us:UnitedStates .

us:Function_Manage a hrai:PolicyInstrument ;
    rdfs:label "MANAGE"@en ;
    dcterms:description "The MANAGE function entails allocating risk resources to mapped and measured risks on a regular basis and as defined by the GOVERN function. Risk treatment comprises plans to respond to, recover from, and communicate about incidents or events."@en ;
    dcterms:isPartOf us:AIRMF_1_0 ;
    skos:closeMatch <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#NIST_Manage> ;
    prov:wasDerivedFrom us:Snapshot_AIRMF ;
    hrai:policyInstrumentInJurisdiction us:UnitedStates .

us:Function_Map a hrai:PolicyInstrument ;
    rdfs:label "MAP"@en ;
    dcterms:description "The MAP function establishes the context to frame risks related to an AI system. The AI lifecycle consists of many interdependent activities involving a diverse set of actors (See Figure 3)."@en ;
    dcterms:isPartOf us:AIRMF_1_0 ;
    skos:closeMatch <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#NIST_Map> ;
    prov:wasDerivedFrom us:Snapshot_AIRMF ;
    hrai:policyInstrumentInJurisdiction us:UnitedStates .

us:Function_Measure a hrai:PolicyInstrument ;
    rdfs:label "MEASURE"@en ;
    dcterms:description "The MEASURE function employs quantitative, qualitative, or mixed-method tools, techniques, and methodologies to analyze, assess, benchmark, and monitor AI risk and related impacts. It uses knowledge relevant to AI risks identified in the MAP function and informs the MANAGE function."@en ;
    dcterms:isPartOf us:AIRMF_1_0 ;
    skos:closeMatch <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#NIST_Measure> ;
    prov:wasDerivedFrom us:Snapshot_AIRMF ;
    hrai:policyInstrumentInJurisdiction us:UnitedStates .

us:AIRMF_1_0 a hrai:PolicyInstrument ;
    rdfs:label "NIST AI Risk Management Framework (AI RMF 1.0)"@en ;
    skos:scopeNote "Guia voluntário (E1).  The Framework is intended to be voluntary, rights-preserving, non-sector-specific, and use-case agnostic, providing flexibility to organizations of all sizes and in all sectors and throughout society to implement the approaches in the Framework."@en ;
    prov:wasDerivedFrom us:Snapshot_AIRMF ;
    hrai:policyInstrumentInJurisdiction us:UnitedStates .

us:ExtratorDeTexto a hrai:MonitoringAgent ;
    rdfs:label "Extrator de texto (scripts/ontologia/extrair_internacional.py, determinístico)"@pt .

us:UnitedStates a hrai:Jurisdiction ;
    rdfs:label "Estados Unidos da América"@pt .

us:Snapshot_AIRMF a hrai:SourceSnapshot ;
    rdfs:label "NIST AI 100-1, Artificial Intelligence Risk Management Framework (AI RMF 1.0), January 2023" ;
