  <owl:Ontology rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper">
    <rdfs:label xml:lang="pt">Reino Unido: white paper 'A pro-innovation approach to AI regulation' e os cinco princípios</rdfs:label>
    <rdfs:comment xml:lang="pt">Gerado por scripts/ontologia/extrair_internacional.py (pdftotext + expressões regulares, sem LLM). Candidato pendente de revisão humana. Método: METODO_EXTRACAO.md.</rdfs:comment>
  </owl:Ontology>
  <hrai:PolicyInstrument rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Principio_1">
    <rdfs:label xml:lang="en">Safety, security and robustness</rdfs:label>
    <dcterms:description xml:lang="en">AI systems should function in a robust, secure and safe way throughout the AI life cycle, and risks should be continually identified, assessed and managed.</dcterms:description>
    <dcterms:isPartOf>
      <hrai:PolicyInstrument rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#WhitePaper2023">
        <rdfs:label xml:lang="en">A pro-innovation approach to AI regulation (white paper, 2023)</rdfs:label>
        <dcterms:references rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Snapshot_ImpactAssessment"/>
        <skos:scopeNote xml:lang="en">Princípios não estatutários (E1): We will not put these principles on a statutory footing initially. New rigid and onerous legislative requirements on businesses could hold back AI innovation and reduce our ability to respond quickly and in a proportionate way to future technological advances.</skos:scopeNote>
        <prov:wasDerivedFrom rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Snapshot_WhitePaper"/>
        <hrai:policyInstrumentInJurisdiction rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#UnitedKingdom"/>
      </hrai:PolicyInstrument>
    </dcterms:isPartOf>
    <skos:notation>1</skos:notation>
    <prov:wasDerivedFrom>
      <hrai:SourceSnapshot rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Snapshot_WhitePaper">
        <rdfs:label>A pro-innovation approach to AI regulation (white paper, March 2023, amended web version)</rdfs:label>
        <hrai:snapshotOfSource rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Fonte_WhitePaper"/>
        <hrai:snapshotSHA256>79d0b329134c14d0977e9819154ba1e55108b9a7d1c8890d93e6406f2ce0d9c7</hrai:snapshotSHA256>
        <hrai:snapshotURI rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/aeonbridge/ab-hrai-go-platform/blob/main/docs/ai-regulations/uk/a-pro-innovation-approach-to-ai-regulation-amended-web-ready.pdf</hrai:snapshotURI>
      </hrai:SourceSnapshot>
    </prov:wasDerivedFrom>
    <hrai:policyInstrumentInJurisdiction>
      <hrai:Jurisdiction rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#UnitedKingdom">
        <rdfs:label xml:lang="pt">Reino Unido</rdfs:label>
      </hrai:Jurisdiction>
    </hrai:policyInstrumentInJurisdiction>
  </hrai:PolicyInstrument>
  <hrai:PolicyInstrument rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Principio_4">
    <rdfs:label xml:lang="en">Accountability and governance</rdfs:label>
    <dcterms:description xml:lang="en">Governance measures should be in place to ensure effective oversight of the supply and use of AI systems, with clear lines of accountability established across the AI life cycle.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#WhitePaper2023"/>
    <skos:notation>4</skos:notation>
    <prov:wasDerivedFrom rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Snapshot_WhitePaper"/>
    <hrai:policyInstrumentInJurisdiction rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#UnitedKingdom"/>
  </hrai:PolicyInstrument>
  <hrai:SourceSnapshot rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Snapshot_ImpactAssessment">
    <rdfs:label>UK Artificial Intelligence Regulation Impact Assessment (2023)</rdfs:label>
    <hrai:snapshotOfSource>
      <hrai:LegalSource rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Fonte_ImpactAssessment">
        <rdfs:label>UK Department for Science, Innovation and Technology</rdfs:label>
