    <hrai:sourceURI rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.gov.uk/government/publications/ai-regulation-a-pro-innovation-approach</hrai:sourceURI>
  </hrai:LegalSource>
  <hrai:PolicyInstrument rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Principio_2">
    <rdfs:label xml:lang="en">Appropriate transparency and explainability</rdfs:label>
    <dcterms:description xml:lang="en">AI systems should be appropriately transparent and explainable.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#WhitePaper2023"/>
