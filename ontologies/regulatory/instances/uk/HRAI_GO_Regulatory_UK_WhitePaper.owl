      </hrai:LegalSource>
    </hrai:snapshotOfSource>
    <hrai:snapshotSHA256>c60009d0546482b80d2dbff1e667ca52953e8bc3767346b6db0ff08d4761f049</hrai:snapshotSHA256>
    <hrai:snapshotURI rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/aeonbridge/ab-hrai-go-platform/blob/main/docs/ai-regulations/uk/uk_ai_regulation_impact_assessment.pdf</hrai:snapshotURI>
  </hrai:SourceSnapshot>
  <hrai:PolicyInstrument rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Principio_5">
    <rdfs:label xml:lang="en">Contestability and redress</rdfs:label>
    <dcterms:description xml:lang="en">Where appropriate, users, impacted third parties and actors in the AI life cycle should be able to contest an AI decision or outcome that is harmful or creates material risk of harm.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#WhitePaper2023"/>
    <skos:notation>5</skos:notation>
    <prov:wasDerivedFrom rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Snapshot_WhitePaper"/>
    <hrai:policyInstrumentInJurisdiction rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#UnitedKingdom"/>
  </hrai:PolicyInstrument>
  <hrai:PolicyInstrument rdf:about="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Principio_3">
    <rdfs:label xml:lang="en">Fairness</rdfs:label>
    <dcterms:description xml:lang="en">AI systems should not undermine the legal rights of individuals or organisations, discriminate unfairly against individuals or create unfair market outcomes.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#WhitePaper2023"/>
    <skos:notation>3</skos:notation>
    <prov:wasDerivedFrom rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#Snapshot_WhitePaper"/>
    <hrai:policyInstrumentInJurisdiction rdf:resource="https://hrai-go.aeonbridge.io/data/regulatory/uk/whitepaper#UnitedKingdom"/>
  </hrai:PolicyInstrument>
