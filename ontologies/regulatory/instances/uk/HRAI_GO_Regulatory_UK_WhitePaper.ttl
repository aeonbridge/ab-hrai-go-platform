uk:UnitedKingdom a hrai:Jurisdiction ;
    rdfs:label "Reino Unido"@pt .

uk:WhitePaper2023 a hrai:PolicyInstrument ;
    rdfs:label "A pro-innovation approach to AI regulation (white paper, 2023)"@en ;
    dcterms:references uk:Snapshot_ImpactAssessment ;
    skos:scopeNote "Princípios não estatutários (E1): We will not put these principles on a statutory footing initially. New rigid and onerous legislative requirements on businesses could hold back AI innovation and reduce our ability to respond quickly and in a proportionate way to future technological advances."@en ;
    prov:wasDerivedFrom uk:Snapshot_WhitePaper ;
    hrai:policyInstrumentInJurisdiction uk:UnitedKingdom .

