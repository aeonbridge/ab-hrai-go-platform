uk:Fonte_ImpactAssessment a hrai:LegalSource ;
    rdfs:label "UK Department for Science, Innovation and Technology" ;
    hrai:sourceURI "https://www.gov.uk/government/publications/ai-regulation-a-pro-innovation-approach"^^xsd:anyURI .

uk:Fonte_WhitePaper a hrai:LegalSource ;
    rdfs:label "UK Department for Science, Innovation and Technology" ;
    hrai:sourceURI "https://www.gov.uk/government/publications/ai-regulation-a-pro-innovation-approach"^^xsd:anyURI .

uk:Principio_1 a hrai:PolicyInstrument ;
    rdfs:label "Safety, security and robustness"@en ;
    dcterms:description "AI systems should function in a robust, secure and safe way throughout the AI life cycle, and risks should be continually identified, assessed and managed."@en ;
    dcterms:isPartOf uk:WhitePaper2023 ;
    skos:notation "1" ;
    prov:wasDerivedFrom uk:Snapshot_WhitePaper ;
    hrai:policyInstrumentInJurisdiction uk:UnitedKingdom .

uk:Principio_2 a hrai:PolicyInstrument ;
    rdfs:label "Appropriate transparency and explainability"@en ;
    dcterms:description "AI systems should be appropriately transparent and explainable."@en ;
    dcterms:isPartOf uk:WhitePaper2023 ;
    skos:notation "2" ;
    prov:wasDerivedFrom uk:Snapshot_WhitePaper ;
    hrai:policyInstrumentInJurisdiction uk:UnitedKingdom .

uk:Principio_3 a hrai:PolicyInstrument ;
    rdfs:label "Fairness"@en ;
    dcterms:description "AI systems should not undermine the legal rights of individuals or organisations, discriminate unfairly against individuals or create unfair market outcomes."@en ;
    dcterms:isPartOf uk:WhitePaper2023 ;
    skos:notation "3" ;
    prov:wasDerivedFrom uk:Snapshot_WhitePaper ;
    hrai:policyInstrumentInJurisdiction uk:UnitedKingdom .

uk:Principio_4 a hrai:PolicyInstrument ;
    rdfs:label "Accountability and governance"@en ;
    dcterms:description "Governance measures should be in place to ensure effective oversight of the supply and use of AI systems, with clear lines of accountability established across the AI life cycle."@en ;
    dcterms:isPartOf uk:WhitePaper2023 ;
    skos:notation "4" ;
    prov:wasDerivedFrom uk:Snapshot_WhitePaper ;
    hrai:policyInstrumentInJurisdiction uk:UnitedKingdom .

uk:Principio_5 a hrai:PolicyInstrument ;
    rdfs:label "Contestability and redress"@en ;
    dcterms:description "Where appropriate, users, impacted third parties and actors in the AI life cycle should be able to contest an AI decision or outcome that is harmful or creates material risk of harm."@en ;
    dcterms:isPartOf uk:WhitePaper2023 ;
    skos:notation "5" ;
    prov:wasDerivedFrom uk:Snapshot_WhitePaper ;
    hrai:policyInstrumentInJurisdiction uk:UnitedKingdom .

uk:Snapshot_ImpactAssessment a hrai:SourceSnapshot ;
    rdfs:label "UK Artificial Intelligence Regulation Impact Assessment (2023)" ;
    hrai:snapshotOfSource uk:Fonte_ImpactAssessment ;
    hrai:snapshotSHA256 "c60009d0546482b80d2dbff1e667ca52953e8bc3767346b6db0ff08d4761f049" ;
    hrai:snapshotURI "https://github.com/aeonbridge/ab-hrai-go-platform/blob/main/docs/ai-regulations/uk/uk_ai_regulation_impact_assessment.pdf"^^xsd:anyURI .

