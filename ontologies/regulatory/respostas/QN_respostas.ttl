# Gerado por scripts/ontologia/responder_qn.py. Não editar à mão. Candidato pendente de decisão humana.
@prefix cap: <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/capacidade#> .
@prefix cor: <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/correspondencias/br-ue#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hrai: <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pbia: <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pbia#> .
@prefix pl: <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/br/pl2338#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix resp: <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/respostas#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cor:Corr_BR045_EU070 hrai:groundedInSpecificity resp:S7_SupervisaoPorSistema .

<https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/respostas> a owl:Ontology ;
    rdfs:label "Resposta inicial às perguntas norteadoras QN1, QN2 e QN3 (candidata)"@pt ;
    rdfs:comment "Gerado por scripts/ontologia/responder_qn.py. Detecção feita pela sessão do loop sobre o grafo (análise assistida por LLM), por falta de codificações aprovadas (D-02). Tudo pendente de decisão humana."@pt .

resp:A_EnergiaNoTextoDoSenado a hrai:PolicyClaim ;
    rdfs:label "A lacuna 'Energia e meio ambiente' da cúpula vem do modelo-semente; o texto do Senado trata o tema: eficiência energética de IA de propósito geral (art. 30), data centers sustentáveis (art. 59), uso eficiente de recursos (art. 60) e certificação ambiental com o Ministério do Meio Ambiente (art. 61)"@pt ;
    hrai:answerScope "modelo da câmara (documento-semente) frente ao texto do Senado de 2024; corrigir o modelo na revisão das sementes (D-07)"@pt ;
    hrai:answersGuidingQuestion "achado" ;
    hrai:claimSupportedByEvidence resp:Ev_A_EnergiaNoTextoDoSenado .

resp:Lote_Respostas a hrai:ExtractionBatch ;
    rdfs:label "Lote: resposta inicial às perguntas norteadoras"@pt ;
    hrai:extractionContainsCandidate resp:Candidate_Q2_AvaliacaoImpactoSemProfissionais,
        resp:Candidate_Q2_SupervisaoSemOrcamento,
        resp:Candidate_Q3_AutoridadeComOrcamentoProprio,
        resp:Candidate_Q3_DadosSUSTreinamento,
        resp:Candidate_S1_SoberaniaComputacional,
        resp:Candidate_S2_LinguaPortuguesa,
        resp:Candidate_S3_MatrizRenovavel,
        resp:Candidate_S4_OrcamentoGovernanca,
        resp:Candidate_S5_ProfissionaisTIC,
        resp:Candidate_S6_DadosSaudeSUS,
        resp:Candidate_S7_SupervisaoPorSistema,
        resp:Candidate_S8_ResponsabilidadeCivil .

cor:Corr_BR025_EU027 hrai:groundedInSpecificity resp:S5_ProfissionaisTIC .

resp:Candidate_Q2_AvaliacaoImpactoSemProfissionais a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN2: A avaliação de impacto algorítmico obrigatória (art. 25 do texto do Senado, adaptada do art. 27 do AI Act) pressupõe profissionais técnicos que o déficit estimado de TIC indica faltar"@pt ;
    dcterms:subject resp:Q2_AvaliacaoImpactoSemProfissionais ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_Q2_SupervisaoSemOrcamento a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN2: A supervisão, a fiscalização e a acreditação pela autoridade competente (arts. 34 e 49) pressupõem orçamento que o Eixo 5 do PBIA não prevê em escala"@pt ;
    dcterms:subject resp:Q2_SupervisaoSemOrcamento ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_Q3_AutoridadeComOrcamentoProprio a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN3: Fonte de financiamento própria e estável para o sistema de supervisão (SIA): o texto do Senado cria o sistema, mas nenhum artigo vincula orçamento a ele"@pt ;
    dcterms:subject resp:Q3_AutoridadeComOrcamentoProprio ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_Q3_DadosSUSTreinamento a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN3: Uso de dados públicos sensíveis, como os do SUS, para treinar modelos: o texto do Senado não tem regra específica; a escala desses dados pede salvaguarda própria"@pt ;
    dcterms:subject resp:Q3_DadosSUSTreinamento ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_S1_SoberaniaComputacional a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN1: Soberania computacional com orçamento público: Nuvem Soberana (R$ 1 bilhão) e supercomputador de IA no PBIA"@pt ;
    dcterms:subject resp:S1_SoberaniaComputacional ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_S2_LinguaPortuguesa a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN1: Modelos de linguagem em português com dados nacionais, para o português do Brasil em escala continental"@pt ;
    dcterms:subject resp:S2_LinguaPortuguesa ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_S3_MatrizRenovavel a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN1: Matriz elétrica majoritariamente renovável: 89,2% em 2023, segundo o PBIA (citando a EPE)"@pt ;
    dcterms:subject resp:S3_MatrizRenovavel ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_S4_OrcamentoGovernanca a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN1: Orçamento de governança pequeno: 0,45% do PBIA (R$ 103,25 milhões de R$ 23,03 bilhões) no Eixo 5"@pt ;
    dcterms:subject resp:S4_OrcamentoGovernanca ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_S5_ProfissionaisTIC a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN1: Déficit estimado de 530 mil profissionais de TIC entre 2021 e 2025, segundo o PBIA"@pt ;
    dcterms:subject resp:S5_ProfissionaisTIC ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_S6_DadosSaudeSUS a hrai:CandidateAssertion ;
