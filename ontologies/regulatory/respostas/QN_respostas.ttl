resp:Q2_AvaliacaoImpactoSemProfissionais a hrai:PolicyClaim ;
    rdfs:label "A avaliação de impacto algorítmico obrigatória (art. 25 do texto do Senado, adaptada do art. 27 do AI Act) pressupõe profissionais técnicos que o déficit estimado de TIC indica faltar"@pt ;
    hrai:answerScope "texto do Senado de 2024 e indicador do PBIA; sem limiar aprovado (D-09)"@pt ;
    hrai:answersGuidingQuestion "QN2" ;
    hrai:claimSupportedByEvidence resp:Ev_Q2_AvaliacaoImpactoSemProfissionais ;
    hrai:groundedInSpecificity resp:S5_ProfissionaisTIC .

resp:Q2_SupervisaoSemOrcamento a hrai:PolicyClaim ;
    rdfs:label "A supervisão, a fiscalização e a acreditação pela autoridade competente (arts. 34 e 49) pressupõem orçamento que o Eixo 5 do PBIA não prevê em escala"@pt ;
    hrai:answerScope "texto do Senado de 2024 e Tabela 2 do PBIA; sem limiar aprovado (D-09)"@pt ;
    hrai:answersGuidingQuestion "QN2" ;
    hrai:claimSupportedByEvidence resp:Ev_Q2_SupervisaoSemOrcamento ;
    hrai:groundedInSpecificity resp:S4_OrcamentoGovernanca,
        resp:S7_SupervisaoPorSistema .

resp:Q3_AutoridadeComOrcamentoProprio a hrai:PolicyClaim ;
    rdfs:label "Fonte de financiamento própria e estável para o sistema de supervisão (SIA): o texto do Senado cria o sistema, mas nenhum artigo vincula orçamento a ele"@pt ;
    hrai:answerScope "leitura dos arts. 45 a 49 do texto do Senado de 2024; sem avaliação de cobertura aprovada (D-10)"@pt ;
    hrai:answersGuidingQuestion "QN3" ;
    hrai:claimSupportedByEvidence resp:Ev_Q3_AutoridadeComOrcamentoProprio ;
    hrai:groundedInSpecificity resp:S4_OrcamentoGovernanca,
        resp:S7_SupervisaoPorSistema .

resp:Q3_DadosSUSTreinamento a hrai:PolicyClaim ;
    rdfs:label "Uso de dados públicos sensíveis, como os do SUS, para treinar modelos: o texto do Senado não tem regra específica; a escala desses dados pede salvaguarda própria"@pt ;
    hrai:answerScope "busca no texto do Senado de 2024: 'treinamento' aparece só em definições, IA de propósito geral, Cade e direitos autorais; sem avaliação de cobertura aprovada (D-10)"@pt ;
    hrai:answersGuidingQuestion "QN3" ;
    hrai:claimSupportedByEvidence resp:Ev_Q3_DadosSUSTreinamento ;
    hrai:groundedInSpecificity resp:S6_DadosSaudeSUS .

resp:S1_SoberaniaComputacional a hrai:NationalSpecificity ;
    rdfs:label "Soberania computacional com orçamento público: Nuvem Soberana (R$ 1 bilhão) e supercomputador de IA no PBIA"@pt ;
    hrai:answersGuidingQuestion "QN1" ;
    hrai:differenceType hrai:BrazilOnlyDifference ;
    hrai:specificityComparison resp:S1_SoberaniaComputacional_vs_EUA,
        resp:S1_SoberaniaComputacional_vs_ReinoUnido,
        resp:S1_SoberaniaComputacional_vs_UE ;
    hrai:specificityDimension hrai:StrategicObjectiveDimension ;
    hrai:specificityGroundedIn pbia:Action01_AISupercomputer,
        pbia:Action27_SovereignCloud .

