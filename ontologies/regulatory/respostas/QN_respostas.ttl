resp:Candidate_S7_SupervisaoPorSistema a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN1: Supervisão por um sistema que coordena reguladores existentes (SIA, coordenado pela ANPD), com orçamento de governança pequeno"@pt ;
    dcterms:subject resp:S7_SupervisaoPorSistema ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Candidate_S8_ResponsabilidadeCivil a hrai:CandidateAssertion ;
    rdfs:label "Candidato QN1: Responsabilidade civil por danos de IA pelas regras do Código de Defesa do Consumidor e do Código Civil, com inversão do ônus da prova"@pt ;
    dcterms:subject resp:S8_ResponsabilidadeCivil ;
    hrai:candidateProducedBy resp:SessaoLoop .

resp:Ev_A_EnergiaNoTextoDoSenado a hrai:Evidence ;
    rdfs:label "Evidência do grafo para A_EnergiaNoTextoDoSenado"@pt ;
    dcterms:references pl:Art_2024_030,
        pl:Art_2024_059,
        pl:Art_2024_060,
        pl:Art_2024_061,
        <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#Area_EnergyEnvironment> .

resp:Ev_Q2_AvaliacaoImpactoSemProfissionais a hrai:Evidence ;
    rdfs:label "Evidência do grafo para Q2_AvaliacaoImpactoSemProfissionais"@pt ;
    dcterms:references cap:Req_AlgorithmicImpactAssessment,
        cor:Corr_BR025_EU027 .

resp:Ev_Q2_SupervisaoSemOrcamento a hrai:Evidence ;
    rdfs:label "Evidência do grafo para Q2_SupervisaoSemOrcamento"@pt ;
