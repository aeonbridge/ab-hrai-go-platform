sem:Componente_GM_02 a owl:NamedIndividual,
        hrai:PolicyInstrument ;
    rdfs:label "Plano Brasileiro de IA (PBIA) 2024-2028"@pt ;
    dcterms:isPartOf pbia:PBIA_Plan ;
    dcterms:references <https://dplnews.com/um-ano-de-plano-brasileiro-de-inteligencia-artificial-o-que-esta-sendo-feito/>,
        <https://indico.rnp.br/event/155/contributions/1369/attachments/569/876/Plano_Brasileiro_de_IA.pdf> ;
    rdfs:comment "Plano com cerca de R$ 23 bi no período, de orçamento, FNDCT e contrapartidas privadas, organizado em cinco eixos: infraestrutura e desenvolvimento; difusão, formação e capacitação; IA no serviço público; inovação empresarial; apoio ao processo regulatório e de governança. Não substitui o marco legal."@pt ;
    skos:exactMatch pbia:PBIA_Plan ;
    skos:notation "GM-02" ;
    prov:wasDerivedFrom sem:Snapshot_ModeloCamara ;
    hrai:displayKey "components:GM-02" ;
