dec:D_04 a hrai:ApprovalDecision ;
    rdfs:label "D-04: Aprovar o alinhamento A1 (os 5 componentes próximos GM-15, GM-17, GM-19, GM-20 e GM-22 ficam como correspondência aproximada), as ligações das tensões-semente T1 a T6 às afirmações e as ligações dos ramos de cenário ao PL 2338 e ao PBIA."@pt ;
    prov:wasAttributedTo dec:Autor ;
    hrai:approvalRecordedAt "2026-11-17T22:36:00-03:00"^^xsd:dateTime ;
    hrai:approvedReason "Mensagem do autor: \"D-04 ij (confirmado pelo autor: 'Sim, aprovado')\"" ;
    hrai:reviewDecisionBy dec:Autor .

dec:D_03 a hrai:ApprovalDecision ;
    rdfs:label "D-03: Aprovar as extrações revisadas: textos do PL 2338 (2023 e 2024), AI Act, princípios do Reino Unido, funções do NIST, indicadores de capacidade e exposição, as 18 correspondências BR × UE e o mapeamento das 29 áreas."@pt ;
    prov:wasAttributedTo dec:Autor ;
    hrai:approvalRecordedAt "2026-11-17T22:33:00-03:00"^^xsd:dateTime ;
    hrai:approvedReason "Mensagem do autor: \"D03 -revisado e ok\"" ;
