dec:D_01 a hrai:ApprovalDecision ;
    rdfs:label "D-01: Incluir a China na comparação, com as fontes acrescentadas em docs/ai-regulations/ch/ (secundárias)."@pt ;
    prov:wasAttributedTo dec:Autor ;
    hrai:approvalRecordedAt "2026-11-17T22:31:00-03:00"^^xsd:dateTime ;
    hrai:approvedReason "Mensagem do autor: \"D-01 adicionado\"" ;
    hrai:reviewDecisionBy dec:Autor .

dec:D_01b a hrai:ApprovalDecision ;
    rdfs:label "D-01b: Revê a D-01: a China fica fora da comparação por ora. A extração fica em ontologies/regulatory/em-espera/cn/ para validar, no futuro, a inclusão de uma nova jurisdição e o seu impacto."@pt ;
    prov:wasAttributedTo dec:Autor ;
    hrai:approvalRecordedAt "2026-11-17T22:48:30-03:00"^^xsd:dateTime ;
    hrai:approvedReason "Mensagem do autor: \"DEIXE CHINA DE FORA PARA VALIDARMOS INCLUSIVE NO FUTURO COMO ADICIONAR NOVAS E O IMPACTO\"" ;
    hrai:reviewDecisionBy dec:Autor .

dec:D_01c a hrai:ApprovalDecision ;
    rdfs:label "D-01c: Incluir a China agora, com os textos oficiais da CAC acrescentados (CH01: Medidas Provisórias para IA generativa, texto integral; CH-02: comunicado das Regras de Síntese Profunda), e medir o impacto da inclusão de uma nova jurisdição."@pt ;
    prov:wasAttributedTo dec:Autor ;
    hrai:approvalRecordedAt "2026-11-17T22:51:00-03:00"^^xsd:dateTime ;
    hrai:approvedReason "Mensagem do autor: \"CHINA ADICIONADO\"" ;
    hrai:reviewDecisionBy dec:Autor .

dec:D_02 a hrai:ApprovalDecision ;
    rdfs:label "D-02: Aprovar as escalas da E4 como propostas em docs/especificacoes/ESP-ONT-02/escalas-E4-proposta.md."@pt ;
    prov:wasAttributedTo dec:Autor ;
    hrai:approvalRecordedAt "2026-11-17T22:32:00-03:00"^^xsd:dateTime ;
    hrai:approvedReason "Mensagem do autor: \"D-02 aprovado\"" ;
    hrai:reviewDecisionBy dec:Autor .

dec:D_05 a hrai:ApprovalDecision ;
    rdfs:label "D-05: Os IRIs resolvíveis (RNF-01) usarão o domínio aeonbridge.io."@pt ;
    prov:wasAttributedTo dec:Autor ;
    hrai:approvalRecordedAt "2026-11-17T22:40:00-03:00"^^xsd:dateTime ;
    hrai:approvedReason "Mensagem do autor: \"D-05 aeonbridge.io (antes: 'd05 w3id.org', 'd05 aeonbridge.io')\"" ;
    hrai:reviewDecisionBy dec:Autor .

dec:D_05a a hrai:ApprovalDecision ;
