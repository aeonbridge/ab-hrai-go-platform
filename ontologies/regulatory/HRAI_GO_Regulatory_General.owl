  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/regulatory#answerScope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:comment xml:lang="en">Scope within which the item holds (for example 'busca no texto do Senado de 2024'); an absence never holds outside its scope.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/regulatory#NationalSpecificity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">NationalSpecificity</rdfs:label>
    <rdfs:comment xml:lang="en">Specificity of Brazil relative to the other jurisdictions of the corpus (QN1): a difference explained by a national dimension, with mandatory evidence. Proposed; produced as a candidate and accepted only by human review (RF-18; RT-VIS-03 step M5).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf13a22ed12f4420588d6083c55c7c637b80">
