    <rdfs:label xml:lang="en">baseYear</rdfs:label>
    <rdfs:comment xml:lang="en">Base year or period of the indicator value as stated by the source (for example '2023' or '2021-2025'); 'não informado na fonte' when the source gives none. Never inferred.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#ContextIndicator"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
