comp:AreasSubstantivas a skos:ConceptScheme ;
    skos:prefLabel "Áreas substantivas do HRAI-GO (extensão E3)"@pt ;
    skos:scopeNote "Áreas substantivas (extensão E3, RF-05): as 28 áreas da cúpula da câmara mais IA generativa/GPAI. Os mapeamentos para funções do NIST AI RMF 1.0, capítulos do AI Act (Regulamento (UE) 2024/1689) e critérios da taxonomia foram propostos pela sessão do loop e revisados pelo autor (decisão D-03, 17/11/2026)."@pt .

comp:TaxonomiaAlanoca2025 a skos:ConceptScheme ;
    dcterms:bibliographicCitation "Alanoca, S.; Gur-Arieh, S.; Zick, T.; Klyman, K. Comparing Apples to Oranges: A Taxonomy for Navigating the Global Landscape of AI Regulation. FAccT '25. doi:10.1145/3715275.3732059. Seção 5.1 (Selected Metrics); critério Scope a partir das Tabelas 1 a 10." ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:prefLabel "Taxonomy of AI regulation (Alanoca et al., 2025)"@en .

