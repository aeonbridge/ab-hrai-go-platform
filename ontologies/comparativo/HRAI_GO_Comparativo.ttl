@prefix comp: <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hrai: <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo> a owl:Ontology ;
    dcterms:description "Módulo comparativo do HRAI-GO (Human-centred Regulatory AI, Governance Observatory): as 12 categorias e os 25 critérios de Alanoca et al. (2025), com as definições originais, e as extensões declaradas E1 a E7 (ESP-ONT-02, RF-16). As escalas dos critérios (E4) aguardam aprovação humana."@pt ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    dcterms:title "HRAI-GO comparative module: base taxonomy and declared extensions"@en ;
    owl:imports <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory> ;
    owl:versionIRI <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo/1.0.0> ;
    owl:versionInfo "1.0.0" .

comp:C01_LawAdoption a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Adoção como lei"@pt ;
    skos:broader comp:Cat_Status ;
    skos:definition "Tracks whether AI legislation has been formally adopted as law yet."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C01" ;
    skos:prefLabel "Law adoption"@en .

comp:C02_NoveltyOfLegalRegime a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Lei nova ou adaptada"@pt ;
    skos:broader comp:Cat_Novelty ;
    skos:definition "This metric assesses whether the legislation is specifically developed to govern AI (new legislation) or if it adapts existing legal frameworks to apply to AI systems. The goal is to distinguish between laws crafted with AI in mind and those repurposed to address AI-related concerns."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C02" ;
    skos:prefLabel "Novelty of legal regime"@en .

comp:C03_DigitalLegalMaturity a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Maturidade do ecossistema regulatório relevante para IA"@pt ;
    skos:broader comp:Cat_DigitalLegalMaturity ;
    skos:definition "Maturity assesses the overall advancement and robustness of a jurisdiction’s digital and AI governance framework. Jurisdictions with mature digital regulatory landscapes typically demonstrate comprehensive AI strategies and AI-adjacent regulations (e.g., data protection, platform content moderation)."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C03" ;
    skos:prefLabel "Maturity of AI-relevant regulatory landscape"@en .

comp:C04_AppliesToGenerativeAI a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Aplica-se a IA generativa/GPAI"@pt ;
    skos:broader comp:Cat_Scope ;
    skos:definition "Applies to Generative AI"@en ;
    skos:editorialNote "Tabelas 1 a 10 (critério sem definição em prosa na seção 5.1)"@pt ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C04" ;
    skos:prefLabel "Applies to Generative AI"@en .

comp:C05_Industry a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Indústria"@pt ;
    skos:broader comp:Cat_Reach ;
    skos:definition "Regulations targeting private sector companies and their AI applications."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C05" ;
    skos:prefLabel "Industry"@en .

comp:C06_Government a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Governo"@pt ;
    skos:broader comp:Cat_Reach ;
    skos:definition "Regulations guiding AI use within public sector entities."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C06" ;
    skos:prefLabel "Government/Federal Agencies"@en .

comp:C07_Individuals a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Indivíduos"@pt ;
    skos:broader comp:Cat_Reach ;
    skos:definition "Regulations addressing the use of AI systems by individuals."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C07" ;
    skos:prefLabel "Individuals/Citizens"@en .

comp:C08_ContinuedReporting a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Relatórios contínuos"@pt ;
    skos:broader comp:Cat_Enforcement ;
    skos:definition "Mandates periodic updates or assessments to monitor compliance over time."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C08" ;
    skos:prefLabel "Continued Reporting"@en .

comp:C09_ThirdPartyAudits a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Auditoria de terceiros"@pt ;
    skos:broader comp:Cat_Enforcement ;
    skos:definition "Independent assessments conducted by external organizations to evaluate and verify compliance with certain standards."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C09" ;
    skos:prefLabel "Third-Party Audits"@en .

comp:C10_ExistingOrNewAgency a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Agência existente ou nova"@pt ;
    skos:broader comp:Cat_Enforcement ;
    skos:definition "Reflects whether enforcement is handled by existing regulatory bodies or if new agencies are established specifically for AI oversight."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C10" ;
    skos:prefLabel "Existing Agency or New Agency"@en .

comp:C11_Liability a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Responsabilização"@pt ;
    skos:broader comp:Cat_Enforcement ;
    skos:definition "This metric examines whether actors bear legal responsibility when AI systems cause harm or fail to comply with regulations."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C11" ;
    skos:prefLabel "Liability"@en .

comp:C12_RegulatorySandboxes a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Sandbox regulatório"@pt ;
    skos:broader comp:Cat_Enforcement ;
    skos:definition "Controlled environments allowing companies to test AI systems under regulatory supervision."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C12" ;
    skos:prefLabel "Regulatory Sandboxes"@en .

comp:C13_CriminalCharges a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Sanções penais"@pt ;
    skos:broader comp:Cat_Sanctions ;
    skos:definition "Frameworks that enable the prosecution of individuals, organizations, or entities for unlawful actions, negligence, or harm caused by AI systems."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C13" ;
    skos:prefLabel "Criminal Charges"@en .

comp:C14_Fines a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Multas"@pt ;
    skos:broader comp:Cat_Sanctions ;
    skos:definition "Financial penalties imposed on non-compliant actors for violating AI regulations."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C14" ;
    skos:prefLabel "Fines"@en .

comp:C15_TemporaryInjunctions a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Injunções temporárias"@pt ;
    skos:broader comp:Cat_Sanctions ;
    skos:definition "Legal orders that temporarily halt the development, deployment, or continued operation of AI systems suspected of posing significant risks or violating regulations."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C15" ;
    skos:prefLabel "Temporary Injunctions"@en .

comp:C16_StandardSetting a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Definição de padrões"@pt ;
    skos:broader comp:Cat_Operationalization ;
    skos:definition "Establishes technical and procedural benchmarks for AI development and deployment."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C16" ;
    skos:prefLabel "Standard Setting"@en .

comp:C17_Auditing a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Auditoria"@pt ;
    skos:broader comp:Cat_Operationalization ;
    skos:definition "Internal or external audits evaluate AI system performance and adherence to standards."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C17" ;
    skos:prefLabel "Auditing"@en .

comp:C18_TechnicalExpertise a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Expertise técnica"@pt ;
    skos:broader comp:Cat_Operationalization ;
    skos:definition "Highlights whether frameworks mandate and have the means to include technical expertise within regulatory bodies, ensuring informed oversight."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C18" ;
    skos:prefLabel "Technical Expertise"@en .

comp:C19_InternationalCooperation a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Alinhamento a marcos globais"@pt ;
    skos:broader comp:Cat_InternationalCooperation ;
    skos:definition "This metric evaluates alignment with global frameworks (e.g., OECD AI principles), which reflects efforts and the willingness of jurisdictions to contribute to international AI governance norms."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C19" ;
    skos:prefLabel "International Cooperation"@en .

comp:C20_CivilSocietyInclusion a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Inclusão da sociedade civil"@pt ;
    skos:broader comp:Cat_StakeholderConsultation ;
    skos:definition "Reflects engagement with nongovernmental organizations, ensuring public interest is represented."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C20" ;
    skos:prefLabel "Civil Society Inclusion"@en .

comp:C21_PrivateSectorInclusion a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Inclusão do setor privado"@pt ;
    skos:broader comp:Cat_StakeholderConsultation ;
    skos:definition "Captures whether industry stakeholders contribute to the legislative process."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C21" ;
    skos:prefLabel "Private Sector Inclusion"@en .

comp:C23_ExPost a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Ex post"@pt ;
    skos:broader comp:Cat_RegulatoryApproach ;
    skos:definition "A reactive approach that evaluates AI systems after deployment, focusing on retrospective assessments and legal remedies. It allows individuals affected by AI to pursue recourse, including the right to file lawsuits."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C23" ;
    skos:prefLabel "Ex Post"@en .

comp:C24_TechnologyFocused a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Tecnologia"@pt ;
    skos:broader comp:Cat_RegulationLayer ;
    skos:definition "Regulations target AI infrastructure (e.g., dual-use foundation models)."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C24" ;
    skos:prefLabel "Technology-Focused"@en .

comp:E2_PrimaryObjective a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Primary objective"@en ;
    skos:definition "Objetivo que o instrumento declara como principal: direitos, inovação, desenvolvimento e soberania, ou segurança."@pt ;
    skos:example "O caráter desenvolvimentista e de soberania do modelo brasileiro (PBIA)."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E2" ;
    skos:prefLabel "Objetivo primário"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:E3_SubstantiveCoverage a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Substantive coverage"@en ;
    skos:definition "Áreas substantivas cobertas (as 28 áreas da câmara mais IA generativa e modelos de propósito geral), ligadas aos critérios quando houver relação."@pt ;
    skos:example "Lacunas de conteúdo: energia, crianças, desigualdade regional, participação."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E3" ;
    skos:prefLabel "Cobertura substantiva"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:E4_ScaledCoding a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Scaled coding with evidence per value"@en ;
    skos:definition "Cada valor é registrado numa escala aprovada e ligado ao dispositivo que o justifica."@pt ;
    skos:example "Valores comparáveis e rastreáveis, em vez de descrições."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E4" ;
    skos:prefLabel "Codificação em escala, com evidência por valor"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:E5_VersionedCoding a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Coding per instrument version"@en ;
    skos:definition "A codificação pertence a uma versão do instrumento; mudou o texto, a codificação é refeita."@pt ;
    skos:example "PL 2338 de 2023 e de 2024; instrumentos revogados (EO 14110)."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E5" ;
    skos:prefLabel "Codificação por versão do instrumento"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:E6_ImplementationCapacity a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Implementation capacity"@en ;
    skos:definition "Orçamento e pessoal disponíveis para supervisionar e implementar o instrumento."@pt ;
    skos:example "Orçamento e pessoal de supervisão (Eixo 5 do PBIA)."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E6" ;
    skos:prefLabel "Capacidade de implementação"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:E7_ImplementationParticipation a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Participation in implementation"@en ;
    skos:definition "Participação de pessoas e grupos na implementação e na padronização, além da consulta no processo legislativo."@pt ;
    skos:example "Deliberação pública ao vivo e Shadow Council."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E7" ;
    skos:prefLabel "Participação na implementação"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:R28_HorizontalRiskBasedProfile a swrl:Imp ;
    rdfs:label "R28_HorizontalRiskBasedProfile"@en ;
    rdfs:comment "Reading label derived from coded values; the criteria stay visible. Depends on approved E4 scales and reviewed codings."@en ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:classPredicate hrai:CriterionCoding ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:propertyPredicate hrai:codingSubject ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:E1_LegalForm ;
                swrl:propertyPredicate hrai:codingCriterion ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_x1 ;
                swrl:propertyPredicate hrai:codingScaleValue ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( comp:var_R28_HorizontalRiskBasedProfile_x1 3.0 ) ;
                swrl:builtin swrlb:equal ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_p1 ;
                swrl:propertyPredicate hrai:codingJustifiedBy ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_d1 ;
                swrl:propertyPredicate hrai:codingReview ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_d1 ;
                swrl:classPredicate hrai:ApprovalDecision ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:classPredicate hrai:CriterionCoding ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:propertyPredicate hrai:codingSubject ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:C22_ExAnte ;
                swrl:propertyPredicate hrai:codingCriterion ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_x2 ;
                swrl:propertyPredicate hrai:codingScaleValue ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( comp:var_R28_HorizontalRiskBasedProfile_x2 3.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_p2 ;
                swrl:propertyPredicate hrai:codingJustifiedBy ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_d2 ;
                swrl:propertyPredicate hrai:codingReview ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_d2 ;
                swrl:classPredicate hrai:ApprovalDecision ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:classPredicate hrai:CriterionCoding ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:propertyPredicate hrai:codingSubject ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:C25_ApplicationFocused ;
                swrl:propertyPredicate hrai:codingCriterion ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_x3 ;
                swrl:propertyPredicate hrai:codingScaleValue ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( comp:var_R28_HorizontalRiskBasedProfile_x3 2.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_p3 ;
                swrl:propertyPredicate hrai:codingJustifiedBy ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_d3 ;
                swrl:propertyPredicate hrai:codingReview ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_d3 ;
                swrl:classPredicate hrai:ApprovalDecision ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:argument2 comp:HorizontalRiskBasedRegulation ;
                swrl:propertyPredicate comp:hasDesignProfile ] ) .

comp:C22_ExAnte a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Ex ante"@pt ;
    skos:broader comp:Cat_RegulatoryApproach ;
    skos:definition "A preventive approach that addresses risks before they arise, emphasizing measures like pre-market approval to ensure AI systems meet safety and compliance standards in advance."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C22" ;
    skos:prefLabel "Ex Ante"@en .

comp:C25_ApplicationFocused a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Aplicação"@pt ;
    skos:broader comp:Cat_RegulationLayer ;
    skos:definition "Legislative focus on specific AI use cases (e.g., social scoring). This provides tailored oversight for distinct risk categories and applications."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C25" ;
    skos:prefLabel "Application-Focused"@en .

comp:Cat_DigitalLegalMaturity a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Maturidade do ecossistema legal digital"@pt ;
    skos:definition "Maturity assesses the overall advancement and robustness of a jurisdiction’s digital and AI governance framework. Jurisdictions with mature digital regulatory landscapes typically demonstrate comprehensive AI strategies and AI-adjacent regulations (e.g., data protection, platform content moderation)."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Maturity of the Digital Legal Landscape"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_InternationalCooperation a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Cooperação internacional"@pt ;
    skos:definition "This metric evaluates alignment with global frameworks (e.g., OECD AI principles), which reflects efforts and the willingness of jurisdictions to contribute to international AI governance norms."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "International Cooperation"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_Novelty a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Novidade"@pt ;
    skos:definition "This metric assesses whether the legislation is specifically developed to govern AI (new legislation) or if it adapts existing legal frameworks to apply to AI systems. The goal is to distinguish between laws crafted with AI in mind and those repurposed to address AI-related concerns."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Novelty"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_Scope a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Escopo"@pt ;
    skos:definition "Applies to Generative AI"@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Scope"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_Status a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Status"@pt ;
    skos:definition "Tracks whether AI legislation has been formally adopted as law yet."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Status"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:E1_LegalForm a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Legal form"@en ;
    skos:definition "Amplia o critério Status para instrumentos não vinculantes: lei, projeto de lei, plano, princípios não estatutários e guia voluntário."@pt ;
    skos:example "PBIA (plano), Reino Unido (princípios não estatutários), NIST AI RMF (guia voluntário)."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E1" ;
    skos:prefLabel "Forma jurídica"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:HorizontalRiskBasedRegulation a owl:NamedIndividual,
        comp:DesignProfile ;
    rdfs:label "Regulação horizontal por risco"@pt ;
    rdfs:comment "Lei ou projeto de lei (E1), com requisitos ex ante altos (C22) e foco em aplicações (C25)."@pt .

comp:hasDesignProfile a owl:ObjectProperty ;
    rdfs:label "hasDesignProfile"@en ;
    rdfs:comment "Inferred (R28): the coded instrument version reads as this design profile."@en ;
    rdfs:range comp:DesignProfile .

