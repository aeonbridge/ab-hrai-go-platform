    skos:altLabel "Scaled coding with evidence per value"@en ;
    skos:definition "Cada valor é registrado numa escala aprovada e ligado ao dispositivo que o justifica."@pt ;
    skos:example "Valores comparáveis e rastreáveis, em vez de descrições."@pt ;
    skos:inScheme comp:ExtensoesHRAIGO ;
    skos:notation "E4" ;
    skos:prefLabel "Codificação em escala, com evidência por valor"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:E5_VersionedCoding a skos:Concept,
