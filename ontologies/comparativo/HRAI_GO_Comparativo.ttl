comp:Cat_Operationalization a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Operacionalização"@pt ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Operationalization"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_Reach a skos:Concept ;
