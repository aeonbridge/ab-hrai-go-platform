    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Coding per instrument version"@en ;
    skos:definition "A codificação pertence a uma versão do instrumento; mudou o texto, a codificação é refeita."@pt ;
