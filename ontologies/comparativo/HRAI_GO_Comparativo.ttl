    skos:altLabel "Fiscalização"@pt ;
    skos:definition "This metric focuses on the mechanisms and processes used to monitor, verify, and enforce compliance with AI regulations."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Enforcement"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:E1_LegalForm a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:isReferencedBy <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/decisoes#D_02> ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Legal form"@en ;
    skos:definition "Amplia o critério Status para instrumentos não vinculantes: lei, projeto de lei, plano, princípios não estatutários e guia voluntário."@pt ;
    skos:editorialNote "Escala E4 aprovada pelo autor (D-02, 17/11/2026)."@pt ;
    skos:example "PBIA (plano), Reino Unido (princípios não estatutários), NIST AI RMF (guia voluntário)."@pt ;
