    skos:prefLabel "Forma jurídica"@pt ;
    skos:scopeNote "Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais."@pt ;
    skos:topConceptOf comp:ExtensoesHRAIGO .

comp:E6_ImplementationCapacity a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:isReferencedBy <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/decisoes#D_02> ;
    rdfs:seeAlso <https://doi.org/10.1145/3715275.3732059> ;
