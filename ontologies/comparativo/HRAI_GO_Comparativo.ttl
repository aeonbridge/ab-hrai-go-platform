comp:C23_ExPost a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:isReferencedBy <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/decisoes#D_02> ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Ex post"@pt ;
    skos:broader comp:Cat_RegulatoryApproach ;
    skos:definition "A reactive approach that evaluates AI systems after deployment, focusing on retrospective assessments and legal remedies. It allows individuals affected by AI to pursue recourse, including the right to file lawsuits."@en ;
    skos:editorialNote "Escala E4 aprovada pelo autor (D-02, 17/11/2026)."@pt ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C23" ;
    skos:prefLabel "Ex Post"@en .

comp:C25_ApplicationFocused a skos:Concept,
        hrai:RegulatoryDesignCriterion ;
    dcterms:isReferencedBy <https://github.com/aeonbridge/ab-hrai-go-platform/data/regulatory/decisoes#D_02> ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Aplicação"@pt ;
    skos:broader comp:Cat_RegulationLayer ;
    skos:definition "Legislative focus on specific AI use cases (e.g., social scoring). This provides tailored oversight for distinct risk categories and applications."@en ;
    skos:editorialNote "Escala E4 aprovada pelo autor (D-02, 17/11/2026)."@pt ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:notation "C25" ;
    skos:prefLabel "Application-Focused"@en .

comp:Cat_Enforcement a skos:Concept ;
