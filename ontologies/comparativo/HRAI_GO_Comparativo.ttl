comp:Cat_DigitalLegalMaturity a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Maturidade do ecossistema legal digital"@pt ;
    skos:definition "Maturity assesses the overall advancement and robustness of a jurisdiction’s digital and AI governance framework. Jurisdictions with mature digital regulatory landscapes typically demonstrate comprehensive AI strategies and AI-adjacent regulations (e.g., data protection, platform content moderation)."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Maturity of the Digital Legal Landscape"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_InternationalCooperation a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Cooperação internacional"@pt ;
    skos:definition "This metric evaluates alignment with global frameworks (e.g., OECD AI principles), which reflects efforts and the willingness of jurisdictions to contribute to international AI governance norms."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "International Cooperation"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_Novelty a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Novidade"@pt ;
    skos:definition "This metric assesses whether the legislation is specifically developed to govern AI (new legislation) or if it adapts existing legal frameworks to apply to AI systems. The goal is to distinguish between laws crafted with AI in mind and those repurposed to address AI-related concerns."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Novelty"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_Scope a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Escopo"@pt ;
    skos:definition "Applies to Generative AI"@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Scope"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

comp:Cat_Status a skos:Concept ;
    dcterms:source <https://doi.org/10.1145/3715275.3732059> ;
    skos:altLabel "Status"@pt ;
    skos:definition "Tracks whether AI legislation has been formally adopted as law yet."@en ;
    skos:inScheme comp:TaxonomiaAlanoca2025 ;
    skos:prefLabel "Status"@en ;
    skos:topConceptOf comp:TaxonomiaAlanoca2025 .

