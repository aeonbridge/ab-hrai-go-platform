comp:R28_HorizontalRiskBasedProfile a swrl:Imp ;
    rdfs:label "R28_HorizontalRiskBasedProfile"@en ;
    rdfs:comment "Reading label derived from coded values; the criteria stay visible. Depends on approved E4 scales and reviewed codings."@en ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:classPredicate hrai:CriterionCoding ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:propertyPredicate hrai:codingSubject ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:E1_LegalForm ;
                swrl:propertyPredicate hrai:codingCriterion ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_x1 ;
                swrl:propertyPredicate hrai:codingScaleValue ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( comp:var_R28_HorizontalRiskBasedProfile_x1 3.0 ) ;
                swrl:builtin swrlb:equal ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_p1 ;
                swrl:propertyPredicate hrai:codingJustifiedBy ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c1 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_d1 ;
                swrl:propertyPredicate hrai:codingReview ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_d1 ;
                swrl:classPredicate hrai:ApprovalDecision ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:classPredicate hrai:CriterionCoding ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:propertyPredicate hrai:codingSubject ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:C22_ExAnte ;
                swrl:propertyPredicate hrai:codingCriterion ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_x2 ;
                swrl:propertyPredicate hrai:codingScaleValue ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( comp:var_R28_HorizontalRiskBasedProfile_x2 3.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_p2 ;
                swrl:propertyPredicate hrai:codingJustifiedBy ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c2 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_d2 ;
                swrl:propertyPredicate hrai:codingReview ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_d2 ;
                swrl:classPredicate hrai:ApprovalDecision ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:classPredicate hrai:CriterionCoding ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:propertyPredicate hrai:codingSubject ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:C25_ApplicationFocused ;
                swrl:propertyPredicate hrai:codingCriterion ] [ a swrl:DatavaluedPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_x3 ;
                swrl:propertyPredicate hrai:codingScaleValue ] [ a swrl:BuiltinAtom ;
                swrl:arguments ( comp:var_R28_HorizontalRiskBasedProfile_x3 2.0 ) ;
                swrl:builtin swrlb:greaterThanOrEqual ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_p3 ;
                swrl:propertyPredicate hrai:codingJustifiedBy ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_c3 ;
                swrl:argument2 comp:var_R28_HorizontalRiskBasedProfile_d3 ;
                swrl:propertyPredicate hrai:codingReview ] [ a swrl:ClassAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_d3 ;
                swrl:classPredicate hrai:ApprovalDecision ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 comp:var_R28_HorizontalRiskBasedProfile_v ;
                swrl:argument2 comp:HorizontalRiskBasedRegulation ;
                swrl:propertyPredicate comp:hasDesignProfile ] ) .

