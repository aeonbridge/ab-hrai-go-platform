  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#C23_ExPost">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#RegulatoryDesignCriterion"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025"/>
    <skos:broader rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#Cat_RegulatoryApproach"/>
    <skos:notation>C23</skos:notation>
    <skos:prefLabel xml:lang="en">Ex Post</skos:prefLabel>
    <skos:altLabel xml:lang="pt">Ex post</skos:altLabel>
    <skos:definition xml:lang="en">A reactive approach that evaluates AI systems after deployment, focusing on retrospective assessments and legal remedies. It allows individuals affected by AI to pursue recourse, including the right to file lawsuits.</skos:definition>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#NIST_Measure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#NistFunction"/>
    <rdfs:label xml:lang="en">MEASURE</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo/1.0.0"/>
    <dcterms:title xml:lang="en">HRAI-GO comparative module: base taxonomy and declared extensions</dcterms:title>
    <dcterms:description xml:lang="pt">Módulo comparativo do HRAI-GO (Human-centred Regulatory AI, Governance Observatory): as 12 categorias e os 25 critérios de Alanoca et al. (2025), com as definições originais, e as extensões declaradas E1 a E7 (ESP-ONT-02, RF-16). As escalas dos critérios (E4) aguardam aprovação humana.</dcterms:description>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N717ef51f1b8a4eb1b3dbf5d4988f669a">
    <rdf:first rdf:nodeID="N7d58921ffa584fde8e08b56764103082"/>
    <rdf:rest rdf:nodeID="N412009b5ea93464c9ff3a5c1152025e7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Taxonomy of AI regulation (Alanoca et al., 2025)</skos:prefLabel>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
    <dcterms:bibliographicCitation>Alanoca, S.; Gur-Arieh, S.; Zick, T.; Klyman, K. Comparing Apples to Oranges: A Taxonomy for Navigating the Global Landscape of AI Regulation. FAccT '25. doi:10.1145/3715275.3732059. Seção 5.1 (Selected Metrics); critério Scope a partir das Tabelas 1 a 10.</dcterms:bibliographicCitation>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#Cat_InternationalCooperation">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025"/>
    <skos:topConceptOf rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025"/>
    <skos:prefLabel xml:lang="en">International Cooperation</skos:prefLabel>
    <skos:altLabel xml:lang="pt">Cooperação internacional</skos:altLabel>
    <skos:definition xml:lang="en">This metric evaluates alignment with global frameworks (e.g., OECD AI principles), which reflects efforts and the willingness of jurisdictions to contribute to international AI governance norms.</skos:definition>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
