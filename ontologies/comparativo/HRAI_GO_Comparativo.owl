  <rdf:Description rdf:nodeID="N55eb7d39251442d3b2b90aeecda4378a">
    <swrl:argument1 rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#var_R28_HorizontalRiskBasedProfile_c2"/>
