    <swrl:head rdf:nodeID="N37128cd4f10a496baab7439b4a29a5a4"/>
    <rdfs:comment xml:lang="en">Reading label derived from coded values; the criteria stay visible. Depends on approved E4 scales and reviewed codings.</rdfs:comment>
  </rdf:Description>
