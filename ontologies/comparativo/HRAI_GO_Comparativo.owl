  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#AreasSubstantivas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="pt">Áreas substantivas do HRAI-GO (extensão E3)</skos:prefLabel>
    <skos:scopeNote xml:lang="pt">Áreas substantivas (extensão E3, RF-05): as 28 áreas da cúpula da câmara mais IA generativa/GPAI. Os mapeamentos para funções do NIST AI RMF 1.0, capítulos do AI Act (Regulamento (UE) 2024/1689) e critérios da taxonomia são PROPOSTA do autor deste arquivo, pendente de revisão humana.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#R28_HorizontalRiskBasedProfile">
