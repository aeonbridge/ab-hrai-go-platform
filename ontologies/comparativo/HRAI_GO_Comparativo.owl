    <skos:prefLabel xml:lang="en">International Cooperation</skos:prefLabel>
    <skos:altLabel xml:lang="pt">Alinhamento a marcos globais</skos:altLabel>
    <skos:definition xml:lang="en">This metric evaluates alignment with global frameworks (e.g., OECD AI principles), which reflects efforts and the willingness of jurisdictions to contribute to international AI governance norms.</skos:definition>
