  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#C22_ExAnte">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#RegulatoryDesignCriterion"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025"/>
    <skos:broader rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#Cat_RegulatoryApproach"/>
    <skos:notation>C22</skos:notation>
    <skos:prefLabel xml:lang="en">Ex Ante</skos:prefLabel>
    <skos:altLabel xml:lang="pt">Ex ante</skos:altLabel>
    <skos:definition xml:lang="en">A preventive approach that addresses risks before they arise, emphasizing measures like pre-market approval to ensure AI systems meet safety and compliance standards in advance.</skos:definition>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#Cat_Novelty">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025"/>
    <skos:topConceptOf rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025"/>
    <skos:prefLabel xml:lang="en">Novelty</skos:prefLabel>
    <skos:altLabel xml:lang="pt">Novidade</skos:altLabel>
    <skos:definition xml:lang="en">This metric assesses whether the legislation is specifically developed to govern AI (new legislation) or if it adapts existing legal frameworks to apply to AI systems. The goal is to distinguish between laws crafted with AI in mind and those repurposed to address AI-related concerns.</skos:definition>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb8bafed879144138b7ebf44faef9390f">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</rdf:first>
  </rdf:Description>
