    <skos:prefLabel xml:lang="en">Criminal Charges</skos:prefLabel>
    <skos:altLabel xml:lang="pt">Sanções penais</skos:altLabel>
    <skos:definition xml:lang="en">Frameworks that enable the prosecution of individuals, organizations, or entities for unlawful actions, negligence, or harm caused by AI systems.</skos:definition>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#E6_ImplementationCapacity">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#RegulatoryDesignCriterion"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#ExtensoesHRAIGO"/>
    <skos:topConceptOf rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#ExtensoesHRAIGO"/>
    <skos:notation>E6</skos:notation>
    <skos:prefLabel xml:lang="pt">Capacidade de implementação</skos:prefLabel>
    <skos:altLabel xml:lang="en">Implementation capacity</skos:altLabel>
    <skos:definition xml:lang="pt">Orçamento e pessoal disponíveis para supervisionar e implementar o instrumento.</skos:definition>
    <skos:example xml:lang="pt">Orçamento e pessoal de supervisão (Eixo 5 do PBIA).</skos:example>
    <skos:scopeNote xml:lang="pt">Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#C12_RegulatorySandboxes">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#RegulatoryDesignCriterion"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#TaxonomiaAlanoca2025"/>
