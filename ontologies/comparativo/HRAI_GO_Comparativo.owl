  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#E3_SubstantiveCoverage">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#RegulatoryDesignCriterion"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#ExtensoesHRAIGO"/>
    <skos:topConceptOf rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#ExtensoesHRAIGO"/>
    <skos:notation>E3</skos:notation>
    <skos:prefLabel xml:lang="pt">Cobertura substantiva</skos:prefLabel>
    <skos:altLabel xml:lang="en">Substantive coverage</skos:altLabel>
    <skos:definition xml:lang="pt">Áreas substantivas cobertas (as 28 áreas da câmara mais IA generativa e modelos de propósito geral), ligadas aos critérios quando houver relação.</skos:definition>
    <skos:example xml:lang="pt">Lacunas de conteúdo: energia, crianças, desigualdade regional, participação.</skos:example>
    <skos:scopeNote xml:lang="pt">Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#E2_PrimaryObjective">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#RegulatoryDesignCriterion"/>
    <skos:inScheme rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#ExtensoesHRAIGO"/>
    <skos:topConceptOf rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#ExtensoesHRAIGO"/>
    <skos:notation>E2</skos:notation>
    <skos:prefLabel xml:lang="pt">Objetivo primário</skos:prefLabel>
    <skos:altLabel xml:lang="en">Primary objective</skos:altLabel>
    <skos:definition xml:lang="pt">Objetivo que o instrumento declara como principal: direitos, inovação, desenvolvimento e soberania, ou segurança.</skos:definition>
    <skos:example xml:lang="pt">O caráter desenvolvimentista e de soberania do modelo brasileiro (PBIA).</skos:example>
    <skos:scopeNote xml:lang="pt">Extensão declarada da taxonomia de Alanoca, Gur-Arieh, Zick e Klyman (2025), Comparing Apples to Oranges, FAccT '25, doi:10.1145/3715275.3732059. Não altera as definições originais.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
