    <skos:notation>C12</skos:notation>
    <skos:prefLabel xml:lang="en">Regulatory Sandboxes</skos:prefLabel>
    <skos:altLabel xml:lang="pt">Sandbox regulatório</skos:altLabel>
    <skos:definition xml:lang="en">Controlled environments allowing companies to test AI systems under regulatory supervision.</skos:definition>
    <dcterms:source rdf:resource="https://doi.org/10.1145/3715275.3732059"/>
  </rdf:Description>
