# V-16 (RT-VIS-03) / RF-13: tensões-semente da SCSE sem ligação a afirmação do núcleo.
# Aceite: zero linhas. Uma semente só conta como ligada se a afirmação existir como hrai:PolicyClaim.
PREFIX scse: <https://hrai-go.aeonbridge.io/ontology/scse#>
PREFIX hrai: <https://hrai-go.aeonbridge.io/ontology/regulatory#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?semente ?id WHERE {
  ?semente a scse:PolicyTension ; skos:notation ?id .
  FILTER NOT EXISTS { ?semente hrai:hasPolicyClaim ?c . ?c a hrai:PolicyClaim . }
}
