# PC3 (QN2): O que o Brasil incorporou que pressupõe capacidade que o contexto não tem? Requisitos com risco de
# capacidade (R25b), com o indicador; e requisitos cuja capacidade não tem indicador ("sem indicador").
PREFIX hrai: <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory#>
PREFIX scse: <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/scse#>
PREFIX comp: <https://github.com/aeonbridge/ab-hrai-go-platform/ontology/comparativo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?requisito ?capacidade ?indicador ?situacao WHERE {
  { ?requisito hrai:requirementHasCapacityRisk ?indicador .
    OPTIONAL { ?requisito hrai:requirementAssumesCapacity ?capacidade . ?capacidade hrai:capacityMeasuredBy ?indicador }
    BIND("abaixo do limiar" AS ?situacao) }
  UNION
  { ?requisito hrai:requirementAssumesCapacity ?capacidade .
    FILTER NOT EXISTS { ?capacidade hrai:capacityMeasuredBy ?i }
    BIND("sem indicador" AS ?situacao) }
} ORDER BY ?requisito
