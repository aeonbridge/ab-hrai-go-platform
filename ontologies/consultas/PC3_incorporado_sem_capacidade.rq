# PC3 (QN2): O que o Brasil incorporou que pressupõe capacidade que o contexto não tem? Requisitos com risco de
# capacidade (R25b), com o indicador; requisitos cuja capacidade tem indicador mas nenhum limiar aprovado
# ("indicador sem limiar": não é sinal, é falta de critério); e requisitos sem indicador ("sem indicador").
PREFIX hrai: <https://hrai-go.aeonbridge.io/ontology/regulatory#>
PREFIX scse: <https://hrai-go.aeonbridge.io/ontology/scse#>
PREFIX comp: <https://hrai-go.aeonbridge.io/ontology/comparativo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?requisito ?capacidade ?indicador ?situacao WHERE {
  { ?requisito hrai:requirementHasCapacityRisk ?indicador .
    OPTIONAL { ?requisito hrai:requirementAssumesCapacity ?capacidade . ?capacidade hrai:capacityMeasuredBy ?indicador }
    BIND("abaixo do limiar" AS ?situacao) }
  UNION
  { ?requisito hrai:requirementAssumesCapacity ?capacidade . ?capacidade hrai:capacityMeasuredBy ?indicador .
    FILTER NOT EXISTS { ?indicador hrai:hasLowerAlertThreshold ?t }
    BIND("indicador sem limiar" AS ?situacao) }
  UNION
  { ?requisito hrai:requirementAssumesCapacity ?capacidade .
    FILTER NOT EXISTS { ?capacidade hrai:capacityMeasuredBy ?i }
    BIND("sem indicador" AS ?situacao) }
} ORDER BY ?requisito
