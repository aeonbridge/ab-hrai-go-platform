# PC7: Quando um texto muda, o que é reaberto? Evento de mudança e o que ele potencialmente afeta: dispositivos,
# requisitos, avaliações e aplicações (R10 a R13); e, ligados à versão anterior do mesmo instrumento, codificações
# (E5), especificidades da QN1 e afirmações cuja evidência cita dispositivo dessa versão (M10 do RT-VIS-03).
PREFIX hrai: <https://hrai-go.aeonbridge.io/ontology/regulatory#>
PREFIX scse: <https://hrai-go.aeonbridge.io/ontology/scse#>
PREFIX comp: <https://hrai-go.aeonbridge.io/ontology/comparativo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?evento ?tipoAfetado ?afetado WHERE {
  ?evento a hrai:RegulatoryChangeEvent .
  { ?evento hrai:changePotentiallyAffectsProvision ?afetado . BIND("dispositivo" AS ?tipoAfetado) }
  UNION { ?evento hrai:changePotentiallyAffectsRequirement ?afetado . BIND("requisito" AS ?tipoAfetado) }
  UNION { ?afetado hrai:assessmentNeedsReviewDueTo ?evento . BIND("avaliação" AS ?tipoAfetado) }
  UNION { ?afetado hrai:applicationPotentiallyImpactedBy ?evento . BIND("aplicação" AS ?tipoAfetado) }
  UNION { ?evento hrai:changeAffectsVersion ?nova . ?nova hrai:previousLegalVersion ?anterior .
          ?afetado a hrai:CriterionCoding ; hrai:codingSubject ?anterior . BIND("codificação" AS ?tipoAfetado) }
  UNION { ?evento hrai:changeAffectsVersion ?nova . ?nova hrai:previousLegalVersion ?anterior .
          ?afetado a hrai:NationalSpecificity ; hrai:specificityGroundedIn ?d . ?d hrai:provisionOfVersion ?anterior .
          BIND("especificidade" AS ?tipoAfetado) }
  UNION { SELECT DISTINCT ?evento ?afetado ?tipoAfetado WHERE {
          ?evento hrai:changeAffectsVersion ?nova . ?nova hrai:previousLegalVersion ?anterior .
          ?afetado hrai:claimSupportedByEvidence ?ev . ?ev dcterms:references ?d . ?d hrai:provisionOfVersion ?anterior .
          BIND("afirmação" AS ?tipoAfetado) } }
} ORDER BY ?evento ?tipoAfetado ?afetado
