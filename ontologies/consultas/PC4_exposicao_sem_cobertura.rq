# PC4 (QN3): O que o contexto expõe a risco e nenhum instrumento cobre? Só vale dentro de um CoverageAssessment
# (mundo fechado declarado): exposição ligada a uma área varrida na jurisdição, sem cobertura vigente, proposta ou plano.
PREFIX hrai: <https://hrai-go.aeonbridge.io/ontology/regulatory#>
PREFIX scse: <https://hrai-go.aeonbridge.io/ontology/scse#>
PREFIX comp: <https://hrai-go.aeonbridge.io/ontology/comparativo#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?exposicao ?area ?jurisdicao ?avaliacao ?snapshot WHERE {
  ?exposicao a hrai:RiskExposureIndicator ; hrai:exposureConcernsFunction ?area .
  ?avaliacao a hrai:CoverageAssessment ; hrai:coverageOfFunction ?area ; hrai:coverageForJurisdiction ?jurisdicao .
  OPTIONAL { ?avaliacao hrai:coverageInSnapshot ?snapshot }
  FILTER NOT EXISTS { ?jurisdicao hrai:jurisdictionAddressesFunction ?area }
  FILTER NOT EXISTS { ?jurisdicao hrai:jurisdictionProposesFunction ?area }
  FILTER NOT EXISTS { ?jurisdicao hrai:jurisdictionPlansFunction ?area }
} ORDER BY ?jurisdicao ?area
