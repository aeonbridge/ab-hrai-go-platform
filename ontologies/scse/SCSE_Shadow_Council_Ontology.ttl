scse:DecisionRecord a owl:Class ;
    rdfs:label "DecisionRecord"@en ;
    rdfs:comment "Human decision at the end of a deliberation: selects an alternative, cites the claims it rests on and keeps the divergences that remain (round 4). Enters the graph as a candidate."@en .

scse:MinorityOpinion a owl:Class ;
    rdfs:label "MinorityOpinion"@en ;
    rdfs:comment "Preserved dissenting view with rationale and documentary limitations."@en .

scse:PendingReview a owl:NamedIndividual,
        scse:ReviewStatus ;
    rdfs:label "PendingReview"@en ;
    rdfs:comment "Pending formal review"@en .

scse:RegulatoryPolicyMode a owl:NamedIndividual,
        scse:ScenarioMode ;
    rdfs:label "RegulatoryPolicyMode"@en ;
    rdfs:comment "Policy regulatory simulation"@en .

scse:SamplingFrame a owl:Class ;
    rdfs:label "SamplingFrame"@en ;
    rdfs:comment "Declared collection of documented positions used to select synthetic seats."@en .

scse:ScenarioMode a owl:Class ;
    rdfs:label "ScenarioMode"@en ;
    rdfs:comment "Controlled value indicating which simulation regime is requested."@en ;
    owl:oneOf ( scse:RegulatoryPolicyMode scse:SolutionComplianceMode ) .

scse:SyntheticPerspective a owl:NamedIndividual,
        scse:ClaimClassification ;
    rdfs:label "SyntheticPerspective"@en ;
    rdfs:comment "Synthetic stakeholder perspective"@en .

scse:var_R29a_SyntheticSupport_p a swrl:Variable .

scse:var_R29b_SyntheticChallenge_p a swrl:Variable .

ex:Brazil a hrai:Jurisdiction ;
    scse:jurisdictionCode "BR" .

ex:SyntheticEvidence a scse:EvidenceRecord ;
    scse:evidenceText "Synthetic placeholder evidence; must be replaced with verifiable publications before real use." ;
    scse:sourceEvidence ex:SyntheticPerspectiveSource .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R01_council> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R02_council> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R03_agent> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R04_run> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R05_assessment> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R06_finding> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R07_finding> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R08_round> a swrl:Variable .

<https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R09_project> a swrl:Variable .

scse:InsufficientEvidenceStatus a owl:NamedIndividual,
        scse:FindingStatus ;
    rdfs:label "InsufficientEvidenceStatus"@en ;
    rdfs:comment "Insufficient evidence for a determination"@en .

scse:ModelManifest a owl:Class ;
    rdfs:label "ModelManifest"@en ;
    rdfs:comment "Frozen reproducibility metadata for the models and configurations used in a run."@en .

scse:PendingSourceVerification a owl:NamedIndividual,
        scse:SourceVerificationStatus ;
    rdfs:label "PendingSourceVerification"@en ;
    rdfs:comment "Source pending verification"@en .

scse:ProposedStatus a owl:NamedIndividual,
        hrai:LegalStatus ;
    rdfs:label "ProposedStatus"@en ;
    rdfs:comment "Unenacted proposal only"@en .

scse:ReviewStatus a owl:Class ;
    rdfs:label "ReviewStatus"@en ;
    rdfs:comment "Controlled review status for source or knowledge validation."@en ;
    owl:oneOf ( scse:PendingReview scse:Reviewed scse:RejectedReview ) .

scse:SimulationProject a owl:Class ;
    rdfs:label "SimulationProject"@en ;
    rdfs:comment "Project containing scenarios, owners, scope and access controls."@en .

scse:SolutionComplianceMode a owl:NamedIndividual,
        scse:ScenarioMode ;
    rdfs:label "SolutionComplianceMode"@en ;
    rdfs:comment "Application compliance simulation"@en .

scse:SourceVerificationStatus a owl:Class ;
    rdfs:label "SourceVerificationStatus"@en ;
    rdfs:comment "Controlled status of provenance/source verification."@en ;
    owl:oneOf ( scse:VerifiedSource scse:PendingSourceVerification scse:FailedSourceVerification ) .

scse:var_R30_DivergentAlternative_a a swrl:Variable .

scse:DeliberationEvent a owl:Class ;
    rdfs:label "DeliberationEvent"@en ;
    rdfs:comment "Auditable action within a deliberation round linked to claims and execution."@en .

scse:NationalContextSnapshot a owl:Class ;
    rdfs:label "NationalContextSnapshot"@en ;
    rdfs:comment "Temporal capture of national and institutional indicators used by a scenario."@en .

scse:PolicyTension a owl:Class ;
    rdfs:label "PolicyTension"@en ;
    rdfs:comment "Claimed conflict or trade-off among policy objectives requiring examination."@en ;
    rdfs:subClassOf hrai:RegulatoryTension .

scse:WorldSnapshot a owl:Class ;
    rdfs:label "WorldSnapshot"@en ;
    rdfs:comment "Frozen simulation world state containing legal, national and application inputs."@en .

scse:ClaimClassification a owl:Class ;
    rdfs:label "ClaimClassification"@en ;
    rdfs:comment "Controlled classification separating verified claims from synthetic positions."@en ;
    owl:oneOf ( scse:VerifiedLegalFact scse:EvidenceBasedFinding scse:SyntheticPerspective scse:Hypothesis scse:UnknownClaimClass ) .

scse:DeliberationRound a owl:Class ;
    rdfs:label "DeliberationRound"@en ;
    rdfs:comment "Controlled ordered stage of a council debate with permitted activities and events."@en .

scse:RegulatorySnapshot a owl:Class ;
    rdfs:label "RegulatorySnapshot"@en ;
    rdfs:comment "As-of collection of versioned legal provision states and source material."@en ;
    owl:disjointWith scse:NationalContextSnapshot .

scse:ScenarioBranch a owl:Class ;
    rdfs:label "ScenarioBranch"@en ;
    rdfs:comment "Controlled intervention, patch and assumptions applied to a base scenario."@en .

scse:CouncilSeat a owl:Class ;
    rdfs:label "CouncilSeat"@en ;
    rdfs:comment "Synthetic seat allocated to a stratum with an explicit source basis and justification."@en .

scse:SourceDocument a owl:Class ;
    rdfs:label "SourceDocument"@en ;
    rdfs:comment "Document or official source referenced by legal or empirical statements."@en ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith scse:EvidenceRecord .

scse:StakeholderStratum a owl:Class ;
    rdfs:label "StakeholderStratum"@en ;
    rdfs:comment "Documented perspective category used for synthetic council coverage, not a human probability sample."@en .

scse:FindingStatus a owl:Class ;
    rdfs:label "FindingStatus"@en ;
    rdfs:comment "Controlled evidence-bounded status for a compliance finding."@en ;
    owl:oneOf ( scse:CompliantEvidencedStatus scse:NoncompliantEvidencedStatus scse:InsufficientEvidenceStatus scse:NotApplicableStatus scse:RequiresLegalReviewStatus scse:FutureObligationStatus scse:ProposalOnlyStatus ) .

scse:PerspectiveAgent a owl:Class ;
    rdfs:label "PerspectiveAgent"@en ;
    rdfs:comment "Artificial agent whose bounded simulated perspective is linked to a charter and sources."@en ;
    rdfs:subClassOf prov:SoftwareAgent ;
    owl:disjointWith scse:CouncilSeat .

scse:ShadowCouncil a owl:Class ;
    rdfs:label "ShadowCouncil"@en ;
    rdfs:comment "Council of synthetic seats whose views must not be represented as polling real persons."@en .

scse:CouncilReport a owl:Class ;
    rdfs:label "CouncilReport"@en ;
    rdfs:comment "Integrated evidence-backed outputs, minority positions, uncertainties and limitations."@en .

scse:SolutionArtifact a owl:Class ;
    rdfs:label "SolutionArtifact"@en ;
    rdfs:comment "Briefing, technical specification, architecture or deployed-system description to assess."@en .

scse:EvidenceRecord a owl:Class ;
    rdfs:label "EvidenceRecord"@en ;
    rdfs:comment "Citable record with provenance, verification status and version metadata."@en ;
    rdfs:subClassOf prov:Entity,
        hrai:Evidence .

scse:SimulationRun a owl:Class ;
    rdfs:label "SimulationRun"@en ;
    rdfs:comment "One execution with configuration, random seed, replay data and immutable inputs."@en ;
    rdfs:subClassOf prov:Activity .

scse:ArgumentClaim a owl:Class ;
    rdfs:label "ArgumentClaim"@en ;
    rdfs:comment "Proposition open to support, challenge, withdrawal and evidence review."@en ;
    rdfs:subClassOf hrai:PolicyClaim .

scse:ComplianceFinding a owl:Class ;
    rdfs:label "ComplianceFinding"@en ;
    rdfs:comment "Requirement-scoped, evidence-bounded assessment outcome, not automatic legal certification."@en ;
    owl:disjointWith scse:ArgumentClaim .

scse:LegalProvisionState a owl:Class ;
    rdfs:label "LegalProvisionState"@en ;
    rdfs:comment "Time- and source-qualified representation of the legal status of a provision."@en .

scse:PerspectiveCharter a owl:Class ;
    rdfs:label "PerspectiveCharter"@en ;
    rdfs:comment "Explicit constraints, documented positions, blind spots and permitted actions of a perspective agent."@en .

scse:ScenarioDefinition a owl:Class ;
    rdfs:label "ScenarioDefinition"@en ;
    rdfs:comment "Frozen question, jurisdiction, mode, relevant sources, and assumptions of a simulation."@en .

[] a owl:AllDifferent ;
    owl:distinctMembers ( scse:VerifiedSource scse:PendingSourceVerification scse:FailedSourceVerification ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( scse:CompliantEvidencedStatus scse:NoncompliantEvidencedStatus scse:InsufficientEvidenceStatus scse:NotApplicableStatus scse:RequiresLegalReviewStatus scse:FutureObligationStatus scse:ProposalOnlyStatus ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( scse:PendingReview scse:Reviewed scse:RejectedReview ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( scse:RegulatoryPolicyMode scse:SolutionComplianceMode ) .

[] rdf:first scse:ProposedStatus ;
    rdf:rest ( scse:EnactedNotEffectiveStatus scse:EffectiveStatus scse:SuspendedStatus scse:RepealedStatus scse:SupersededStatus scse:UnknownLegalStatus ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( scse:VerifiedLegalFact scse:EvidenceBasedFinding scse:SyntheticPerspective scse:Hypothesis scse:UnknownClaimClass ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( scse:ProposedStatus scse:EnactedNotEffectiveStatus scse:EffectiveStatus scse:SuspendedStatus scse:RepealedStatus scse:SupersededStatus scse:UnknownLegalStatus ) .

