# =============================================================================
# SCSE · conselho do cenário GOV-BR-001 (ESP-ONT-02, RF-13)
#
# Estratos, assentos, cadeiras vazias, tensões-semente e ramos de cenário que a câmara e o mural exibem.
# Este arquivo é a fonte desses elementos: web/assets/modelo.js deve ser gerado dele (item 8 do loop).
# Camada de deliberação (SCSE), nunca instância de fonte: não vai para ontologies/regulatory/instances (I-2).
# As ligações semente -> afirmação e ramo -> instrumento foram aprovadas pelo autor (D-04, 17/11/2026).
# =============================================================================
@prefix scse: <https://hrai-go.aeonbridge.io/ontology/scse#> .
@prefix hrai: <https://hrai-go.aeonbridge.io/ontology/regulatory#> .
@prefix gov:  <https://hrai-go.aeonbridge.io/data/scse/gov-br-001#> .
@prefix a1:   <https://hrai-go.aeonbridge.io/data/regulatory/claims/a1#> .
@prefix pbia: <https://hrai-go.aeonbridge.io/data/regulatory/br/pbia#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://hrai-go.aeonbridge.io/data/scse/gov-br-001> a owl:Ontology ;
    rdfs:label "Conselho e tensões do cenário GOV-BR-001"@pt ;
    owl:imports <https://hrai-go.aeonbridge.io/ontology/scse> .

gov:GOV_BR_001 a owl:NamedIndividual , scse:ScenarioDefinition ;
    rdfs:label "GOV-BR-001: modelo brasileiro de governança de IA"@pt ;
    scse:scenarioId "GOV-BR-001" ;
    scse:instantiatesCouncil gov:Conselho .

gov:Conselho a owl:NamedIndividual , scse:ShadowCouncil ;
    rdfs:label "Shadow Council do cenário GOV-BR-001"@pt .


gov:Estrato_Regulators a owl:NamedIndividual , scse:StakeholderStratum ;
