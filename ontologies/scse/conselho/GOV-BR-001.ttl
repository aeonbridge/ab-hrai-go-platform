gov:Semente_T1 a owl:NamedIndividual , scse:PolicyTension ;
    rdfs:label "Continuidade do plano × supervisão e avaliação"@pt ;
    skos:notation "T1" ;
    scse:tensionDescription "Se o orçamento pós-2028 encolher, o que se protege primeiro: infraestrutura e pesquisa, ou a capacidade de supervisionar e avaliar?"@pt ;
    scse:tensionBetweenStrata gov:Estrato_Research , gov:Estrato_Regulators ;
    hrai:hasPolicyClaim a1:C07 ;
    skos:editorialNote "Ligação às afirmações: aprovada pelo autor (D-04, 17/11/2026)."@pt ;
    hrai:displayKey "seeds:T1" .

gov:Semente_T2 a owl:NamedIndividual , scse:PolicyTension ;
    rdfs:label "Soberania computacional × custo e energia"@pt ;
    skos:notation "T2" ;
    scse:tensionDescription "Reduzir a dependência de nuvem estrangeira exige capacidade nacional, energia e chips, com custo para quem usa IA hoje."@pt ;
    scse:tensionBetweenStrata gov:Estrato_Infrastructure , gov:Estrato_Business ;
    hrai:hasPolicyClaim a1:C08 , a1:C11 , a1:C12 ;
    skos:editorialNote "Ligação às afirmações: aprovada pelo autor (D-04, 17/11/2026)."@pt ;
    hrai:displayKey "seeds:T2" .

gov:Semente_T3 a owl:NamedIndividual , scse:PolicyTension ;
    rdfs:label "Difusão da IA × emprego e desigualdade regional"@pt ;
    skos:notation "T3" ;
    scse:tensionDescription "Adoção rápida e ganho de produtividade de um lado; ocupações expostas e requalificação desigual entre regiões do outro."@pt ;
    scse:tensionBetweenStrata gov:Estrato_Workers , gov:Estrato_Business ;
    hrai:hasPolicyClaim a1:C03 ;
    skos:editorialNote "Ligação às afirmações: aprovada pelo autor (D-04, 17/11/2026)."@pt ;
    hrai:displayKey "seeds:T3" .

gov:Semente_T4 a owl:NamedIndividual , scse:PolicyTension ;
    rdfs:label "Direitos × custo de conformidade"@pt ;
    skos:notation "T4" ;
    scse:tensionDescription "Avaliação de impacto e transparência algorítmica de um lado; a carga de documentação para PMEs e startups do outro."@pt ;
    scse:tensionBetweenStrata gov:Estrato_CivilSociety , gov:Estrato_Business ;
    hrai:hasPolicyClaim a1:C01 , a1:K01 , a1:C02 ;
    skos:editorialNote "Ligação às afirmações: aprovada pelo autor (D-04, 17/11/2026)."@pt ;
    hrai:displayKey "seeds:T4" .

gov:Semente_T5 a owl:NamedIndividual , scse:PolicyTension ;
    rdfs:label "Auditoria × capacidade de fiscalizar"@pt ;
    skos:notation "T5" ;
    scse:tensionDescription "Exigir auditoria em todo sistema público de alto impacto depende de quem consegue fiscalizar e de quantos sistemas já estão em produção."@pt ;
    scse:tensionBetweenStrata gov:Estrato_Regulators , gov:Estrato_PublicOperators ;
    hrai:hasPolicyClaim a1:C04 , a1:C07 ;
    skos:editorialNote "Ligação às afirmações: aprovada pelo autor (D-04, 17/11/2026)."@pt ;
    hrai:displayKey "seeds:T5" .

gov:Semente_T6 a owl:NamedIndividual , scse:PolicyTension ;
    rdfs:label "Eficiência × contestação humana"@pt ;
    skos:notation "T6" ;
    scse:tensionDescription "A triagem automática acelera o atendimento; o cidadão precisa entender e contestar uma negativa."@pt ;
    scse:tensionBetweenStrata gov:Estrato_PublicOperators , gov:Estrato_AffectedGroups ;
    hrai:hasPolicyClaim a1:C05 , a1:K05 , a1:K09 ;
    skos:editorialNote "Ligação às afirmações: aprovada pelo autor (D-04, 17/11/2026)."@pt ;
    hrai:displayKey "seeds:T6" .

