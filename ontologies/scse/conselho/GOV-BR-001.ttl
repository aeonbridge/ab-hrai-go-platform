    scse:branchConcernsInstrument pbia:PL_2338_2023 ;
    skos:editorialNote "Ligação ao instrumento: aprovada pelo autor (D-04, 17/11/2026)."@pt ;
    hrai:displayKey "branches:pl2338-approved" .
gov:GOV_BR_001 scse:hasBranch gov:Ramo_Pl2338Approved .

