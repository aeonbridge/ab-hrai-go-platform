  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#tensionBetweenStrata">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">tensionBetweenStrata</rdfs:label>
    <rdfs:comment xml:lang="en">Strata of the council whose perspectives pull in opposite directions in this tension.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#PolicyTension"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#StakeholderStratum"/>
