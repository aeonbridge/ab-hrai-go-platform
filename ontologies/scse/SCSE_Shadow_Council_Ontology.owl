  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#assignedAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">assignedAgent</rdfs:label>
    <rdfs:comment xml:lang="en">Assigns an agent to this council seat.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#CouncilSeat"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#PerspectiveAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#NoncompliantEvidencedStatus">
