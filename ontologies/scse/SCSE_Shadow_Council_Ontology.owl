    <rdfs:label xml:lang="en">gapAffectsStratum</rdfs:label>
    <rdfs:comment xml:lang="en">Stratum affected by a coverage gap.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/scse#CoverageGap"/>
