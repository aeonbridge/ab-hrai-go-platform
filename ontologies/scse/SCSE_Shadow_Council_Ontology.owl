>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#scenarioId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">scenarioId</rdfs:label>
    <rdfs:comment xml:lang="en">Stable scenario identifier.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ScenarioDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b59">
    <rdf:first rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b56"/>
    <rdf:rest rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b60"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#SyntheticStakeholderPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Synthetic stakeholder position</rdfs:label>
    <rdfs:comment xml:lang="en">Position expressed by a synthetic perspective; never read as a stakeholder's actual view. Home of the concept since RF-17.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#StakeholderPosition"/>
    <owl:equivalentClass rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#SyntheticStakeholderPosition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#challenges">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">challenges</rdfs:label>
    <rdfs:comment xml:lang="en">A claim that challenges another claim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ArgumentClaim"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ArgumentClaim"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b31">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:argument1 rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R04_run"/>
    <swrl:argument2 rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R04_claim"/>
    <swrl:propertyPredicate rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#runHasClaim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#CouncilReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CouncilReport</rdfs:label>
    <rdfs:comment xml:lang="en">Integrated evidence-backed outputs, minority positions, uncertainties and limitations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#decisionSelects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">decisionSelects</rdfs:label>
    <rdfs:comment xml:lang="en">Alternative chosen by the human decision.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#DecisionRecord"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#PolicyAlternative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#branchConcernsInstrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">branchConcernsInstrument</rdfs:label>
    <rdfs:comment xml:lang="en">Instrument (legal or policy) whose counterfactual change the branch explores.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ScenarioBranch"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b88">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:argument1 rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#var_R30_DivergentAlternative_p2"/>
    <swrl:argument2 rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#var_R30_DivergentAlternative_s2"/>
    <swrl:propertyPredicate rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#positionExpressedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#unresolvedQuestion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">unresolvedQuestion</rdfs:label>
    <rdfs:comment xml:lang="en">Unresolved issue requiring verification.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#CouncilReport"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#Hypothesis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ClaimClassification"/>
    <rdfs:label xml:lang="en">Hypothesis</rdfs:label>
    <rdfs:comment xml:lang="en">Hypothesis requiring test</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#hasSyntheticChallenge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasSyntheticChallenge</rdfs:label>
    <rdfs:comment xml:lang="en">Inferred (R29b): a synthetic position challenges the claim. Never counted as human challenge.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#PolicyClaim"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#StakeholderPosition"/>
  </rdf:Description>
