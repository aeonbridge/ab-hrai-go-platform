  <rdf:Description rdf:about="https://example.org/hrai-go/scse#RegulatoryPolicyScenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">RegulatoryPolicyScenario</rdfs:label>
    <rdfs:comment xml:lang="en">Scenario dedicated to regulatory policy evaluation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/hrai-go/scse#ScenarioDefinition"/>
    <rdfs:subClassOf rdf:nodeID="Nc4ddb1b7e7954ab49427ed9e8b56f46f"/>
    <owl:disjointWith rdf:resource="https://example.org/hrai-go/scse#SolutionComplianceScenario"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/hrai-go/scse#LegalProvisionState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">LegalProvisionState</rdfs:label>
    <rdfs:comment xml:lang="en">Time- and source-qualified representation of the legal status of a provision.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/hrai-go/scse#worldIncludesSolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">worldIncludesSolution</rdfs:label>
    <rdfs:comment xml:lang="en">Solution included in the simulated world if applicable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/hrai-go/scse#WorldSnapshot"/>
