  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:description xml:lang="en">SCSE module of HRAI-GO (Human-centred Regulatory AI, Governance Observatory): deliberation, council, strata, seats, rounds, positions, scenarios and decisions. Imports the regulatory core instead of redeclaring its classes (ESP-ONT-02, RF-17). Includes synthetic illustration individuals and safe positive SWRL rules. No legal certification or population representativeness is implied.</dcterms:description>
    <dcterms:source>SCSE Shadow Council Simulation Specification v1.0 and HRAI-GO conceptual proposal (user-provided documents).</dcterms:source>
    <dcterms:title xml:lang="en">HRAI-GO: Human-centred Regulatory AI, Governance Observatory — Shadow Council Simulation Environment Ontology</dcterms:title>
    <rdfs:comment xml:lang="en">1.1.0: own namespace; imports the core; regulatory classes (LegalProvision, NormativeRequirement, LegalStatus, LegalException, Jurisdiction, ComplianceAssessment, PolicyAlternative, PolicyObjective) now come from the core; deliberation classes have their home here, with owl:equivalentClass to the legacy core classes kept for compatibility.</rdfs:comment>
    <rdfs:comment xml:lang="en">1.2.0 (ESP-ONT-02, RF-03): DecisionRecord, position revision and alternative positions, stratum of a stakeholder; rules R29a/R29b (synthetic support never counts as human) and R30 (divergent alternative).</rdfs:comment>
    <owl:imports rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory"/>
    <owl:versionIRI rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse/1.2.0"/>
    <owl:versionInfo>1.2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#eventAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">eventAgent</rdfs:label>
    <rdfs:comment xml:lang="en">Agent that produced an event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#DeliberationEvent"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#PerspectiveAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#decisionPreservesDivergence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">decisionPreservesDivergence</rdfs:label>
    <rdfs:comment xml:lang="en">Alternative whose disagreement the decision keeps on record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#DecisionRecord"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#PolicyAlternative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#ClaimClassification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ClaimClassification</rdfs:label>
    <rdfs:comment xml:lang="en">Controlled classification separating verified claims from synthetic positions.</rdfs:comment>
    <owl:oneOf rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b113"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#positionRevisedAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">positionRevisedAs</rdfs:label>
    <rdfs:comment xml:lang="en">A person changed position between rounds 1 and 3: the earlier position was revised as the later one.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#StakeholderPosition"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#StakeholderPosition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#SourceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">SourceDocument</rdfs:label>
    <rdfs:comment xml:lang="en">Document or official source referenced by legal or empirical statements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <owl:disjointWith rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#EvidenceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b32">
    <rdf:first rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b31"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
