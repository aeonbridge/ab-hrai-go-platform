  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#hasComplianceAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasComplianceAssessment</rdfs:label>
    <rdfs:comment xml:lang="en">Assessment issued separately from synthetic council deliberation.</rdfs:comment>
