    <swrl:propertyPredicate rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#hasRound"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b23">
