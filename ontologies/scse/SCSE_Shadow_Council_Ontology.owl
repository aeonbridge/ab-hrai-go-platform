    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#worldUsesContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">worldUsesContext</rdfs:label>
    <rdfs:comment xml:lang="en">National context frozen into the simulated world.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#WorldSnapshot"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#NationalContextSnapshot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#summary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">summary</rdfs:label>
    <rdfs:comment xml:lang="en">Summary of the solution or proposed architecture.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#SolutionArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#SolutionComplianceMode">
