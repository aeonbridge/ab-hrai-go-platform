  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/scse">
    <dcterms:description xml:lang="en">SCSE module of HRAI-GO (Human-centred Regulatory AI, Governance Observatory): deliberation, council, strata, seats, rounds, positions, scenarios and decisions. Imports the regulatory core instead of redeclaring its classes (ESP-ONT-02, RF-17). Includes synthetic illustration individuals and safe positive SWRL rules. No legal certification or population representativeness is implied.</dcterms:description>
    <rdfs:comment xml:lang="en">1.1.0: own namespace; imports the core; regulatory classes (LegalProvision, NormativeRequirement, LegalStatus, LegalException, Jurisdiction, ComplianceAssessment, PolicyAlternative, PolicyObjective) now come from the core; deliberation classes have their home here, with owl:equivalentClass to the legacy core classes kept for compatibility.</rdfs:comment>
    <dcterms:source>SCSE Shadow Council Simulation Specification v1.0 and HRAI-GO conceptual proposal (user-provided documents).</dcterms:source>
    <dcterms:title xml:lang="en">Shadow Council Simulation Environment Ontology</dcterms:title>
    <owl:versionInfo>1.1.0</owl:versionInfo>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/scse/1.1.0"/>
    <owl:imports rdf:resource="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/regulatory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/scse#ModelManifest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ModelManifest</rdfs:label>
    <rdfs:comment xml:lang="en">Frozen reproducibility metadata for the models and configurations used in a run.</rdfs:comment>
  </rdf:Description>
