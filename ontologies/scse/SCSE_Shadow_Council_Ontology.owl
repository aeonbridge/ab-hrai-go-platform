  </rdf:Description>
  <rdf:Description rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b53">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:argument1 rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R07_finding"/>
    <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
    <swrl:propertyPredicate rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#requiresProspectiveReview"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b26">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:argument1 rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse/swrl-var#R04_run"/>
