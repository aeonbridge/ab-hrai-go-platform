  <rdf:Description rdf:about="https://github.com/aeonbridge/ab-hrai-go-platform/ontology/scse#ComplianceFinding">
    <rdfs:comment xml:lang="en">Requirement-scoped, evidence-bounded assessment outcome, not automatic legal certification.</rdfs:comment>
