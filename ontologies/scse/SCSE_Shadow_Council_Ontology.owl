    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#ComplianceAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#minorityClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">minorityClaim</rdfs:label>
    <rdfs:comment xml:lang="en">Claim underlying a minority opinion.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#MinorityOpinion"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ArgumentClaim"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#eventTimestamp">
