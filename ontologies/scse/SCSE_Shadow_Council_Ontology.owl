    <rdf:type rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ScenarioMode"/>
    <rdfs:label xml:lang="en">SolutionComplianceMode</rdfs:label>
    <rdfs:comment xml:lang="en">Application compliance simulation</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#ReviewStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ReviewStatus</rdfs:label>
    <rdfs:comment xml:lang="en">Controlled review status for source or knowledge validation.</rdfs:comment>
    <owl:oneOf rdf:nodeID="n90563b8e03f0442f8a138e3bf1e047a3b107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#roundIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">roundIndex</rdfs:label>
    <rdfs:comment xml:lang="en">Ordered round number.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#DeliberationRound"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#reportsFinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">reportsFinding</rdfs:label>
    <rdfs:comment xml:lang="en">Report describes a legal finding without changing it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#CouncilReport"/>
    <rdfs:range rdf:resource="https://hrai-go.aeonbridge.io/ontology/scse#ComplianceFinding"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#hasMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
