  <rdf:Description rdf:about="https://example.org/hrai-go/scse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://example.org/hrai-go/scse/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Shadow Council Simulation Environment Ontology</dcterms:title>
    <dcterms:description xml:lang="en">Standalone proposed OWL 2 ontology for regulatory-policy and solution-compliance shadow-council simulations. Includes synthetic illustration individuals and safe positive SWRL inference rules. No legal certification or population representativeness is implied.</dcterms:description>
    <dcterms:source>SCSE Shadow Council Simulation Specification v1.0 and HRAI-GO conceptual proposal (user-provided documents).</dcterms:source>
    <rdfs:comment xml:lang="en">Example.org is an intentionally nonproduction namespace; substitute an owned persistent identifier before publication.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/hrai-go/scse#hasIntervention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasIntervention</rdfs:label>
    <rdfs:comment xml:lang="en">Branch intervention with declared changes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/hrai-go/scse#ScenarioBranch"/>
    <rdfs:range rdf:resource="https://example.org/hrai-go/scse#SimulationIntervention"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/hrai-go/scse#artifactType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">artifactType</rdfs:label>
    <rdfs:comment xml:lang="en">Briefing, specification, architecture or deployed system.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/hrai-go/scse#SolutionArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/hrai-go/scse#reportsRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">reportsRun</rdfs:label>
    <rdfs:comment xml:lang="en">Run summarized by a report.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/hrai-go/scse#CouncilReport"/>
    <rdfs:range rdf:resource="https://example.org/hrai-go/scse#SimulationRun"/>
  </rdf:Description>
