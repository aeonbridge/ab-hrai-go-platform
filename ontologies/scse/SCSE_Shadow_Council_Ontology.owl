  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#SyntheticStakeholderPerspective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Synthetic stakeholder perspective</rdfs:label>
    <rdfs:comment xml:lang="en">Documented perspective voiced by a synthetic agent; never a real person or group. Home of the concept since RF-17.</rdfs:comment>
    <owl:equivalentClass rdf:resource="https://hrai-go.aeonbridge.io/ontology/regulatory#SyntheticStakeholderPerspective"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hrai-go.aeonbridge.io/ontology/scse#ArgumentClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ArgumentClaim</rdfs:label>
